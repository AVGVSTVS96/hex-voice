@@ -0,0 +1,89 @@
+import { RNHostView, Icon, Spacer } from '@expo/ui';
+import { Circle, Rectangle, ZStack } from '@expo/ui/swift-ui';
+import { foregroundStyle, frame, strokeBorder } from '@expo/ui/swift-ui/modifiers';
+import type { ReactNode } from 'react';
+import { View, type ColorValue } from 'react-native';
+
+import { Arc } from '@/components/agent-line';
+import type { TaskState } from '@/live/tasks';
+import { theme } from '@/theme';
+import { metrics } from '@/ui/tokens';
+
+export type MarkState = TaskState | 'paused' | 'stopped' | 'read' | 'pending';
+
+// Drawn natively so a long list stays cheap; only the arc moves, so only it animates.
+export function Mark({ state }: { state: MarkState }) {
+  if (state === 'working')
+    return (
+      <RNHostView matchContents>
+        <View
+          style={{
+            width: metrics.list.mark,
+            height: metrics.list.mark,
+            alignItems: 'center',
+            justifyContent: 'center',
+          }}
+        >
+          <Arc size={13} />
+        </View>
+      </RNHostView>
+    );
+  return (
+    <ZStack
+      alignment="center"
+      modifiers={[frame({ width: metrics.list.mark, height: metrics.list.mark })]}
+    >
+      <Face state={state} />
+    </ZStack>
+  );
+}
+
+function Face({ state }: { state: Exclude<MarkState, 'working'> }) {
+  const disc = (color: ColorValue, children: ReactNode) => (
+    <>
+      <Circle modifiers={[frame({ width: 14, height: 14 }), foregroundStyle(color)]} />
+      {children}
+    </>
+  );
+  switch (state) {
+    case 'needs':
+      return <Circle modifiers={[frame({ width: 8, height: 8 }), foregroundStyle(theme.accent)]} />;
+    case 'done':
+      return disc(theme.accentMuted, <Icon name="checkmark" size={8} color={theme.accent} />);
+    case 'read':
+      return <Icon name="checkmark" size={10} color={theme.tertiary} />;
+    case 'failed':
+      return disc(theme.dangerMuted, <Icon name="exclamationmark" size={8} color={theme.danger} />);
+    case 'paused':
+      return disc(
+        theme.surfaceSelected,
+        <Icon name="pause.fill" size={7} color={theme.secondary} />,
+      );
+    case 'stopped':
+      return (
+        <Rectangle modifiers={[frame({ width: 7, height: 7 }), foregroundStyle(theme.tertiary)]} />
+      );
+    case 'pending':
+      return (
+        <Spacer
+          modifiers={[
+            frame({ width: 10, height: 10 }),
+            strokeBorder({
+              content: theme.tertiary,
+              style: { lineWidth: 1.5, dash: [2, 2] },
+              shape: 'circle',
+            }),
+          ]}
+        />
+      );
+    case 'idle':
+      return (
+        <Spacer
+          modifiers={[
+            frame({ width: 8, height: 8 }),
+            strokeBorder({ content: theme.tertiary, style: { lineWidth: 1.5 }, shape: 'circle' }),
+          ]}
+        />
+      );
+  }
+}
diff --git a/src/components/tasks/pages.ts b/src/components/tasks/pages.ts
new file mode 100644
index 0000000000000000000000000000000000000000..078d9108995dab71aea000938f6fb4b20bbfbe49
--- /dev/null
+++ b/src/components/tasks/pages.ts
@@ -0,0 +1,212 @@
+import type { TextInputRef } from '@expo/ui';
+import { createContext, useContext, useEffect, useReducer, useRef } from 'react';
+
+import type { TasksAt } from '@/components/tasks/tasks-view';
+import type { PageId } from '@/live/inbox';
+import type { TaskId } from '@/live/tasks';
+
+export type Level = 'list' | 'topic' | 'thread' | 'steps' | 'check';
+type Pushed = Exclude<Level, 'list'>;
+
+export type Stack = {
+  path: Pushed[];
+  task: PageId | null;
+  row: string | null;
+  stepsOf: TaskId | null;
+  focusComposer: boolean;
+};
+
+export type Move =
+  | { to: 'start'; at: TasksAt }
+  | { to: 'topic'; id: PageId; row?: string }
+  | { to: 'beside'; id: PageId | null }
+  | { to: 'thread'; write?: boolean }
+  | { to: 'composerFocused' }
+  | { to: 'steps'; id: TaskId }
+  | { to: 'check' }
+  | { to: 'back' };
+
+export type Shape = 'one' | 'columns' | 'panes';
+
+export const START: Stack = {
+  path: [],
+  task: null,
+  row: null,
+  stepsOf: null,
+  focusComposer: false,
+};
+
+// Wide enough for the list and a topic's page side by side: Tasks on a 13-inch iPad beside a call,
+// or anywhere before one. An 11-inch keeps one wide list beside a call.
+const COLUMNS = 900;
+
+export function shapeOf(width: number, panes: number | undefined): Shape {
+  return panes !== undefined ? 'panes' : width >= COLUMNS ? 'columns' : 'one';
+}
+
+export function move(stack: Stack, step: Move): Stack {
+  switch (step.to) {
+    case 'start':
+      return { ...START, task: step.at.task ?? null, path: step.at.task ? ['topic'] : [] };
+    case 'topic':
+      return { ...stack, task: step.id, row: step.row ?? null, path: ['topic'] };
+    case 'beside':
+      return { ...stack, task: step.id };
+    case 'thread':
+      return { ...stack, path: ['topic', 'thread'], focusComposer: !!step.write };
+    case 'composerFocused':
+      return stack.focusComposer ? { ...stack, focusComposer: false } : stack;
+    case 'steps':
+      return {
+        ...stack,
+        stepsOf: step.id,
+        path: [...stack.path.filter((at) => at !== 'steps'), 'steps'],
+      };
+    case 'check':
+      return { ...stack, path: ['check'] };
+    case 'back':
+      return { ...stack, path: stack.path.slice(0, -1), focusComposer: false };
+  }
+}
+
+export function levelsOf(stack: Stack, shape: Shape): Level[] {
+  const levels: Level[] = ['list', ...stack.path];
+  if (shape !== 'one' && levels.length === 1) levels.push('topic');
+  return levels;
+}
+
+export function backLeavesTasks(stack: Stack, shape: Shape): boolean {
+  const levels = levelsOf(stack, shape);
+  if (shape === 'one') return levels.length === 1;
+  if (shape === 'columns') return levels.length === 2 && levels[1] === 'topic';
+  return levels.at(-2) === 'list';
+}
+
+export function usePages({
+  open,
+  at,
+  shape,
+  onClose,
+}: {
+  open: boolean;
+  at: TasksAt;
+  shape: Shape;
+  onClose?: () => void;
+}) {
+  const [stack, go] = useReducer(move, START);
+  useEffect(() => {
+    if (open) go({ to: 'start', at });
+  }, [open, at]);
+  const back = () => (backLeavesTasks(stack, shape) ? onClose?.() : go({ to: 'back' }));
+  return { ...stack, shape, levels: levelsOf(stack, shape), closes: !!onClose, go, back };
+}
+
+export type Pages = ReturnType<typeof usePages>;
+type Placing = Pick<Pages, 'levels' | 'shape' | 'closes'>;
+
+// Where Tasks lays out: as wide as it's given, keeping `foot` clear at its foot, or ending at the
+// fold. On iPhone Duo its pages are clear over the screen's backdrop (`paged`), and held wide it
+// takes the fold's two sides as two pages side by side, meeting `panes` from its start.
+export type Room = { width: number; foot: number | 'fold'; paged: boolean; panes?: number };
+
+// A sheet's bar centers its title; a page's on iPhone Duo is one row: back, title, buttons.
+
+// A page in a pane is as wide as the pane (`frame`); every page is as tall as the room
+// lets it be, which the keyboard can shorten.
+export type Spot = {
+  frame?: { width: number };
+  offset: { x: number; y: number };
+  shown: boolean;
+  width: number;
+  foot: number;
+  back?: Level | 'call';
+};
+
+// A page that ends at the fold keeps nothing clear below it.
+function footOf(foot: number | 'fold') {
+  return { foot: foot === 'fold' ? 0 : foot };
+}
+
+// A field on a page says when it's being typed in, so that page can make room above the keyboard.
+export const Typing = createContext<(on: boolean) => void>(() => {});
+
+// Whether a field's page shows. Pages stay mounted as they leave, so a field ends its own editing
+// when its page stops showing, rather than keep the keyboard up for a page that's gone.
+export const Showing = createContext(true);
+
+export function useField() {
+  const field = useRef<TextInputRef>(null);
+  const showing = useContext(Showing);
+  useEffect(() => {
+    if (!showing) field.current?.blur();
+  }, [showing]);
+  return field;
+}
+
+export function spotOf(level: Level, pages: Placing, room: Room): Spot {
+  if (room.paged && room.panes !== undefined) return spotInPanes(level, pages, room, room.panes);
+  return pages.shape === 'columns'
+    ? spotInColumns(level, pages, room)
+    : spotAlone(level, pages, room);
+}
+
+// A page steps down over the one before, which waits a third of a page behind; on the Duo a whole
+// page, since its clear pages would show through each other.
+function spotAlone(level: Level, { levels, closes }: Placing, room: Room): Spot {
+  const i = levels.indexOf(level);
+  const front = i === levels.length - 1;
+  const page = room.width;
+  const x = front ? 0 : i >= 0 ? -(room.paged ? page : page / 3) : page;
+  return {
+    offset: { x, y: 0 },
+    shown: x === 0,
+    width: page,
+    ...footOf(room.foot),
+    back: level === 'list' ? (front && closes ? 'call' : undefined) : levels[i - 1],
+  };
+}
+
+function spotInColumns(level: Level, { levels }: Placing, room: Room): Spot {
+  const list = Math.round(Math.min(440, Math.max(360, room.width * 0.42)));
+  const page = room.width - list - 1;
+  const i = levels.indexOf(level);
+  const front = i === levels.length - 1;
+  const behind = i >= 0 || level === 'topic';
+  const x = level === 'list' || front ? 0 : behind ? -page / 3 : page;
+  return {
+    offset: { x, y: 0 },
+    shown: x === 0,
+    width: level === 'list' ? list : page,
+    ...footOf(room.foot),
+    back: level === 'list' || level === 'topic' ? undefined : levels[i - 1],
+  };
+}
+
+// Held wide, the deepest level takes the second pane and the one before it the first; deeper ones
+// wait off the leading edge, shallower ones off the trailing edge.
+function spotInPanes(level: Level, { levels, closes }: Placing, room: Room, panes: number): Spot {
+  const i = levels.indexOf(level);
+  const front = i === levels.length - 1;
+  const second = { at: panes, width: room.width - panes };
+  const { at, width, shown } = front
+    ? { ...second, shown: true }
+    : i === levels.length - 2
+      ? { at: 0, width: panes, shown: true }
+      : i >= 0
+        ? { at: -panes, width: panes, shown: false }
+        : { ...second, at: room.width, shown: false };
+  return {
+    frame: { width },
+    offset: { x: at, y: 0 },
+    shown,
+    width,
+    ...footOf(room.foot),
+    back: !(shown && at <= 0)
+      ? undefined
+      : level === 'list'
+        ? closes
+          ? 'call'
+          : undefined
+        : levels[i - 1],
+  };
+}
diff --git a/src/components/tasks/parts.tsx b/src/components/tasks/parts.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3e6a187c5bce9a552bb6c635539b9b9f64cfbf31
--- /dev/null
+++ b/src/components/tasks/parts.tsx
@@ -0,0 +1,282 @@
+import { Column, Icon, Row, Spacer } from '@expo/ui';
+import { Mask, ProgressView, Rectangle } from '@expo/ui/swift-ui';
+import {
+  accessibilityLabel,
+  alignmentGuide,
+  foregroundStyle,
+  frame,
+  listRowBackground,
+  listRowInsets,
+  listRowSeparator,
+  listRowSeparatorTint,
+  padding,
+  type ModifierConfig,
+} from '@expo/ui/swift-ui/modifiers';
+import * as Haptics from 'expo-haptics';
+import { Children, isValidElement, type ReactNode } from 'react';
+
+import type { Answered } from '@/hooks/use-watch';
+import { hairline, theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, space } from '@/ui/tokens';
+
+// Counts say what they count, so a stage tab's number and an ask count read as different things.
+export const asks = (n: number) => `${n} ask${n === 1 ? '' : 's'}`;
+
+export function feel(haptics: boolean) {
+  const on = haptics;
+  return {
+    tick: () => {
+      if (on) void Haptics.selectionAsync();
+    },
+    tap: () => {
+      if (on) void Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
+    },
+  };
+}
+
+export type Feel = ReturnType<typeof feel>;
+
+// No inset or fill of its own, so the list's ground shows behind it, unless it's the selected row.
+// A row takes the fill set closest to it, so the selection is set here and not on top.
+export function listRow(
+  width: number,
+  { top = true, bottom = true, selected = false } = {},
+): ModifierConfig[] {
+  return [
+    listRowInsets({ top: 0, leading: 0, bottom: 0, trailing: 0 }),
+    listRowBackground(selected ? theme.surfaceSelected : 'transparent'),
+    listRowSeparatorTint(theme.edge),
+    alignmentGuide('listRowSeparatorLeading', 0),
+    alignmentGuide('listRowSeparatorTrailing', width),
+    ...(top ? [] : [listRowSeparator('hidden', 'top')]),
+    ...(bottom ? [] : [listRowSeparator('hidden', 'bottom')]),
+  ];
+}
+
+export function SectionHead({
+  title,
+  count,
+  opens = false,
+}: {
+  title: string;
+  count?: string | number;
+  opens?: boolean;
+}) {
+  return (
+    <Row
+      alignment="center"
+      spacing={0}
+      modifiers={[
+        padding({
+          leading: metrics.list.inset,
+          trailing: metrics.list.inset,
+          top: space[5.5],
+          bottom: space[1.5],
+        }),
+        frame({ maxWidth: Infinity }),
+      ]}
+    >
+      <Text variant="footnote" weight="semibold" tone="secondary">
+        {title}
+      </Text>
+      <Spacer flexible />
+      {count !== undefined ? (
+        <Text variant="footnote" tone="tertiary">
+          {String(count)}
+        </Text>
+      ) : null}
+      {opens ? (
+        <Icon
+          name="chevron.right"
+          size={11}
+          color={theme.tertiary}
+          modifiers={[padding({ leading: space[2] })]}
+        />
+      ) : null}
+    </Row>
+  );
+}
+
+// iOS's soft scroll edge: what scrolls under a bar fades out instead of being cut mid-line. The
+// scroll view inside rests `metrics.list.rest` in from each edge and draws past its frame
+// (`scrollClipDisabled`), so it scrolls on into the fade the way content scrolls under a bar. A
+// mask, so it works on any ground and never takes a touch.
+export function Faded({
+  top = true,
+  bottom = true,
+  children,
+}: {
+  top?: boolean;
+  bottom?: boolean;
+  children: ReactNode;
+}) {
+  const edge = (from: 'top' | 'bottom') => (
+    <Rectangle
+      modifiers={[
+        frame({ height: metrics.list.fade }),
+        frame({ maxWidth: Infinity }),
+        foregroundStyle({
+          type: 'linearGradient',
+          colors: ['#00000000', '#000000'],
+          startPoint: { x: 0.5, y: from === 'top' ? 0 : 1 },
+          endPoint: { x: 0.5, y: from === 'top' ? 1 : 0 },
+        }),
+      ]}
+    />
+  );
+  return (
+    <Mask
+      alignment="top"
+      modifiers={[frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' })]}
+    >
+      <Column
+        alignment="center"
+        spacing={0}
+        modifiers={[
+          padding({ top: top ? metrics.list.rest : 0, bottom: bottom ? metrics.list.rest : 0 }),
+          frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' }),
+        ]}
+      >
+        {children}
+      </Column>
+      <Mask.Content>
+        <Column
+          alignment="center"
+          spacing={0}
+          modifiers={[frame({ maxWidth: Infinity, maxHeight: Infinity })]}
+        >
+          {top ? edge('top') : null}
+          <Rectangle
+            modifiers={[
+              frame({ maxWidth: Infinity, maxHeight: Infinity }),
+              foregroundStyle('#000000'),
+            ]}
+          />
+          {bottom ? edge('bottom') : null}
+        </Column>
+      </Mask.Content>
+    </Mask>
+  );
+}
+
+// A page's sections, a hairline between each and the next so it's clear where one ends. Pass each
+// section only when it shows, so none is drawn above the first.
+export function Sections({ children }: { children: ReactNode }) {
+  return (
+    <Column alignment="start" spacing={0} modifiers={[frame({ maxWidth: Infinity })]}>
+      {Children.toArray(children).map((section, i) => (
+        <Column
+          key={isValidElement(section) ? section.key : i}
+          alignment="start"
+          spacing={0}
+          modifiers={[frame({ maxWidth: Infinity })]}
+        >
+          {i ? (
+            <Column alignment="start" spacing={0} modifiers={[padding({ top: space[5] })]}>
+              <Hairline />
+            </Column>
+          ) : null}
+          {section}
+        </Column>
+      ))}
+    </Column>
+  );
+}
+
+export function Hairline() {
+  return (
+    <Rectangle
+      modifiers={[
+        frame({ height: hairline }),
+        frame({ maxWidth: Infinity }),
+        foregroundStyle(theme.edge),
+      ]}
+    />
+  );
+}
+
+export function Empty({ text, width }: { text: string; width: number }) {
+  return (
+    <Text
+      variant="subheadline"
+      tone="tertiary"
+      modifiers={[
+        padding({ top: space[12], bottom: space[12] }),
+        frame({ maxWidth: Infinity }),
+        ...listRow(width, { top: false, bottom: false }),
+      ]}
+    >
+      {text}
+    </Text>
+  );
+}
+
+// Until hex first answers: the system's spinner where the rows will be.
+export function Loading({ width }: { width: number }) {
+  return (
+    <Row
+      alignment="center"
+      spacing={0}
+      modifiers={[
+        padding({ top: space[12], bottom: space[12] }),
+        frame({ maxWidth: Infinity }),
+        ...listRow(width, { top: false, bottom: false }),
+        accessibilityLabel('Loading'),
+      ]}
+    >
+      <ProgressView />
+    </Row>
+  );
+}
+
+// A page's body until hex answers it: the system's spinner; while hex can't be reached, that it's
+// trying again, which it does on its own; and once hex says no, why, `gone` when there's no such thing.
+export function Waiting({ failed, refused, gone }: Answered & { gone: string }) {
+  const why = refused
+    ? refused.status === 404
+      ? gone
+      : refused.message
+    : failed
+      ? UNREACHED
+      : null;
+  return (
+    <Row
+      alignment="center"
+      spacing={0}
+      modifiers={[
+        padding({
+          top: space[12],
+          bottom: space[12],
+          leading: metrics.list.inset,
+          trailing: metrics.list.inset,
+        }),
+        frame({ maxWidth: Infinity }),
+      ]}
+    >
+      {why ? (
+        <Text variant="subheadline" tone="tertiary">
+          {why}
+        </Text>
+      ) : (
+        <ProgressView modifiers={[accessibilityLabel('Loading')]} />
+      )}
+    </Row>
+  );
+}
+
+export const UNREACHED = 'Can’t reach hex. Trying again…';
+
+// What you did here that didn't go through, and why, quietly where you did it.
+export function Failure({ text, modifiers = [] }: { text: string; modifiers?: ModifierConfig[] }) {
+  return (
+    <Text
+      variant="footnote"
+      tone="danger"
+      paragraph
+      modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' }), ...modifiers]}
+    >
+      {text}
+    </Text>
+  );
+}
diff --git a/src/components/tasks/pinned.tsx b/src/components/tasks/pinned.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0dc888b1d07579f634ca20308f7c9b8a6d4b0417
--- /dev/null
+++ b/src/components/tasks/pinned.tsx
@@ -0,0 +1,186 @@
+import { Column, Icon, Row, Spacer } from '@expo/ui';
+import {
+  background,
+  clipShape,
+  contentShape,
+  frame,
+  padding,
+  shapes,
+  textSelection,
+} from '@expo/ui/swift-ui/modifiers';
+import { useState } from 'react';
+
+import { Markdown } from '@/components/markdown';
+import { Mark } from '@/components/tasks/mark';
+import { Failure, SectionHead } from '@/components/tasks/parts';
+import { openURL, useFailures } from '@/hooks/use-failures';
+import { pinSections, type PinLine, type PinSection } from '@/live/pinned';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, radius, space } from '@/ui/tokens';
+
+export function Pinned({ text }: { text: string }) {
+  const sections = pinSections(text);
+  return (
+    <Column alignment="start" spacing={0}>
+      {sections.map((section, i) => (
+        <Section key={`${section.title} ${i}`} section={section} />
+      ))}
+    </Column>
+  );
+}
+
+function Section({ section }: { section: PinSection }) {
+  const [open, setOpen] = useState(!section.folded);
+  if (!open)
+    return (
+      <Row
+        alignment="center"
+        spacing={metrics.list.gap}
+        onPress={() => setOpen(true)}
+        modifiers={[
+          padding({
+            leading: metrics.list.inset - space[0.5],
+            trailing: metrics.list.inset,
+            top: space[3],
+            bottom: space[3],
+          }),
+          frame({ maxWidth: Infinity }),
+          contentShape(shapes.rectangle()),
+        ]}
+      >
+        <Mark state={section.mark} />
+        <Text variant="subheadline" tone="secondary">
+          {`${section.title} · ${section.lines.length}`}
+        </Text>
+        <Spacer flexible />
+        <Icon name="chevron.down" size={13} color={theme.tertiary} />
+      </Row>
+    );
+  return (
+    <Column alignment="start" spacing={0}>
+      {section.title ? <SectionHead title={section.title} count={section.lines.length} /> : null}
+      {section.lines.map((line, i) => (
+        <Line key={i} line={line} />
+      ))}
+    </Column>
+  );
+}
+
+function Line({ line }: { line: PinLine }) {
+  const tries = useFailures();
+  if (line.kind === 'code')
+    return (
+      <Text
+        variant="code"
+        paragraph
+        modifiers={[
+          textSelection(true),
+          padding({ leading: space[4], trailing: space[4], top: space[3], bottom: space[3] }),
+          frame({ maxWidth: Infinity, alignment: 'leading' }),
+          background(theme.surface),
+          clipShape('roundedRectangle', radius.inner),
+          padding({
+            leading: metrics.list.inset - space[0.5] + metrics.list.mark + metrics.list.gap,
+            trailing: metrics.list.inset,
+            top: space[1],
+            bottom: space[2],
+          }),
+        ]}
+      >
+        {line.text}
+      </Text>
+    );
+  const url = line.url;
+  const open = url ? () => void tries.attempt(url, 'Not opened', () => openURL(url)) : undefined;
+  if (line.kind === 'text' && !url)
+    return (
+      <Markdown
+        inline
+        variant="subheadline"
+        tone="secondary"
+        selectable
+        modifiers={[
+          padding({
+            leading: metrics.list.inset,
+            trailing: metrics.list.inset,
+            top: space[1.5],
+            bottom: space[1.5],
+          }),
+          frame({ maxWidth: Infinity, alignment: 'leading' }),
+        ]}
+      >
+        {line.text}
+      </Markdown>
+    );
+  if (line.kind === 'text')
+    return (
+      <Row
+        alignment="start"
+        spacing={metrics.list.gap}
+        onPress={open}
+        modifiers={[
+          padding({
+            leading: metrics.list.inset,
+            trailing: metrics.list.inset,
+            top: space[1.5],
+            bottom: space[1.5],
+          }),
+          frame({ maxWidth: Infinity, alignment: 'leading' }),
+          contentShape(shapes.rectangle()),
+        ]}
+      >
+        <Column
+          alignment="start"
+          spacing={space[0.5]}
+          modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+        >
+          <Markdown
+            inline
+            variant="subheadline"
+            tone="secondary"
+            modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+          >
+            {line.text}
+          </Markdown>
+          {url && tries.failed[url] ? <Failure text={tries.failed[url]} /> : null}
+        </Column>
+        <Icon name="arrow.up.right" size={13} color={theme.tertiary} />
+      </Row>
+    );
+  return (
+    <Row
+      alignment="start"
+      spacing={metrics.list.gap}
+      onPress={open}
+      modifiers={[
+        padding({
+          leading: metrics.list.inset - space[0.5],
+          trailing: metrics.list.inset,
+          top: space[2],
+          bottom: space[2],
+        }),
+        frame({ maxWidth: Infinity, alignment: 'leading' }),
+        contentShape(shapes.rectangle()),
+      ]}
+    >
+      <Mark state={line.mark === 'done' ? 'read' : line.mark} />
+      <Column
+        alignment="start"
+        spacing={space[0.5]}
+        modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+      >
+        <Markdown
+          inline
+          variant="subheadline"
+          tone={line.mark === 'done' ? 'secondary' : 'text'}
+          modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+        >
+          {line.text}
+        </Markdown>
+        {url && tries.failed[url] ? <Failure text={tries.failed[url]} /> : null}
+      </Column>
+      {url ? <Icon name="arrow.up.right" size={13} color={theme.tertiary} /> : null}
+    </Row>
+  );
+}
diff --git a/src/components/tasks/places.tsx b/src/components/tasks/places.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..ca66ee95042c480db9be2049772b4caaeabb3770
--- /dev/null
+++ b/src/components/tasks/places.tsx
@@ -0,0 +1,216 @@
+import { Column, Icon, Row, Spacer } from '@expo/ui';
+import { ZStack } from '@expo/ui/swift-ui';
+import {
+  accessibilityLabel,
+  background,
+  clipShape,
+  contentShape,
+  frame,
+  opacity,
+  padding,
+  shapes,
+  strokeBorder,
+} from '@expo/ui/swift-ui/modifiers';
+import { useState } from 'react';
+import { Platform } from 'react-native';
+import type { SFSymbol } from 'sf-symbols-typescript';
+
+import { Hairline, SectionHead } from '@/components/tasks/parts';
+import { PLACES, placeOf, type Place, type Tile } from '@/live/inbox';
+import { clock, type TaskId, type TaskRow } from '@/live/tasks';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, space } from '@/ui/tokens';
+
+const GLYPH: Record<Place, SFSymbol> = {
+  telegram: 'paperplane.fill',
+  t3: 'chevron.left.forwardslash.chevron.right',
+  buzz: 'bolt.fill',
+  discord: 'bubble.left.and.bubble.right.fill',
+  server: 'terminal.fill',
+};
+const PLACE_COLOR: Record<Place, string> = {
+  telegram: '#2AABEE',
+  t3: '#3A3A3C',
+  buzz: '#E9A23B',
+  discord: '#5865F2',
+  server: '#636366',
+};
+// Too dark to show as a ring and a symbol on the sheet, so a ghost of theirs is drawn quieter.
+const DARK: Place[] = ['t3', 'server'];
+const SHOWN = 5;
+const DEVICE = Platform.OS === 'ios' && Platform.isPad ? 'iPad' : 'iPhone';
+
+function look(tile: Tile): { color: string; glyph: SFSymbol; ink: string } {
+  switch (tile.kind) {
+    case 'app':
+      return { color: PLACE_COLOR[tile.place], glyph: GLYPH[tile.place], ink: '#FFFFFF' };
+    case 'call':
+      return { color: '#1B3534', glyph: 'waveform', ink: '#C4F3E5' };
+    case 'link':
+      return { color: '#8E8E93', glyph: 'arrow.up.right', ink: '#FFFFFF' };
+  }
+}
+
+export function swipeLook(tile: Tile) {
+  const { color, glyph } = look(tile);
+  return { color: tile.kind === 'call' ? theme.accentSolid : color, glyph };
+}
+
+// A thread without a link is a ghost: we know it's from there, but there's no door.
+export function TileIcon({ tile, size }: { tile: Tile; size: number }) {
+  if (tile.kind === 'app' && !tile.link) return <Ghost place={tile.place} size={size} />;
+  return <Solid {...look(tile)} size={size} />;
+}
+
+export function PlaceTile({ place, size = 28 }: { place: Place; size?: number }) {
+  return <Solid color={PLACE_COLOR[place]} glyph={GLYPH[place]} ink="#FFFFFF" size={size} />;
+}
+
+function Solid({
+  color,
+  glyph,
+  ink,
+  size,
+}: {
+  color: string;
+  glyph: SFSymbol;
+  ink: string;
+  size: number;
+}) {
+  return (
+    <Row
+      alignment="center"
+      spacing={0}
+      modifiers={[
+        frame({ width: size, height: size }),
+        background(color),
+        clipShape('roundedRectangle', size * metrics.tileCorner),
+      ]}
+    >
+      <Icon name={glyph} size={size * 0.5} color={ink} />
+    </Row>
+  );
+}
+
+function Ghost({ place, size }: { place: Place; size: number }) {
+  const ink = DARK.includes(place) ? theme.secondary : PLACE_COLOR[place];
+  return (
+    <ZStack alignment="center" modifiers={[frame({ width: size, height: size })]}>
+      <Spacer
+        modifiers={[
+          frame({ width: size, height: size }),
+          strokeBorder({
+            content: ink,
+            style: { lineWidth: 1 },
+            shape: 'roundedRectangle',
+            cornerRadius: size * metrics.tileCorner,
+          }),
+          opacity(0.35),
+        ]}
+      />
+      <Icon name={GLYPH[place]} size={size * 0.5} color={ink} />
+    </ZStack>
+  );
+}
+
+// Places list a topic's threads once it has more than one; one thread's place is its header's door.
+export const hasPlaces = (task: TaskRow, threads: TaskRow[]) =>
+  threads.some((thread) => thread.id !== task.id);
+
+export function Places({
+  task,
+  threads,
+  missing,
+  onOpen,
+  onOpenTask,
+}: {
+  task: TaskRow;
+  threads: TaskRow[];
+  missing: Set<Place>;
+  onOpen: (thread: TaskRow) => void;
+  onOpenTask: (id: TaskId) => void;
+}) {
+  const others = threads
+    .filter((thread) => thread.id !== task.id)
+    .sort((a, b) => Number(!!b.link) - Number(!!a.link) || Date.parse(b.at) - Date.parse(a.at));
+  const all = [task, ...others];
+  const [every, setEvery] = useState(false);
+  const shown = every ? all : all.slice(0, SHOWN);
+  const rest = all.length - shown.length;
+  return (
+    <Column alignment="start" spacing={0} modifiers={[frame({ maxWidth: Infinity })]}>
+      <SectionHead title="Places" count={all.length} />
+      {shown.map((thread) => {
+        const place = placeOf(thread.app);
+        const gone = missing.has(place);
+        const opens = !!thread.link || thread.id !== task.id;
+        const note = gone
+          ? `${PLACES[place]} isn’t on this ${DEVICE}`
+          : `${PLACES[place]} · ${clock(new Date(thread.at))}${thread.link ? '' : ' · no link'}`;
+        return (
+          <Column
+            key={thread.id}
+            alignment="start"
+            spacing={0}
+            modifiers={[frame({ maxWidth: Infinity })]}
+          >
+            <Row
+              alignment="center"
+              spacing={space[3]}
+              onPress={
+                opens ? () => (thread.link ? onOpen(thread) : onOpenTask(thread.id)) : undefined
+              }
+              modifiers={[
+                padding({
+                  leading: metrics.list.inset,
+                  trailing: metrics.list.inset - space[1],
+                  top: metrics.list.place,
+                  bottom: metrics.list.place,
+                }),
+                frame({ maxWidth: Infinity, alignment: 'leading' }),
+                contentShape(shapes.rectangle()),
+                accessibilityLabel(`${thread.place}, ${note}`),
+              ]}
+            >
+              <PlaceTile place={place} />
+              <Column
+                alignment="start"
+                spacing={space[0.25]}
+                modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+              >
+                <Text numberOfLines={1} variant="subheadline" weight="medium">
+                  {thread.place}
+                </Text>
+                <Text numberOfLines={1} variant="footnote" tone={gone ? 'danger' : 'secondary'}>
+                  {note}
+                </Text>
+              </Column>
+              {opens ? (
+                <Icon
+                  name={thread.link ? 'arrow.up.right' : 'chevron.right'}
+                  size={12}
+                  color={theme.tertiary}
+                />
+              ) : null}
+            </Row>
+            <Hairline />
+          </Column>
+        );
+      })}
+      {rest > 0 ? (
+        <Text
+          onPress={() => setEvery(true)}
+          variant="footnote"
+          tone="accent"
+          modifiers={[
+            padding({ leading: metrics.list.inset + space[10], top: space[2.5], bottom: space[1] }),
+            frame({ maxWidth: Infinity, alignment: 'leading' }),
+          ]}
+        >
+          {`Show ${rest} more thread${rest === 1 ? '' : 's'}`}
+        </Text>
+      ) : null}
+    </Column>
+  );
+}
diff --git a/src/components/tasks/rows.tsx b/src/components/tasks/rows.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f611c94993a97077fb146951f960ba16cfbdab6b
--- /dev/null
+++ b/src/components/tasks/rows.tsx
@@ -0,0 +1,504 @@
+import { Column, Row, Spacer } from '@expo/ui';
+import { Button, HStack, SwipeActions } from '@expo/ui/swift-ui';
+import {
+  accessibilityLabel,
+  contentShape,
+  frame,
+  layoutPriority,
+  monospacedDigit,
+  padding,
+  shapes,
+  tint,
+} from '@expo/ui/swift-ui/modifiers';
+import type { ReactNode } from 'react';
+
+import { InlineAnswers, Unreached } from '@/components/tasks/ask-card';
+import { Dots } from '@/components/tasks/inbox';
+import { Lane, laneWidth } from '@/components/tasks/lane';
+import { Mark, type MarkState } from '@/components/tasks/mark';
+import { Failure, listRow } from '@/components/tasks/parts';
+import { TileIcon, swipeLook } from '@/components/tasks/places';
+import { NOT_NEEDED, type Ask, type AskOption } from '@/live/asks';
+import {
+  PLACES,
+  STUCK,
+  fitsOneLine,
+  headlineOf,
+  opens,
+  type Entry,
+  type Stage,
+  type Tile,
+  type Topic,
+  type PageId,
+} from '@/live/inbox';
+import { STATE_WORDS, atWork, clock, taskTime, type Turn } from '@/live/tasks';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, space } from '@/ui/tokens';
+
+export type RowActions = {
+  width: number;
+  selected?: string | null;
+  answered: Record<string, string | null>;
+  onOpen: (task: PageId, entry: string) => void;
+  onOpenTile: (tile: Tile) => void;
+  onAnswer: (ask: Ask, option: AskOption) => void;
+  onUndo: (ask: Ask) => void;
+  onDismiss: (ask: Ask) => void;
+  onAgain: (ask: Ask) => void;
+  onAct: (id: string) => void;
+  onRead: (id: string) => void;
+};
+
+// The room an ask's choices have under its line.
+const LEADING = metrics.list.inset - space[0.5];
+const TRAILING = metrics.list.inset - space[1];
+const choicesWidth = (width: number) =>
+  width - LEADING - metrics.list.mark - metrics.list.gap - TRAILING;
+
+export function EntryRow({
+  entry,
+  first,
+  ...actions
+}: { entry: Entry; first: boolean } & RowActions) {
+  const selected = actions.selected === entry.id;
+  const swiped = {
+    width: actions.width,
+    first,
+    selected,
+    trail: entry.tiles.filter(opens),
+    onTile: actions.onOpenTile,
+  };
+  switch (entry.kind) {
+    case 'ask': {
+      const { ask } = entry;
+      const said = actions.answered[ask.id];
+      if (said)
+        return (
+          <Folded
+            ask={ask}
+            label={said}
+            width={actions.width}
+            first={first}
+            onUndo={() => actions.onUndo(ask)}
+            onAgain={() => actions.onAgain(ask)}
+          />
+        );
+      const pick = ask.options.find((option) => option.pick);
+      const inline =
+        ask.options.length > 0 && fitsOneLine(ask.options, choicesWidth(actions.width));
+      return (
+        <Swiped
+          {...swiped}
+          lead={pick && { label: pick.label, onPress: () => actions.onAnswer(ask, pick) }}
+          away={{ label: NOT_NEEDED, onPress: () => actions.onDismiss(ask) }}
+        >
+          <Shell
+            mark="needs"
+            line={ask.question}
+            time={clock(new Date(entry.at))}
+            tiles={entry.tiles}
+            label={`${entry.topic} asks: ${ask.question}`}
+            onPress={() => actions.onOpen(ask.task, entry.id)}
+          >
+            {inline ? (
+              <InlineAnswers
+                ask={ask}
+                onAnswer={actions.onAnswer}
+                modifiers={[padding({ top: space[1] })]}
+              />
+            ) : null}
+            {ask.failed ? <Failure text={ask.failed} /> : null}
+          </Shell>
+        </Swiped>
+      );
+    }
+    case 'task': {
+      const { task } = entry;
+      const agents = task.state === 'working' ? atWork(task.agents).length : 0;
+      const mark: MarkState = task.state === 'done' ? 'read' : task.state;
+      return (
+        <Swiped {...swiped}>
+          <Shell
+            mark={mark}
+            line={task.line || STATE_WORDS[task.state]}
+            time={taskTime(task)}
+            meta={agents ? `${agents} agent${agents === 1 ? '' : 's'}` : undefined}
+            tiles={entry.tiles}
+            label={`${task.name}, ${PLACES[entry.place]}, ${STATE_WORDS[task.state]}: ${task.line}`}
+            onPress={() => actions.onOpen(task.id, entry.id)}
+          />
+        </Swiped>
+      );
+    }
+    case 'stuck': {
+      const { stuck } = entry;
+      const act = stuck.sent ? undefined : () => actions.onAct(stuck.id);
+      return (
+        <Swiped {...swiped} lead={act && { label: stuck.action, onPress: act }}>
+          <Shell
+            mark={stuck.mark}
+            line={stuck.title}
+            time={clock(new Date(entry.at))}
+            tiles={entry.tiles}
+            label={`${STUCK}: ${stuck.title}. ${stuck.why}`}
+          >
+            {stuck.why ? <Why text={stuck.why} /> : null}
+            <Action label={stuck.sent ? 'Sent to hex' : stuck.action} onPress={act} />
+            {stuck.failed ? <Failure text={stuck.failed} /> : null}
+          </Shell>
+        </Swiped>
+      );
+    }
+    case 'fresh': {
+      const { fresh } = entry;
+      const read = fresh.read ? undefined : () => actions.onRead(fresh.id);
+      return (
+        <Swiped {...swiped} lead={read && { label: 'Read', onPress: read }}>
+          <Shell
+            mark={fresh.read ? 'read' : 'done'}
+            line={`${fresh.title}: ${fresh.line}`}
+            time={clock(new Date(entry.at))}
+            tiles={entry.tiles}
+            label={`${fresh.title}, finished: ${fresh.line}`}
+          >
+            {read ? <Action label="Mark read" onPress={read} /> : null}
+            {fresh.failed ? <Failure text={fresh.failed} /> : null}
+          </Shell>
+        </Swiped>
+      );
+    }
+  }
+}
+
+type Swipe = { label: string; onPress: () => void };
+
+function Swiped({
+  width,
+  first,
+  selected,
+  lead,
+  away,
+  trail,
+  onTile,
+  children,
+}: {
+  width: number;
+  first: boolean;
+  selected: boolean;
+  lead?: Swipe;
+  // Puts it away without an answer, at the trailing edge, where iOS puts the one that clears a row.
+  away?: Swipe;
+  trail: Tile[];
+  onTile: (tile: Tile) => void;
+  children: ReactNode;
+}) {
+  return (
+    <SwipeActions modifiers={[...listRow(width, { top: !first, selected })]}>
+      {children}
+      {lead ? (
+        <SwipeActions.Actions edge="leading">
+          <Button
+            label={lead.label}
+            systemImage="checkmark"
+            onPress={lead.onPress}
+            modifiers={[tint(theme.accentSolid)]}
+          />
+        </SwipeActions.Actions>
+      ) : null}
+      {away || trail.length ? (
+        <SwipeActions.Actions edge="trailing" allowsFullSwipe={false}>
+          {away ? (
+            <Button
+              label={away.label}
+              systemImage="xmark"
+              onPress={away.onPress}
+              modifiers={[tint(theme.secondary)]}
+            />
+          ) : null}
+          {/* SwiftUI lays trailing actions out from the edge in, so the first place goes last. */}
+          {[...trail].reverse().map((tile, i) => {
+            const { color, glyph } = swipeLook(tile);
+            return (
+              <Button
+                key={i}
+                label={tile.label}
+                systemImage={glyph}
+                onPress={() => onTile(tile)}
+                modifiers={[tint(color)]}
+              />
+            );
+          })}
+        </SwipeActions.Actions>
+      ) : null}
+    </SwipeActions>
+  );
+}
+
+function Shell({
+  mark,
+  line,
+  time,
+  meta,
+  tiles,
+  label,
+  onPress,
+  children,
+}: {
+  mark: MarkState;
+  line: string;
+  time: string;
+  meta?: string;
+  tiles: Tile[];
+  label: string;
+  onPress?: () => void;
+  children?: ReactNode;
+}) {
+  return (
+    <Row
+      alignment="start"
+      spacing={metrics.list.gap}
+      onPress={onPress}
+      modifiers={[
+        padding({
+          leading: LEADING,
+          trailing: TRAILING,
+          top: metrics.list.row.top,
+          bottom: metrics.list.row.bottom,
+        }),
+        frame({ maxWidth: Infinity, alignment: 'leading' }),
+        contentShape(shapes.rectangle()),
+        accessibilityLabel(label),
+      ]}
+    >
+      <Column alignment="center" spacing={0} modifiers={[padding({ top: space[0.5] })]}>
+        <Mark state={mark} />
+      </Column>
+      <Column
+        alignment="start"
+        spacing={0}
+        modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+      >
+        <HStack
+          alignment="firstTextBaseline"
+          spacing={space[2.5]}
+          modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+        >
+          <Text
+            numberOfLines={2}
+            variant="subheadline"
+            paragraph
+            modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+          >
+            {line}
+          </Text>
+          <Row alignment="center" spacing={metrics.list.meta}>
+            {meta ? <Meta text={meta} /> : null}
+            <Meta text={time} />
+            <Tiles tiles={tiles} />
+          </Row>
+        </HStack>
+        {children}
+      </Column>
+    </Row>
+  );
+}
+
+// Where a row lives, one tile per look: two Telegram threads show as one Telegram tile, and the
+// row's swipe still opens each.
+function Tiles({ tiles }: { tiles: Tile[] }) {
+  const looks = new Map(tiles.map((tile) => [lookOf(tile), tile]));
+  return (
+    <Row alignment="center" spacing={space[1]}>
+      {[...looks].map(([look, tile]) => (
+        <TileIcon key={look} tile={tile} size={14} />
+      ))}
+    </Row>
+  );
+}
+
+const lookOf = (tile: Tile) => (tile.kind === 'app' ? `${tile.place}:${opens(tile)}` : tile.kind);
+
+function Meta({ text }: { text: string }) {
+  return (
+    <Text numberOfLines={1} variant="footnote" tone="tertiary">
+      {text}
+    </Text>
+  );
+}
+
+// Why something is stuck, under what it is.
+function Why({ text }: { text: string }) {
+  return (
+    <Text
+      numberOfLines={3}
+      variant="itemDetail"
+      tone="secondary"
+      paragraph
+      modifiers={[padding({ top: space[0.5] })]}
+    >
+      {text}
+    </Text>
+  );
+}
+
+function Action({ label, onPress }: { label: string; onPress?: () => void }) {
+  return (
+    <Text
+      onPress={onPress}
+      variant="subheadline"
+      weight="semibold"
+      tone={onPress ? 'accent' : 'tertiary'}
+      modifiers={[padding({ top: space[2], bottom: space[0.5] })]}
+    >
+      {label}
+    </Text>
+  );
+}
+
+function Folded({
+  ask,
+  label,
+  width,
+  first,
+  onUndo,
+  onAgain,
+}: {
+  ask: Ask;
+  label: string;
+  width: number;
+  first: boolean;
+  onUndo: () => void;
+  onAgain: () => void;
+}) {
+  return (
+    <Row
+      alignment="center"
+      spacing={metrics.list.gap}
+      modifiers={[
+        padding({
+          leading: LEADING,
+          trailing: metrics.list.inset,
+          top: metrics.list.row.top,
+          bottom: metrics.list.row.bottom,
+        }),
+        frame({ maxWidth: Infinity, alignment: 'leading' }),
+        ...listRow(width, { top: !first }),
+      ]}
+    >
+      <Mark state="done" />
+      <Column
+        alignment="start"
+        spacing={space[0.25]}
+        modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+      >
+        <Text numberOfLines={1} variant="subheadline" tone="secondary">
+          {ask.question}
+        </Text>
+        <Text numberOfLines={2} variant="subheadline">
+          {`${label} → ${ask.topic}`}
+        </Text>
+        {ask.missed ? <Unreached missed={ask.missed} onAgain={onAgain} /> : null}
+        {ask.failed ? <Failure text={ask.failed} /> : null}
+      </Column>
+      <Text
+        variant="subheadline"
+        weight="semibold"
+        tone="accent"
+        onPress={onUndo}
+        modifiers={[
+          padding({ leading: space[2], top: space[1.5], bottom: space[1.5] }),
+          accessibilityLabel(`Undo ${label}`),
+        ]}
+      >
+        Undo
+      </Text>
+    </Row>
+  );
+}
+
+const STAGE_WORDS: Record<Exclude<Stage, 'needs'>, string> = {
+  working: 'working',
+  done: 'done',
+  quiet: 'quiet',
+};
+
+// A project as one row in the list: its name and how its threads stand, its week on a lane, how
+// many it has here, then the newest thing in it and when. Opens its page.
+export function ProjectRow({
+  topic,
+  stage,
+  tracks,
+  now,
+  width,
+  selected,
+  onOpen,
+}: {
+  topic: Topic;
+  stage: Stage;
+  tracks: Turn[][];
+  now: number;
+  width: number;
+  selected: boolean;
+  onOpen: () => void;
+}) {
+  const [newest] = [...topic.entries].sort((a, b) => Date.parse(b.at) - Date.parse(a.at));
+  if (!newest) return null;
+  const count = topic.entries.length;
+  const headline = headlineOf(newest);
+  // Mint means it waits on you, so only Needs you counts in mint.
+  const needs = stage === 'needs';
+  const counted = `${count} ${needs ? 'waiting' : STAGE_WORDS[stage]}`;
+  return (
+    <Column
+      alignment="start"
+      spacing={space[0.75]}
+      onPress={onOpen}
+      testID="project-row"
+      modifiers={[
+        padding({
+          leading: metrics.list.inset,
+          trailing: TRAILING,
+          top: metrics.list.row.top,
+          bottom: metrics.list.row.bottom,
+        }),
+        frame({ maxWidth: Infinity, alignment: 'leading' }),
+        contentShape(shapes.rectangle()),
+        ...listRow(width, { selected }),
+        accessibilityLabel(`${topic.name}, ${counted}: ${headline}. Opens it`),
+      ]}
+    >
+      <Row alignment="center" spacing={space[2]} modifiers={[frame({ maxWidth: Infinity })]}>
+        <Text numberOfLines={1} variant="callout" weight="semibold" modifiers={[layoutPriority(1)]}>
+          {topic.name}
+        </Text>
+        {topic.marks.length ? <Dots marks={topic.marks} /> : null}
+        <Spacer flexible />
+        {tracks.length ? <Lane tracks={tracks} width={laneWidth(width)} now={now} /> : null}
+        <Text
+          variant="subheadline"
+          weight="semibold"
+          tone={needs ? 'accent' : 'tertiary'}
+          modifiers={[monospacedDigit(), frame({ minWidth: 22, alignment: 'trailing' })]}
+        >
+          {String(count)}
+        </Text>
+      </Row>
+      <Row
+        alignment="center"
+        spacing={metrics.list.gap}
+        modifiers={[frame({ maxWidth: Infinity })]}
+      >
+        <Text
+          numberOfLines={1}
+          variant="itemDetail"
+          tone="secondary"
+          modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+        >
+          {headline === topic.name ? '' : headline}
+        </Text>
+        <Meta text={clock(new Date(newest.at))} />
+      </Row>
+    </Column>
+  );
+}
diff --git a/src/components/tasks/said.tsx b/src/components/tasks/said.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1ea332607a48eae58538e9ab09deb64b01e1ec7e
--- /dev/null
+++ b/src/components/tasks/said.tsx
@@ -0,0 +1,163 @@
+import { Column, Row, Spacer } from '@expo/ui';
+import { Text } from '@expo/ui/swift-ui';
+import {
+  background,
+  clipShape,
+  frame,
+  lineLimit,
+  onTapGesture,
+  padding,
+  textSelection,
+} from '@expo/ui/swift-ui/modifiers';
+import { createContext, useContext } from 'react';
+
+import { Markdown } from '@/components/markdown';
+import { said, type Sending } from '@/live/chat';
+import type { ChatTurn } from '@/live/tasks';
+import { theme } from '@/theme';
+import { textLook } from '@/ui/text';
+import { metrics, radius, space } from '@/ui/tokens';
+
+// Selectable text takes a tap for itself, so while you type on a page what was said there isn't
+// selectable, and a tap on it ends the typing instead.
+export const Selectable = createContext(true);
+
+// Drawn as the call transcript draws a turn.
+export function Said({ turn }: { turn: ChatTurn }) {
+  const one = said(turn);
+  const selectable = useContext(Selectable);
+  if (one.kind === 'me') return <Mine text={one.text} />;
+  if (one.kind === 'event')
+    return <Event text={one.text ? `${one.label} · ${one.text}` : one.label} />;
+  return (
+    <Markdown
+      selectable={selectable}
+      modifiers={[
+        padding({ leading: metrics.list.inset, trailing: metrics.list.inset }),
+        frame({ maxWidth: Infinity }),
+      ]}
+    >
+      {one.text}
+    </Markdown>
+  );
+}
+
+export function Sent({ sent, onRetry }: { sent: Sending; onRetry: () => void }) {
+  return (
+    <Column alignment="end" spacing={space[1]} modifiers={[frame({ maxWidth: Infinity })]}>
+      <Mine text={sent.text} dim={!sent.failed} />
+      <Row alignment="center" spacing={0} modifiers={[padding({ trailing: metrics.list.inset })]}>
+        <Spacer flexible />
+        <Text
+          modifiers={[
+            ...(sent.failed?.again ? [onTapGesture(onRetry)] : []),
+            ...textLook({
+              variant: 'footnote',
+              weight: sent.failed ? 'medium' : 'regular',
+              tone: sent.failed ? 'danger' : 'tertiary',
+            }),
+          ]}
+        >
+          {!sent.failed
+            ? 'Sending'
+            : sent.failed.again
+              ? 'Not sent · Tap to try again'
+              : sent.failed.why}
+        </Text>
+      </Row>
+    </Column>
+  );
+}
+
+export function SaidLine({
+  turn,
+  named,
+  lines,
+}: {
+  turn: ChatTurn;
+  named: boolean;
+  lines: number;
+}) {
+  const one = said(turn);
+  const who = one.kind === 'hex' ? 'hex' : 'You';
+  const text =
+    one.kind === 'event' ? (one.text ? `${one.label} · ${one.text}` : one.label) : one.text;
+  return (
+    <Row
+      alignment="start"
+      spacing={space[2.5]}
+      modifiers={[
+        padding({
+          leading: metrics.list.inset,
+          trailing: metrics.list.inset,
+          top: space[1.25],
+          bottom: space[1.25],
+        }),
+      ]}
+    >
+      <Text
+        modifiers={[
+          ...textLook({ variant: 'footnote', weight: 'semibold', tone: 'secondary' }),
+          frame({ width: 30, alignment: 'leading' }),
+        ]}
+      >
+        {named ? who : ''}
+      </Text>
+      <Markdown
+        inline
+        lines={lines}
+        variant="preview"
+        tone={one.kind === 'event' ? 'secondary' : 'text'}
+        modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+      >
+        {text}
+      </Markdown>
+    </Row>
+  );
+}
+
+function Mine({ text, dim = false }: { text: string; dim?: boolean }) {
+  const selectable = useContext(Selectable);
+  return (
+    <Row
+      alignment="center"
+      spacing={0}
+      modifiers={[
+        padding({ leading: metrics.bubbleRoom, trailing: metrics.list.inset - space[1] }),
+      ]}
+    >
+      <Spacer flexible />
+      <Text
+        modifiers={[
+          ...textLook({ tone: dim ? 'secondary' : 'text', paragraph: true }),
+          textSelection(selectable),
+          padding({
+            leading: metrics.bubbleX,
+            trailing: metrics.bubbleX,
+            top: metrics.bubbleY,
+            bottom: metrics.bubbleY,
+          }),
+          background(theme.bubble),
+          clipShape('roundedRectangle', radius.bubble),
+        ]}
+      >
+        {text}
+      </Text>
+    </Row>
+  );
+}
+
+function Event({ text }: { text: string }) {
+  return (
+    <Row
+      alignment="center"
+      spacing={0}
+      modifiers={[padding({ leading: metrics.bubbleRoom, trailing: metrics.list.inset })]}
+    >
+      <Spacer flexible />
+      <Text modifiers={[...textLook({ variant: 'footnote', tone: 'secondary' }), lineLimit(3)]}>
+        {text}
+      </Text>
+    </Row>
+  );
+}
diff --git a/src/components/tasks/task-page.tsx b/src/components/tasks/task-page.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f7e26ad7ae4da4b06b30a79578d60a66d6b5e48f
--- /dev/null
+++ b/src/components/tasks/task-page.tsx
@@ -0,0 +1,330 @@
+import { Column, Icon, Row, ScrollView } from '@expo/ui';
+import {
+  accessibilityLabel,
+  contentShape,
+  frame,
+  monospacedDigit,
+  padding,
+  scrollClipDisabled,
+  shapes,
+} from '@expo/ui/swift-ui/modifiers';
+import type { ReactNode } from 'react';
+
+import { YourCall } from '@/components/tasks/ask-card';
+import { Header, Talk, type Door } from '@/components/tasks/bar';
+import { Mark } from '@/components/tasks/mark';
+import { Faded, SectionHead, Sections } from '@/components/tasks/parts';
+import { Pinned } from '@/components/tasks/pinned';
+import { PlaceTile, Places, hasPlaces } from '@/components/tasks/places';
+import { Foot, WriteField } from '@/components/tasks/thread';
+import { KIND, Steps, TraceLine } from '@/components/tasks/trace';
+import type { Ask, AskOption } from '@/live/asks';
+import { placeOf, type Place } from '@/live/inbox';
+import {
+  STATE_WORDS,
+  agentWords,
+  clock,
+  lastRun,
+  taskTime,
+  type Task,
+  type TaskRow,
+  type TaskId,
+} from '@/live/tasks';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, space } from '@/ui/tokens';
+
+const PREVIEW = 3;
+
+export function Detail({
+  task,
+  asks,
+  answered,
+  threads,
+  missing,
+  width,
+  onSteps,
+  onAnswer,
+  onUndo,
+  onAgain,
+  onDismiss,
+  onTalk,
+  onOpen,
+  onOpenTask,
+  messages,
+  beside = false,
+  answering = false,
+  onWrite,
+  foot = 0,
+}: {
+  task: TaskRow | Task;
+  asks: Ask[];
+  answered: Record<string, string | null>;
+  threads: TaskRow[];
+  missing: Set<Place>;
+  width: number;
+  onSteps: (id: TaskId) => void;
+  onAnswer: (ask: Ask, option: AskOption) => void;
+  onUndo: (ask: Ask) => void;
+  onAgain: (ask: Ask) => void;
+  onDismiss: (ask: Ask) => void;
+  onTalk: () => void;
+  onOpen: (thread: TaskRow) => void;
+  onOpenTask: (id: TaskId) => void;
+  messages?: ReactNode;
+  beside?: boolean;
+  // Writing your own answer to an ask, so its field is the one on the page.
+  answering?: boolean;
+  onWrite?: () => void;
+  foot?: number;
+}) {
+  const full = 'lately' in task ? task : undefined;
+  const needs = task.state === 'needs' && !asks.length ? (full?.needs ?? task.line) : undefined;
+  const lately = (full?.lately ?? []).filter((moment, i) => !(i === 0 && moment.text === needs));
+  const working = [task, ...threads.filter((one) => one.id !== task.id)].filter(
+    (one) => one.state === 'working',
+  );
+  const open = asks.filter((ask) => !answered[ask.id]).length;
+  const door = [task, ...threads].find((one) => one.link);
+  return (
+    <Column
+      alignment="center"
+      spacing={0}
+      modifiers={[frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' })]}
+    >
+      <Header
+        title={task.name}
+        subtitle={`${open ? `${open} need${open === 1 ? 's' : ''} you` : STATE_WORDS[task.state]} · ${taskTime(task)}`}
+        door={door && { place: placeOf(door.app), onPress: () => onOpen(door) }}
+      />
+      <Faded>
+        <ScrollView
+          key={beside ? 'beside' : 'alone'}
+          showsIndicators={false}
+          modifiers={[
+            scrollClipDisabled(),
+            frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' }),
+          ]}
+        >
+          <Column alignment="start" spacing={0} modifiers={[padding({ bottom: space[10] })]}>
+            <Sections>
+              {needs ? (
+                <Column key="needs" alignment="start" spacing={0}>
+                  <SectionHead title={`Waiting on you since ${clock(new Date(task.since))}`} />
+                  <Text
+                    paragraph
+                    modifiers={[
+                      padding({
+                        leading: metrics.list.inset,
+                        trailing: metrics.list.inset,
+                        bottom: space[1.5],
+                      }),
+                      frame({ maxWidth: Infinity, alignment: 'leading' }),
+                    ]}
+                  >
+                    {needs}
+                  </Text>
+                </Column>
+              ) : null}
+              {asks.length ? (
+                <YourCall
+                  key="call"
+                  asks={asks}
+                  answered={answered}
+                  width={width}
+                  onAnswer={onAnswer}
+                  onUndo={onUndo}
+                  onAgain={onAgain}
+                  onDismiss={onDismiss}
+                />
+              ) : null}
+              {working.length ? (
+                <Column key="working" alignment="start" spacing={0}>
+                  <SectionHead title="Working" />
+                  {working.map((thread) => (
+                    <Run
+                      key={thread.id}
+                      thread={thread.id === task.id && full ? full : thread}
+                      onPress={() => onSteps(thread.id)}
+                    />
+                  ))}
+                </Column>
+              ) : null}
+              {full && lastRun(full) ? (
+                <Column key="run" alignment="start" spacing={0}>
+                  <SectionHead title="Last run" />
+                  <Run thread={full} onPress={() => onSteps(full.id)} />
+                </Column>
+              ) : null}
+              {full?.pin ? <Pinned key="pin" text={full.pin} /> : null}
+              {messages}
+              {hasPlaces(task, threads) ? (
+                <Places
+                  key={`places:${task.id}`}
+                  task={task}
+                  threads={threads}
+                  missing={missing}
+                  onOpen={onOpen}
+                  onOpenTask={onOpenTask}
+                />
+              ) : null}
+              {lately.length ? (
+                <Column key="lately" alignment="start" spacing={0}>
+                  <SectionHead title="Lately" />
+                  {lately.map((moment, i) => (
+                    <TraceLine
+                      key={`${moment.at} ${i}`}
+                      lead={
+                        <Mark
+                          state={
+                            i === 0 ? moment.state : moment.state === 'failed' ? 'failed' : 'read'
+                          }
+                        />
+                      }
+                      text={moment.text}
+                      tone={i > 0 ? 'secondary' : undefined}
+                      time={clock(new Date(moment.at))}
+                    />
+                  ))}
+                </Column>
+              ) : null}
+            </Sections>
+          </Column>
+        </ScrollView>
+      </Faded>
+      {beside || answering ? null : (
+        <Foot foot={foot}>
+          {onWrite ? <WriteField title={task.place || task.name} onPress={onWrite} /> : null}
+          <Talk about={task.name} alone={!onWrite} onPress={onTalk} />
+        </Foot>
+      )}
+    </Column>
+  );
+}
+
+// A project with no thread to show (its threads left the board, or it's what's stuck or what
+// finished) still opens on what it has: its asks, then its other rows, with its way back and a
+// door to where they were asked.
+export function Asked({
+  topic,
+  asks,
+  answered,
+  width,
+  door,
+  rows,
+  onAnswer,
+  onUndo,
+  onAgain,
+  onDismiss,
+}: {
+  topic: string;
+  asks: Ask[];
+  answered: Record<string, string | null>;
+  width: number;
+  door?: Door;
+  rows?: ReactNode[];
+  onAnswer: (ask: Ask, option: AskOption) => void;
+  onUndo: (ask: Ask) => void;
+  onAgain: (ask: Ask) => void;
+  onDismiss: (ask: Ask) => void;
+}) {
+  const open = asks.filter((ask) => !answered[ask.id]).length;
+  const others = rows?.length ?? 0;
+  return (
+    <Column
+      alignment="center"
+      spacing={0}
+      modifiers={[frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' })]}
+    >
+      <Header
+        title={topic}
+        subtitle={open ? `${open} need${open === 1 ? 's' : ''} you` : `${others} here`}
+        door={door}
+      />
+      <Faded>
+        <ScrollView
+          showsIndicators={false}
+          modifiers={[
+            scrollClipDisabled(),
+            frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' }),
+          ]}
+        >
+          <Column alignment="start" spacing={0} modifiers={[padding({ bottom: space[10] })]}>
+            {asks.length ? (
+              <YourCall
+                asks={asks}
+                answered={answered}
+                width={width}
+                onAnswer={onAnswer}
+                onUndo={onUndo}
+                onAgain={onAgain}
+                onDismiss={onDismiss}
+              />
+            ) : null}
+            {rows}
+          </Column>
+        </ScrollView>
+      </Faded>
+    </Column>
+  );
+}
+
+function Run({ thread, onPress }: { thread: TaskRow | Task; onPress: () => void }) {
+  const working = thread.state === 'working';
+  const steps = 'steps' in thread ? thread.steps.slice(0, PREVIEW) : [];
+  const agents = agentWords(thread.agents, working);
+  return (
+    <Column
+      alignment="start"
+      spacing={0}
+      onPress={onPress}
+      modifiers={[
+        frame({ maxWidth: Infinity, alignment: 'leading' }),
+        contentShape(shapes.rectangle()),
+        accessibilityLabel(
+          `${thread.place}, ${STATE_WORDS[thread.state]}: ${thread.line}. Shows its steps`,
+        ),
+      ]}
+    >
+      <Row
+        alignment="center"
+        spacing={metrics.list.gap}
+        modifiers={[
+          padding({
+            leading: metrics.list.inset - space[0.5],
+            trailing: metrics.list.inset - space[0.5],
+            top: space[1],
+            bottom: space[0.5],
+          }),
+          frame({ maxWidth: Infinity }),
+        ]}
+      >
+        <PlaceTile place={placeOf(thread.app)} size={metrics.list.mark} />
+        <Text
+          numberOfLines={1}
+          variant="subheadline"
+          weight="semibold"
+          modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+        >
+          {thread.place}
+        </Text>
+        <Text variant="footnote" tone="tertiary" modifiers={[monospacedDigit()]}>
+          {taskTime(thread)}
+        </Text>
+        <Icon name="chevron.right" size={11} color={theme.tertiary} />
+      </Row>
+      {steps.length ? (
+        <Steps steps={steps} agents={thread.agents} opens={false} />
+      ) : working ? (
+        <TraceLine lead={<Mark state="working" />} text={thread.line} />
+      ) : null}
+      {agents ? (
+        <TraceLine
+          lead={<Icon name={KIND.agent} size={13} color={theme.secondary} />}
+          text={agents}
+          tone="secondary"
+        />
+      ) : null}
+    </Column>
+  );
+}
diff --git a/src/components/tasks/tasks-view.tsx b/src/components/tasks/tasks-view.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fe62ad0966f89b4519718594253e182964410456
--- /dev/null
+++ b/src/components/tasks/tasks-view.tsx
@@ -0,0 +1,472 @@
+import { Column, Row, Spacer, Text } from '@expo/ui';
+import { ProgressView, ZStack } from '@expo/ui/swift-ui';
+import {
+  accessibilityHidden,
+  animation,
+  background,
+  clipped,
+  foregroundStyle,
+  frame,
+  offset,
+  opacity,
+  scrollDismissesKeyboard,
+} from '@expo/ui/swift-ui/modifiers';
+import { useMemo, useState, type ReactNode } from 'react';
+import { Linking } from 'react-native';
+
+import { PageChrome, type Chrome } from '@/components/tasks/bar';
+import { LastCheck } from '@/components/tasks/last-check';
+import { ListPage } from '@/components/tasks/list';
+import {
+  shapeOf,
+  spotOf,
+  usePages,
+  type Level,
+  type Pages,
+  type Room,
+  type Spot,
+  Showing,
+  Typing,
+} from '@/components/tasks/pages';
+import { feel } from '@/components/tasks/parts';
+import { EntryRow } from '@/components/tasks/rows';
+import { Selectable } from '@/components/tasks/said';
+import { Asked, Detail } from '@/components/tasks/task-page';
+import { Messages, ThreadPage } from '@/components/tasks/thread';
+import { StepsLoading, Trace } from '@/components/tasks/trace';
+import { useAsks, useCheck } from '@/hooks/use-asks';
+import { useChat } from '@/hooks/use-chat';
+import { useTask, useTasks } from '@/hooks/use-tasks';
+import type { Ask, AskOption } from '@/live/asks';
+import {
+  inboxEntries,
+  placeOf,
+  taskIn,
+  topicIn,
+  type Place,
+  type Stage,
+  type Tile,
+} from '@/live/inbox';
+import type { TaskId, TaskRow } from '@/live/tasks';
+import { motion, rowsKey } from '@/motion';
+import { theme } from '@/theme';
+
+const NAMED_BACK = 420;
+
+// Every opening passes a new one, which restarts the pages and the list's tab.
+export type TasksAt = { task?: TaskId; stage?: Stage };
+
+export type TasksProps = {
+  open: boolean;
+  at: TasksAt;
+  haptics: boolean;
+  onTalk: (task: TaskRow) => void;
+  onGoThrough: () => void;
+  onOpenCall: (id: string) => void;
+};
+
+export function TasksView({
+  width,
+  foot = 0,
+  ...view
+}: TasksProps & { width: number; foot?: number }) {
+  const pages = usePages({ open: view.open, at: view.at, shape: shapeOf(width, undefined) });
+  return <Tasks {...view} pages={pages} room={{ width, foot, paged: false }} />;
+}
+
+export function Tasks({
+  open,
+  haptics,
+  onTalk,
+  onGoThrough,
+  onOpenCall,
+  at,
+  pages,
+  room,
+}: TasksProps & { pages: Pages; room: Room }) {
+  const { tasks, version, offline, current } = useTasks(open);
+  const yours = useAsks(open);
+  const [missing, setMissing] = useState<Set<Place>>(new Set());
+  const [typing, setTyping] = useState<Level | null>(null);
+  // A project with no thread to show has a page of its own, with nothing to fetch.
+  const { task } = useTask(taskIn(pages.task), version);
+  const traced = useTask(pages.stepsOf, version);
+  const checked = useCheck(pages.path.includes('check') ? yours.list?.check?.at : undefined);
+  const touch = feel(haptics);
+  const { tick, tap } = touch;
+  const entries = useMemo(
+    () => inboxEntries(tasks ?? [], yours.list, yours.shown),
+    [tasks, yours.list, yours.shown],
+  );
+  // An ask whose thread has left the board opens its topic's newest thread still on it, or else
+  // the topic's asks alone.
+  const asked = yours.shown.find((ask) => ask.task === pages.task);
+  const opened =
+    task ??
+    tasks?.find((row) => row.id === pages.task) ??
+    (asked ? newestOf((tasks ?? []).filter((row) => row.name === asked.topic)) : undefined);
+  const alone = opened || asked ? undefined : topicIn(pages.task);
+  const topic = opened?.name ?? asked?.topic ?? alone;
+  const threads = opened ? (tasks ?? []).filter((row) => row.name === opened.name) : [];
+  // The ask you tapped leads its topic's.
+  const topicAsks = topic
+    ? yours.shown
+        .filter((ask) => ask.topic === topic)
+        .sort((a, b) => Number(b.id === pages.row) - Number(a.id === pages.row))
+    : [];
+  const said = useChat(
+    open && opened && (pages.shape !== 'one' || pages.path.includes('topic')) ? opened.id : null,
+  );
+
+  const answer = (ask: Ask, option: AskOption) => {
+    tap();
+    yours.answer(ask, option);
+  };
+  const undo = (ask: Ask) => {
+    tick();
+    yours.undo(ask.id);
+  };
+  const again = (ask: Ask) => {
+    tap();
+    yours.again(ask);
+  };
+  const dismiss = (ask: Ask) => {
+    tap();
+    yours.dismiss(ask);
+  };
+  // A link to an app that isn't installed fails without a word from iOS, so its place says so.
+  const openLink = (link: string, place: Place) => {
+    tap();
+    Linking.openURL(link).then(
+      () => missing.has(place) && setMissing(new Set([...missing].filter((one) => one !== place))),
+      () => setMissing(new Set([...missing, place])),
+    );
+  };
+  const openThread = (thread: TaskRow) => openLink(thread.link!, placeOf(thread.app));
+  // Where an ask was asked, as its topic's way there when no thread of it is left to open.
+  const doorOf = (ask: Ask) => {
+    const where = ask.places.find((one) => one.link);
+    if (!where?.link) return undefined;
+    const place = placeOf(where.app);
+    return { place, onPress: () => openLink(where.link!, place) };
+  };
+  const openTile = (tile: Tile) => {
+    if (tile.kind === 'app') {
+      if (tile.link) openLink(tile.link, tile.place);
+      return;
+    }
+    tap();
+    if (tile.kind === 'call') onOpenCall(tile.call);
+    // A page's link is the web's, which the browser always opens.
+    else void Linking.openURL(tile.url).catch(() => undefined);
+  };
+  const openSteps = (id: TaskId) => {
+    tick();
+    pages.go({ to: 'steps', id });
+  };
+  const write = (write: boolean) => {
+    tick();
+    pages.go({ to: 'thread', write });
+  };
+  const talk = (thread: TaskRow) => {
+    tick();
+    onTalk(thread);
+  };
+
+  const spot = (level: Level) => spotOf(level, pages, room);
+  const names: Record<Level | 'call', string> = {
+    call: 'Call',
+    list: 'Tasks',
+    topic: opened?.name ?? 'Topic',
+    thread: (opened?.place || opened?.name) ?? 'Thread',
+    steps: 'Steps',
+    check: 'Last check',
+  };
+  // A narrow page's back is its chevron alone, as iOS shortens a back button with no room for its
+  // title.
+  const chromeOf = ({ back, width }: Spot): Chrome => ({
+    back: back && {
+      to: names[back],
+      short: width < NAMED_BACK,
+      onPress:
+        back === 'call'
+          ? pages.back
+          : () => {
+              tick();
+              pages.back();
+            },
+    },
+  });
+  const typingOn = (level: Level) => (on: boolean) => {
+    setTyping((was) => (on ? level : was === level ? null : was));
+    if (on) pages.go({ to: 'composerFocused' });
+  };
+  const moved = rowsKey([...pages.path, pages.task ?? '', pages.stepsOf ?? '']);
+  const page = (level: Level, children: ReactNode) => {
+    const at = spot(level);
+    return (
+      <PageAt key={level} spot={at} paged={room.paged} moved={moved}>
+        <PageChrome.Provider value={chromeOf(at)}>
+          <Showing.Provider value={open && at.shown}>
+            <Typing.Provider value={typingOn(level)}>
+              <Selectable.Provider value={typing !== level}>{children}</Selectable.Provider>
+            </Typing.Provider>
+          </Showing.Provider>
+        </PageChrome.Provider>
+      </PageAt>
+    );
+  };
+
+  const list = (
+    <ListPage
+      open={open}
+      at={at}
+      pages={pages}
+      spot={spot('list')}
+      paged={room.paged}
+      tasks={tasks}
+      offline={offline}
+      current={current}
+      yours={yours}
+      feel={touch}
+      onAnswer={answer}
+      onUndo={undo}
+      onOpenTile={openTile}
+      onGoThrough={onGoThrough}
+    />
+  );
+  // The topic and its conversation side by side are one view: the conversation's page shows only
+  // the messages and their composer, and the topic's shows everything else.
+  const paired = spot('topic').shown && spot('thread').shown;
+  const levels = [
+    page(
+      'topic',
+      opened ? (
+        <Detail
+          task={opened}
+          asks={topicAsks}
+          answered={yours.answered}
+          threads={threads}
+          missing={missing}
+          width={spot('topic').width}
+          onSteps={openSteps}
+          onAnswer={answer}
+          onUndo={undo}
+          onAgain={again}
+          onDismiss={dismiss}
+          onTalk={() => talk(opened)}
+          onOpen={openThread}
+          onOpenTask={(id) => {
+            tick();
+            pages.go({ to: 'topic', id });
+          }}
+          messages={
+            !paired && said.chat && (said.chat.total || said.chat.sends) ? (
+              <Messages
+                key="messages"
+                thread={opened}
+                chat={said.chat}
+                onOpen={() => write(false)}
