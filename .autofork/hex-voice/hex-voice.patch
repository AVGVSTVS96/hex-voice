@@ -0,0 +1,638 @@
+import { Column, Icon, Row, Spacer, TextInput } from '@expo/ui';
+import { HStack, Rectangle, VStack } from '@expo/ui/swift-ui';
+import {
+  accessibilityElement,
+  accessibilityIdentifier,
+  accessibilityLabel,
+  animation,
+  background,
+  clipShape,
+  contentShape,
+  foregroundStyle,
+  frame,
+  lineLimit,
+  monospacedDigit,
+  onTapGesture,
+  padding,
+  shapes,
+  strokeBorder,
+  type ModifierConfig,
+} from '@expo/ui/swift-ui/modifiers';
+import { useContext, useState } from 'react';
+
+import { Markdown } from '@/components/markdown';
+import { Mark } from '@/components/tasks/mark';
+import { Typing, useField } from '@/components/tasks/pages';
+import { noteAsk, useWords } from '@/hooks/use-asks';
+import { useDraft } from '@/hooks/use-draft';
+import { openURL, useFailures } from '@/hooks/use-failures';
+import { Failure, Hairline, SectionHead } from '@/components/tasks/parts';
+import {
+  NOT_NEEDED,
+  unreached,
+  type Ask,
+  type AskLink,
+  type AskOption,
+  type Words,
+} from '@/live/asks';
+import { fitsOneLine } from '@/live/inbox';
+import { clock } from '@/live/tasks';
+import { motion, rowsKey } from '@/motion';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { labelOf, metrics, radius, space, type } from '@/ui/tokens';
+
+// Compact, so a page of many asks scans: folded, a question and a line of why; open, its choices
+// on one line where they fit.
+const ROW = 40;
+// How much of the thread's own words show before a tap shows them all.
+const SAID = 6;
+// The pencil takes taps across 44 points but only the question's first line of height.
+const PENCIL = metrics.bar.button;
+const LINE = type.question.lineHeight;
+
+type Answer = (ask: Ask, option: AskOption) => void;
+
+export function YourCall({
+  asks,
+  answered,
+  width,
+  onAnswer,
+  onUndo,
+  onAgain,
+  onDismiss,
+}: {
+  asks: Ask[];
+  answered: Record<string, string | null>;
+  width: number;
+  onAnswer: Answer;
+  onUndo: (ask: Ask) => void;
+  onAgain: (ask: Ask) => void;
+  onDismiss: (ask: Ask) => void;
+}) {
+  const open = asks.filter((ask) => !answered[ask.id]).length;
+  return (
+    <Column
+      alignment="start"
+      spacing={0}
+      modifiers={[
+        animation(motion.list, rowsKey(asks.map((ask) => `${ask.id}=${answered[ask.id] ?? ''}`))),
+      ]}
+    >
+      <SectionHead title="Your call" count={open} />
+      {asks.map((ask, i) => {
+        const said = answered[ask.id];
+        if (said)
+          return (
+            <Row
+              key={ask.id}
+              alignment="center"
+              spacing={metrics.list.gap}
+              modifiers={[
+                padding({
+                  leading: metrics.list.inset - space[0.5],
+                  trailing: metrics.list.inset,
+                  top: space[2.5],
+                  bottom: space[3.5],
+                }),
+                frame({ maxWidth: Infinity, alignment: 'leading' }),
+              ]}
+            >
+              <Mark state="done" />
+              <Column
+                alignment="start"
+                spacing={space[0.25]}
+                modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+              >
+                <Text variant="subheadline" tone="secondary">
+                  {ask.question}
+                </Text>
+                <Text variant="subheadline">{said}</Text>
+                {ask.missed ? <Unreached missed={ask.missed} onAgain={() => onAgain(ask)} /> : null}
+                {ask.failed ? <Failure text={ask.failed} /> : null}
+              </Column>
+              <Text
+                variant="subheadline"
+                weight="semibold"
+                tone="accent"
+                onPress={() => onUndo(ask)}
+                modifiers={[accessibilityLabel(`Undo ${said}`)]}
+              >
+                Undo
+              </Text>
+            </Row>
+          );
+        return (
+          <Column
+            key={ask.id}
+            alignment="start"
+            spacing={0}
+            modifiers={[frame({ maxWidth: Infinity })]}
+          >
+            {i ? <Hairline /> : null}
+            <AskCard
+              ask={ask}
+              first={i === 0}
+              width={width}
+              onAnswer={onAnswer}
+              onDismiss={onDismiss}
+            />
+          </Column>
+        );
+      })}
+    </Column>
+  );
+}
+
+// Folded like a project row, the question and the first line of its background; a tap opens the
+// background whole, the thread's own words, and the answers. Writing on it keeps it open.
+function AskCard({
+  ask,
+  first,
+  width,
+  onAnswer,
+  onDismiss,
+}: {
+  ask: Ask;
+  first: boolean;
+  width: number;
+  onAnswer: Answer;
+  onDismiss: (ask: Ask) => void;
+}) {
+  const [open, setOpen] = useState(false);
+  const [writing, setWriting] = useState(false);
+  const words = useWords(open ? ask.id : null);
+  // A note leaves the ask open, so the card stays and says it went, or why it didn't.
+  const notes = useFailures();
+  const [noting, setNoting] = useState(false);
+  const [noted, setNoted] = useState(false);
+  const note = (text: string) => {
+    setNoting(true);
+    void notes
+      .attempt('note', 'Note not sent', () => noteAsk(ask, text))
+      .then((sent) => {
+        setNoting(false);
+        setNoted(sent);
+        if (sent) setWriting(false);
+      });
+  };
+  return (
+    <Column
+      alignment="start"
+      spacing={0}
+      modifiers={[frame({ maxWidth: Infinity }), animation(motion.list, open)]}
+    >
+      <HStack
+        alignment="top"
+        spacing={0}
+        modifiers={[
+          padding({
+            leading: metrics.list.inset,
+            top: first ? space[0.5] : space[3],
+            bottom: open ? space[1.5] : space[3],
+          }),
+          frame({ maxWidth: Infinity }),
+        ]}
+      >
+        <VStack
+          alignment="leading"
+          spacing={space[0.75]}
+          modifiers={[
+            frame({ maxWidth: Infinity, alignment: 'leading' }),
+            contentShape(shapes.rectangle()),
+            onTapGesture(() => setOpen(!open)),
+            accessibilityIdentifier('ask-card'),
+            accessibilityLabel(`${ask.question}. ${open ? 'Folds it' : 'Opens it'}`),
+          ]}
+        >
+          <Text
+            variant="question"
+            paragraph
+            modifiers={[
+              open ? lineLimit() : lineLimit(2),
+              frame({ maxWidth: Infinity, alignment: 'leading' }),
+            ]}
+          >
+            {ask.question}
+          </Text>
+          {ask.context ? (
+            <Text
+              variant="itemDetail"
+              tone="secondary"
+              paragraph
+              modifiers={[
+                open ? lineLimit() : lineLimit(1),
+                frame({ maxWidth: Infinity, alignment: 'leading' }),
+              ]}
+            >
+              {ask.context}
+            </Text>
+          ) : null}
+        </VStack>
+        {open ? (
+          <Row
+            alignment="center"
+            spacing={0}
+            style={{ width: PENCIL, height: PENCIL }}
+            onPress={() => setWriting(!writing)}
+            modifiers={[
+              padding({ top: (LINE - PENCIL) / 2, bottom: (LINE - PENCIL) / 2 }),
+              accessibilityLabel(writing ? 'Close your answer' : 'Write your own'),
+            ]}
+          >
+            <Spacer flexible />
+            <Icon
+              name="square.and.pencil"
+              size={15}
+              color={writing ? theme.accent : theme.secondary}
+            />
+          </Row>
+        ) : (
+          <Text
+            variant="footnote"
+            tone="tertiary"
+            modifiers={[
+              monospacedDigit(),
+              padding({ leading: metrics.list.gap, trailing: metrics.list.inset }),
+            ]}
+          >
+            {clock(new Date(ask.at))}
+          </Text>
+        )}
+      </HStack>
+      {open ? (
+        <Column
+          alignment="start"
+          spacing={space[0.75]}
+          modifiers={[
+            padding({
+              leading: metrics.list.inset,
+              trailing: metrics.list.inset,
+              bottom: space[1.5],
+            }),
+            frame({ maxWidth: Infinity, alignment: 'leading' }),
+          ]}
+        >
+          {words ? <Said words={words} /> : null}
+          {ask.links?.length ? <Links links={ask.links} /> : null}
+          {notes.failed.note ? (
+            <Failure text={notes.failed.note} modifiers={[padding({ top: space[1] })]} />
+          ) : noted ? (
+            <Text
+              variant="footnote"
+              tone="secondary"
+              paragraph
+              modifiers={[padding({ top: space[1] })]}
+            >
+              {`Note sent to ${ask.topic}`}
+            </Text>
+          ) : null}
+        </Column>
+      ) : null}
+      {ask.failed ? (
+        <Failure
+          text={ask.failed}
+          modifiers={[
+            padding({
+              leading: metrics.list.inset,
+              trailing: metrics.list.inset,
+              bottom: open ? space[1.5] : space[3],
+            }),
+          ]}
+        />
+      ) : null}
+      {!open ? null : writing ? (
+        <Composer
+          draft={`ask:${ask.id}`}
+          topic={ask.topic}
+          sending={noting}
+          onNote={note}
+          onAnswer={(label) => onAnswer(ask, { label })}
+          onDismiss={() => onDismiss(ask)}
+        />
+      ) : (
+        <Answers ask={ask} width={width} onAnswer={onAnswer} />
+      )}
+    </Column>
+  );
+}
+
+// The thread's own words, under where and when they were said: a few lines, all of them on a tap.
+function Said({ words }: { words: Words }) {
+  const [whole, setWhole] = useState(false);
+  const when = words.at ? ` · ${clock(new Date(words.at))}` : '';
+  return (
+    <Column
+      alignment="start"
+      spacing={space[0.5]}
+      onPress={() => setWhole(!whole)}
+      modifiers={[
+        padding({ top: space[2], bottom: space[0.5] }),
+        frame({ maxWidth: Infinity, alignment: 'leading' }),
+        contentShape(shapes.rectangle()),
+        animation(motion.list, whole),
+        accessibilityElement('combine'),
+      ]}
+    >
+      <Text variant="footnote" weight="semibold" tone="secondary">
+        {`From ${words.place}${when}`}
+      </Text>
+      <Markdown
+        inline={!whole}
+        lines={whole ? undefined : SAID}
+        variant="itemDetail"
+        tone="secondary"
+        modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+      >
+        {words.text}
+      </Markdown>
+    </Column>
+  );
+}
+
+function Links({ links }: { links: AskLink[] }) {
+  const tries = useFailures();
+  const failed = links.map((link) => tries.failed[link.url]).find(Boolean);
+  return (
+    <Column alignment="start" spacing={space[1]} modifiers={[padding({ top: space[1] })]}>
+      <Row alignment="center" spacing={space[1.5]}>
+        {links.map((link, i) => (
+          <Row key={link.url} alignment="center" spacing={space[1.5]}>
+            {i ? (
+              <Text variant="subheadline" tone="tertiary">
+                ·
+              </Text>
+            ) : null}
+            <Row
+              alignment="center"
+              spacing={space[0.75]}
+              onPress={() => void tries.attempt(link.url, 'Not opened', () => openURL(link.url))}
+              modifiers={[accessibilityLabel(`Open ${link.label}`)]}
+            >
+              <Text numberOfLines={1} variant="subheadline" tone="secondary">
+                {link.label}
+              </Text>
+              <Icon name="arrow.up.right" size={11} color={theme.secondary} />
+            </Row>
+          </Row>
+        ))}
+      </Row>
+      {failed ? <Failure text={failed} /> : null}
+    </Column>
+  );
+}
+
+export function InlineAnswers({
+  ask,
+  onAnswer,
+  modifiers,
+}: {
+  ask: Ask;
+  onAnswer: Answer;
+  modifiers: ModifierConfig[];
+}) {
+  return (
+    <Row alignment="center" spacing={space[3.5]} modifiers={modifiers}>
+      {ask.options.map((option, i) => (
+        <Row key={option.label} alignment="center" spacing={space[3.5]}>
+          {i ? (
+            <Rectangle
+              modifiers={[frame({ width: 1, height: space[3.5] }), foregroundStyle(theme.edge)]}
+            />
+          ) : null}
+          <Row
+            alignment="center"
+            spacing={space[1.25]}
+            onPress={() => onAnswer(ask, option)}
+            modifiers={[
+              padding({ top: space[1.5], bottom: space[1] }),
+              accessibilityLabel(option.pick ? `${option.label}, hex’s pick` : option.label),
+            ]}
+          >
+            {option.pick ? <Icon name="checkmark" size={12} color={theme.accent} /> : null}
+            <Text
+              numberOfLines={1}
+              variant="subheadline"
+              weight={option.pick ? 'semibold' : 'medium'}
+              tone={option.pick ? 'accent' : 'secondary'}
+            >
+              {option.label}
+            </Text>
+          </Row>
+        </Row>
+      ))}
+    </Row>
+  );
+}
+
+function Answers({ ask, width, onAnswer }: { ask: Ask; width: number; onAnswer: Answer }) {
+  if (!ask.options.length) return null;
+  if (fitsOneLine(ask.options, width - 2 * metrics.list.inset, type.subheadline.fontSize))
+    return (
+      <InlineAnswers
+        ask={ask}
+        onAnswer={onAnswer}
+        modifiers={[
+          padding({
+            leading: metrics.list.inset,
+            trailing: metrics.list.inset,
+            top: 0,
+            bottom: space[2.5],
+          }),
+        ]}
+      />
+    );
+  return (
+    <Column
+      alignment="start"
+      spacing={0}
+      modifiers={[frame({ maxWidth: Infinity }), padding({ bottom: space[1] })]}
+    >
+      {ask.options.map((option) => (
+        <Choice key={option.label} option={option} onPress={() => onAnswer(ask, option)} />
+      ))}
+    </Column>
+  );
+}
+
+function Choice({ option, onPress }: { option: AskOption; onPress: () => void }) {
+  return (
+    <Row
+      alignment="center"
+      spacing={space[3]}
+      onPress={onPress}
+      modifiers={[
+        padding({
+          leading: metrics.list.inset,
+          trailing: metrics.list.inset,
+          top: space[1.5],
+          bottom: space[1.5],
+        }),
+        frame({ minHeight: ROW }),
+        frame({ maxWidth: Infinity }),
+        contentShape(shapes.rectangle()),
+        accessibilityLabel(option.pick ? `${option.label}, hex’s pick` : option.label),
+      ]}
+    >
+      {option.pick ? (
+        <Icon name="checkmark" size={14} color={theme.accent} />
+      ) : (
+        <Spacer style={{ width: 14 }} />
+      )}
+      <Text
+        variant="subheadline"
+        weight={option.pick ? 'medium' : 'regular'}
+        tone={option.pick ? 'accent' : 'text'}
+        paragraph
+        modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+      >
+        {option.label}
+      </Text>
+      {option.pick ? (
+        <Text variant="caption" weight="medium" tone="accent">
+          hex’s pick
+        </Text>
+      ) : null}
+    </Row>
+  );
+}
+
+// What you write goes to the ask's thread as a note and leaves the ask open: ↑ is the one accent
+// action. Answering with it instead is the deliberate second step, drawn in text and not accent so
+// it never reads as already answered, and Not needed puts the ask away with no answer at all.
+// None of them goes while a note is on its way.
+function Composer({
+  draft,
+  topic,
+  sending,
+  onNote,
+  onAnswer,
+  onDismiss,
+}: {
+  draft: string;
+  topic: string;
+  sending: boolean;
+  onNote: (text: string) => void;
+  onAnswer: (text: string) => void;
+  onDismiss: () => void;
+}) {
+  const { first, keep } = useDraft(draft);
+  const [text, setText] = useState(first);
+  const typing = useContext(Typing);
+  const field = useField();
+  const words = sending ? '' : text.trim();
+  return (
+    <Column alignment="start" spacing={0} modifiers={[frame({ maxWidth: Infinity })]}>
+      <Row
+        alignment="end"
+        spacing={space[2.5]}
+        modifiers={[
+          padding({
+            leading: space[3.5],
+            trailing: space[1.5],
+            top: space[1.5],
+            bottom: space[1.5],
+          }),
+          frame({ minHeight: ROW - 8 }),
+          frame({ maxWidth: Infinity, alignment: 'leading' }),
+          background(theme.surface),
+          clipShape('roundedRectangle', radius.control),
+          strokeBorder({
+            content: theme.edge,
+            style: { lineWidth: 1 },
+            shape: 'roundedRectangle',
+            cornerRadius: radius.control,
+          }),
+          padding({
+            leading: metrics.list.inset - space[1.5],
+            trailing: metrics.list.inset - space[1.5],
+            top: space[1.5],
+            bottom: space[1.5],
+          }),
+        ]}
+      >
+        <TextInput
+          ref={field}
+          autoFocus
+          multiline
+          testID="ask-input"
+          onFocus={() => typing(true)}
+          onBlur={() => typing(false)}
+          defaultValue={first}
+          placeholder={`A note for ${topic}`}
+          placeholderTextColor={theme.tertiary}
+          cursorColor={theme.accent}
+          onChangeText={(now) => {
+            setText(now);
+            keep(now);
+          }}
+          textStyle={labelOf('body')}
+          modifiers={[
+            foregroundStyle(theme.text),
+            padding({ top: space[1.5], bottom: space[1.5] }),
+            frame({ maxWidth: Infinity, alignment: 'leading' }),
+          ]}
+        />
+        <Icon
+          name="arrow.up.circle.fill"
+          size={30}
+          color={words ? theme.accent : theme.tertiary}
+          onPress={words ? () => onNote(words) : undefined}
+          modifiers={[accessibilityLabel(`Send a note to ${topic}`)]}
+        />
+      </Row>
+      <Row
+        alignment="center"
+        spacing={0}
+        modifiers={[
+          padding({
+            leading: metrics.list.inset,
+            trailing: metrics.list.inset,
+            top: space[1],
+            bottom: space[2.5],
+          }),
+          frame({ maxWidth: Infinity }),
+        ]}
+      >
+        <Row
+          alignment="center"
+          spacing={space[1.25]}
+          onPress={words ? () => onAnswer(words) : undefined}
+          modifiers={[accessibilityLabel('Answer with this')]}
+        >
+          <Icon name="checkmark" size={12} color={words ? theme.text : theme.tertiary} />
+          <Text variant="subheadline" weight="semibold" tone={words ? 'text' : 'tertiary'}>
+            Answer with this
+          </Text>
+        </Row>
+        <Spacer flexible />
+        <Text
+          variant="subheadline"
+          weight="regular"
+          tone={sending ? 'tertiary' : 'secondary'}
+          onPress={sending ? undefined : onDismiss}
+        >
+          {NOT_NEEDED}
+        </Text>
+      </Row>
+    </Column>
+  );
+}
+
+// An answer that couldn't reach every place, and the way to finish it.
+export function Unreached({ missed, onAgain }: { missed: number; onAgain: () => void }) {
+  return (
+    <Row alignment="center" spacing={space[2]} modifiers={[frame({ maxWidth: Infinity })]}>
+      <Failure text={unreached(missed)} />
+      <Text
+        variant="footnote"
+        weight="semibold"
+        tone="accent"
+        onPress={onAgain}
+        modifiers={[padding({ top: space[1.5], bottom: space[1.5] })]}
+      >
+        Send again
+      </Text>
+    </Row>
+  );
+}
diff --git a/src/components/tasks/bar.tsx b/src/components/tasks/bar.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d1dbb01b7bcfaedf582a747223d6bb0ac7776e53
--- /dev/null
+++ b/src/components/tasks/bar.tsx
@@ -0,0 +1,201 @@
+import { Column, Icon, Row } from '@expo/ui';
+import { Button } from '@expo/ui/swift-ui';
+import {
+  accessibilityLabel,
+  buttonStyle,
+  contentShape,
+  disabled as disabledModifier,
+  frame,
+  opacity,
+  padding,
+  shapes,
+} from '@expo/ui/swift-ui/modifiers';
+import { createContext, useContext, type ReactNode } from 'react';
+
+import { PlaceTile } from '@/components/tasks/places';
+import { glass } from '@/ui/glass-button';
+import { PLACES, type Place } from '@/live/inbox';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, space } from '@/ui/tokens';
+
+// Back names where it goes; `short`, it shows only its chevron, and still says where to VoiceOver.
+export type Back = { to: string; short: boolean; onPress: () => void };
+
+export type Chrome = { back?: Back };
+export const PageChrome = createContext<Chrome>({});
+export const useChrome = () => useContext(PageChrome);
+
+export type Door = { place: Place; onPress: () => void };
+
+export function Header({
+  title,
+  subtitle,
+  door,
+}: {
+  title: string;
+  subtitle: string;
+  door?: Door;
+}) {
+  const { back } = useChrome();
+  return (
+    <PageBar
+      title={title}
+      subtitle={subtitle}
+      back={back}
+      trailing={door ? <DoorPill door={door} /> : undefined}
+    />
+  );
+}
+
+export function PageBar({
+  title,
+  subtitle,
+  back,
+  trailing,
+}: {
+  title: string;
+  subtitle?: string;
+  back?: Back;
+  trailing?: ReactNode;
+}) {
+  const backButton = back ? <BackButton back={back} /> : null;
+  return (
+    <Row
+      alignment="center"
+      spacing={space[3]}
+      modifiers={[
+        padding({
+          leading: metrics.list.inset - space[1],
+          trailing: space[4],
+          top: space[1.5],
+          bottom: space[1.5],
+        }),
+        frame({ minHeight: metrics.bar.button + space[3] }),
+        frame({ maxWidth: Infinity }),
+      ]}
+    >
+      {backButton}
+      <Column
+        alignment="start"
+        spacing={space[0.25]}
+        modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+      >
+        <Text numberOfLines={1} variant="headline">
+          {title}
+        </Text>
+        {subtitle ? (
+          <Text numberOfLines={1} variant="footnote" tone="secondary">
+            {subtitle}
+          </Text>
+        ) : null}
+      </Column>
+      {trailing}
+    </Row>
+  );
+}
+
+export function BackButton({ back }: { back: Back }) {
+  return (
+    <BarButton
+      shape={back.short ? 'circle' : 'capsule'}
+      label={`Back to ${back.to}`}
+      testID="task-back"
+      onPress={back.onPress}
+    >
+      <Icon name="chevron.left" size={metrics.symbol.bar} color={theme.accent} />
+      {!back.short ? (
+        <Text numberOfLines={1} weight="medium" tone="accent">
+          {back.to}
+        </Text>
+      ) : null}
+    </BarButton>
+  );
+}
+
+// The way out to the app a page lives in: its place's tile in a glass circle, so the title keeps
+// the bar's width.
+function DoorPill({ door }: { door: Door }) {
+  return (
+    <BarButton shape="circle" label={`Open in ${PLACES[door.place]}`} onPress={door.onPress}>
+      <PlaceTile place={door.place} size={24} />
+    </BarButton>
+  );
+}
+
+// Talk a topic through with hex: a secondary glass button at a page's foot, a circle beside the
+// composer or named on its own. Its own glyph, so it never reads as the call's button beside it.
+export function Talk({
+  about,
+  alone,
+  onPress,
+}: {
+  about: string;
+  alone: boolean;
+  onPress: () => void;
+}) {
+  return (
+    <BarButton
+      shape={alone ? 'capsule' : 'circle'}
+      label={`Talk ${about} through with hex`}
+      testID="talk-it-through"
+      onPress={onPress}
+    >
+      <Icon name="phone.and.waveform" size={metrics.symbol.bar} color={theme.text} />
+      {alone ? (
+        <Text numberOfLines={1} variant="callout" weight="semibold">
+          Talk it through
+        </Text>
+      ) : null}
+    </BarButton>
+  );
+}
+
+// Not buttonStyle('glass'): its padding grows each control past 44pt by a different amount.
+export function BarButton({
+  shape,
+  label,
+  testID,
+  disabled = false,
+  onPress,
+  children,
+}: {
+  shape: 'circle' | 'capsule';
+  label: string;
+  testID?: string;
+  disabled?: boolean;
+  onPress: () => void;
+  children: ReactNode;
+}) {
+  return (
+    <Button
+      onPress={onPress}
+      testID={testID}
+      modifiers={[
+        buttonStyle('plain'),
+        ...(disabled ? [disabledModifier(true), opacity(0.4)] : []),
+        accessibilityLabel(label),
+      ]}
+    >
+      <Row
+        alignment="center"
+        spacing={shape === 'circle' ? 0 : metrics.bar.capsule.gap}
+        modifiers={[
+          ...(shape === 'circle'
+            ? [frame({ width: metrics.bar.button, height: metrics.bar.button })]
+            : [
+                padding({
+                  leading: metrics.bar.capsule.leading,
+                  trailing: metrics.bar.capsule.trailing,
+                }),
+                frame({ height: metrics.bar.button }),
+              ]),
+          glass(shape),
+          contentShape(shape === 'circle' ? shapes.circle() : shapes.capsule()),
+        ]}
+      >
+        {children}
+      </Row>
+    </Button>
+  );
+}
diff --git a/src/components/tasks/inbox.tsx b/src/components/tasks/inbox.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..363cb86ffa110625cb596af1f3cb808ac4ed36f8
--- /dev/null
+++ b/src/components/tasks/inbox.tsx
@@ -0,0 +1,215 @@
+import { Icon, Row, Spacer } from '@expo/ui';
+import { Button, Circle, ConfirmationDialog, Text as NativeText } from '@expo/ui/swift-ui';
+import {
+  accessibilityLabel,
+  contentShape,
+  foregroundStyle,
+  frame,
+  layoutPriority,
+  padding,
+  shapes,
+} from '@expo/ui/swift-ui/modifiers';
+import { useState } from 'react';
+
+import { Mark } from '@/components/tasks/mark';
+import { asks, listRow } from '@/components/tasks/parts';
+import { checkLine, type Ask, type AskOption, type CheckSummary } from '@/live/asks';
+import type { Stage, Topic } from '@/live/inbox';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, space } from '@/ui/tokens';
+
+const MARKS = 6;
+
+export function TopicHead({
+  topic,
+  width,
+  onPress,
+}: {
+  topic: Topic;
+  width: number;
+  onPress?: () => void;
+}) {
+  return (
+    <Row
+      alignment="center"
+      spacing={space[2]}
+      onPress={onPress}
+      modifiers={[
+        padding({
+          leading: metrics.list.inset,
+          trailing: metrics.list.inset - space[1],
+          top: space[3.5],
+          bottom: space[0.5],
+        }),
+        frame({ maxWidth: Infinity }),
+        contentShape(shapes.rectangle()),
+        ...listRow(width, { bottom: false }),
+        ...(onPress ? [accessibilityLabel(`${topic.name}. Opens it`)] : []),
+      ]}
+    >
+      <Text
+        numberOfLines={1}
+        variant="subheadline"
+        weight="semibold"
+        modifiers={[layoutPriority(1)]}
+      >
+        {topic.name}
+      </Text>
+      {topic.marks.length ? <Dots marks={topic.marks} /> : null}
+      <Spacer flexible />
+      {onPress ? <Icon name="chevron.right" size={11} color={theme.tertiary} /> : null}
+    </Row>
+  );
+}
+
+export function Dots({ marks }: { marks: Stage[] }) {
+  return (
+    <Row alignment="center" spacing={metrics.dots.gap}>
+      {marks.slice(0, MARKS).map((stage, i) => (
+        <Circle
+          key={i}
+          modifiers={[
+            frame({ width: metrics.dots.size, height: metrics.dots.size }),
+            foregroundStyle(
+              stage === 'needs'
+                ? theme.accent
+                : stage === 'working'
+                  ? theme.accentTrack
+                  : stage === 'done'
+                    ? theme.secondary
+                    : theme.surfaceSelected,
+            ),
+          ]}
+        />
+      ))}
+    </Row>
+  );
+}
+
+function Strip({
+  width,
+  mark,
+  title,
+  detail,
+  action,
+  label,
+  onPress,
+}: {
+  width: number;
+  mark: 'done' | 'read';
+  title: string;
+  detail?: string;
+  action?: string;
+  label: string;
+  onPress?: () => void;
+}) {
+  return (
+    <Row
+      alignment="center"
+      spacing={metrics.list.gap}
+      onPress={onPress}
+      modifiers={[
+        padding({
+          leading: metrics.list.inset - space[0.5],
+          trailing: metrics.list.inset,
+          top: space[3],
+          bottom: space[3],
+        }),
+        frame({ maxWidth: Infinity }),
+        contentShape(shapes.rectangle()),
+        ...listRow(width),
+        accessibilityLabel(label),
+      ]}
+    >
+      <Mark state={mark} />
+      <Text numberOfLines={1} variant="subheadline" weight="medium" modifiers={[layoutPriority(1)]}>
+        {title}
+      </Text>
+      {detail ? (
+        <Text numberOfLines={1} variant="subheadline" tone="secondary">
+          {detail}
+        </Text>
+      ) : null}
+      <Spacer flexible />
+      {action ? (
+        <Text variant="subheadline" weight="semibold" tone="accent">
+          {action}
+        </Text>
+      ) : (
+        <Icon name="chevron.right" size={11} color={theme.tertiary} />
+      )}
+    </Row>
+  );
+}
+
+export function CheckRow({
+  check,
+  width,
+  onPress,
+}: {
+  check: CheckSummary;
+  width: number;
+  onPress: () => void;
+}) {
+  const { title, did } = checkLine(check);
+  return (
+    <Strip
+      width={width}
+      mark="read"
+      title={title}
+      detail={did}
+      label={`${title}${did ? `, ${did}` : ''}. Opens the last check`}
+      onPress={onPress}
+    />
+  );
+}
+
+// It asks once more first, since it answers for you many times over, naming each question and the
+// answer it would give.
+export function PicksRow({
+  picks,
+  width,
+  onTake,
+}: {
+  picks: { ask: Ask; option: AskOption }[];
+  width: number;
+  onTake: () => void;
+}) {
+  const [asking, setAsking] = useState(false);
+  const n = picks.length;
+  return (
+    <ConfirmationDialog
+      title={`Take hex’s ${n} picks?`}
+      isPresented={asking}
+      onIsPresentedChange={setAsking}
+      titleVisibility="visible"
+    >
+      <ConfirmationDialog.Trigger>
+        <Strip
+          width={width}
+          mark="done"
+          title={`hex has a pick for ${asks(n)}`}
+          action={`Take ${n}`}
+          label={`hex has a pick for ${asks(n)}. Take them`}
+          onPress={() => setAsking(true)}
+        />
+      </ConfirmationDialog.Trigger>
+      <ConfirmationDialog.Actions>
+        <Button label={`Take ${n} picks`} onPress={onTake} />
+        <Button label="Cancel" role="cancel" />
+      </ConfirmationDialog.Actions>
+      <ConfirmationDialog.Message>
+        <NativeText>
+          {picks.map(({ ask, option }) => `${clip(ask.question)} → ${option.label}`).join('\n\n')}
+        </NativeText>
+      </ConfirmationDialog.Message>
+    </ConfirmationDialog>
+  );
+}
+
+const CLIP = 70;
+
+function clip(text: string) {
+  return text.length > CLIP ? `${text.slice(0, CLIP - 1).trimEnd()}…` : text;
+}
