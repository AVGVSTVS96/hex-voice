@@ -0,0 +1,13 @@
+import { createContext, use } from 'react';
+
+export type Size = { width: number; height: number };
+
+// The screen's one size: what its root view is laid out at, provided by the call screen's root.
+// React Native's window size can disagree with it for a moment, as while iPhone Duo unfolds.
+export const Viewport = createContext<Size | null>(null);
+
+export function useViewport(): Size {
+  const size = use(Viewport);
+  if (!size) throw new Error("useViewport() needs the Viewport the call screen's root provides");
+  return size;
+}
diff --git a/src/hooks/use-voice-preview.ts b/src/hooks/use-voice-preview.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d6c66229329cb787cff463517325f83f634c34d5
--- /dev/null
+++ b/src/hooks/use-voice-preview.ts
@@ -0,0 +1,60 @@
+import {
+  setAudioModeAsync,
+  setIsAudioActiveAsync,
+  useAudioPlayer,
+  type AudioMode,
+} from 'expo-audio';
+import { useEffect, useState } from 'react';
+
+import { VOICE_PREVIEWS } from '@/live/voice-previews';
+import type { LiveVoice } from '@/live/voices';
+
+// A preview is a sound you asked to hear, so it plays with the silent switch on and ducks other
+// apps' music instead of stopping it. Previews never play during a call, and WebRTC sets its own
+// session whenever a call's audio starts, so this mode never reaches a call.
+const PREVIEW_AUDIO: Partial<AudioMode> = {
+  playsInSilentMode: true,
+  interruptionMode: 'duckOthers',
+};
+// The call's chimes keep the audio session awake, so leaving the previews doesn't let it go: music
+// comes back up only once the mode stops asking to duck it.
+const SHARED_AUDIO: Partial<AudioMode> = {
+  playsInSilentMode: true,
+  interruptionMode: 'mixWithOthers',
+};
+
+export function useVoicePreview(voice: LiveVoice, playing: boolean, take = 0) {
+  const player = useAudioPlayer(null);
+  const [ready, setReady] = useState(false);
+
+  useEffect(() => {
+    if (!playing) return;
+    let open = true;
+    void setAudioModeAsync(PREVIEW_AUDIO)
+      .catch(() => {})
+      .then(() => open && setReady(true));
+    return () => {
+      open = false;
+      setReady(false);
+      player.pause();
+      void setAudioModeAsync(SHARED_AUDIO).catch(() => {});
+    };
+  }, [player, playing]);
+
+  // Waking the audio session can take a moment, so it happens off the JavaScript thread before the
+  // swipe's preview starts, leaving play() nothing slow to do.
+  useEffect(() => {
+    if (!ready) return;
+    let current = true;
+    void setIsAudioActiveAsync(true)
+      .catch(() => {})
+      .then(() => {
+        if (!current) return;
+        player.replace(VOICE_PREVIEWS[voice]);
+        player.play();
+      });
+    return () => {
+      current = false;
+    };
+  }, [player, voice, ready, take]);
+}
