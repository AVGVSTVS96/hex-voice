index 0000000000000000000000000000000000000000..c5ea171bd2bedf94f9996ca87d2fabb1e21a87b9
--- /dev/null
+++ b/src/call/glide.ts
@@ -0,0 +1,138 @@
+import { useEffect } from 'react';
+import { Gesture } from 'react-native-gesture-handler';
+import {
+  cancelAnimation,
+  useAnimatedReaction,
+  useSharedValue,
+  withSpring,
+  withTiming,
+} from 'react-native-reanimated';
+import { scheduleOnRN } from 'react-native-worklets';
+
+import { motion } from '@/motion';
+
+const COMMIT = 0.35;
+const FLICK = 500;
+const RUBBER_BAND = 44;
+const LANDED = 2;
+
+type Glide = {
+  // Where it's going: 1 reads the words, 0 rests.
+  reading: boolean;
+  // How far down the orb travels from resting to reading (negative goes up), and how far it goes.
+  travel: number;
+  reach: number;
+  reducedMotion: boolean;
+  // A drag crossing the line where letting go changes where it lands.
+  onCross: () => void;
+  onLand: () => void;
+  onRelease: (reading: boolean) => void;
+};
+
+// The orb's glide between resting and reading the words: `progress` runs 0 to 1, a drag past
+// either end stretches on a rubber band, and letting go lands it on the side the drag committed
+// to, or where a flick sends it, at the drag's own speed.
+export function useGlide({
+  reading,
+  travel,
+  reach,
+  reducedMotion,
+  onCross,
+  onLand,
+  onRelease,
+}: Glide) {
+  const progress = useSharedValue(reading ? 1 : 0);
+  const goal = useSharedValue(reading ? 1 : 0);
+  const grab = useSharedValue({ offset: 0, line: COMMIT, crossed: false });
+  const landing = useSharedValue(-1);
+
+  const glideTo = (target: number, velocity = 0) => {
+    'worklet';
+    goal.set(target);
+    landing.set(target);
+    if (reducedMotion) {
+      progress.set(withTiming(target, motion.reduced));
+      return;
+    }
+    const distance = Math.abs(target - progress.get());
+    const direction = Math.sign(target - progress.get());
+    const toward = Math.max(0, direction * velocity);
+    const omega = Math.min(
+      Math.max(motion.glide.ease, toward / (distance || 1)),
+      motion.glide.snap,
+    );
+    progress.set(
+      withSpring(target, {
+        mass: 1,
+        stiffness: omega * omega,
+        damping: 2 * omega,
+        velocity: direction * Math.min(toward, omega * distance),
+      }),
+    );
+  };
+
+  // A drag or a tap has already sent it on its way, so this only moves it when something else
+  // changed what shows, like turning the device or opening a call.
+  useEffect(() => {
+    const target = reading ? 1 : 0;
+    if (goal.get() !== target) glideTo(target);
+  }, [reading]);
+
+  useAnimatedReaction(
+    () => progress.get(),
+    (now) => {
+      const target = landing.get();
+      if (target >= 0 && Math.abs(now - target) * reach <= LANDED) {
+        landing.set(-1);
+        scheduleOnRN(onLand);
+      }
+    },
+  );
+
+  const drag = () =>
+    Gesture.Pan()
+      .activeOffsetY([-12, 12])
+      .onStart(({ translationY }) => {
+        'worklet';
+        cancelAnimation(progress);
+        landing.set(-1);
+        const now = progress.get();
+        grab.set({
+          offset: now - translationY / travel,
+          line: goal.get() === 0 ? now + COMMIT : now - COMMIT,
+          crossed: false,
+        });
+      })
+      .onUpdate(({ translationY }) => {
+        'worklet';
+        const { offset, line, crossed } = grab.get();
+        const raw = offset + translationY / travel;
+        const limit = RUBBER_BAND / travel;
+        const over = raw < 0 ? -raw : raw > 1 ? raw - 1 : 0;
+        const banded = limit * (1 - 1 / ((over * 0.55) / limit + 1));
+        progress.set(raw < 0 ? -banded : raw > 1 ? 1 + banded : raw);
+        const past = goal.get() === 0 ? raw >= line : raw <= line;
+        if (past !== crossed) {
+          grab.set({ offset, line, crossed: past });
+          scheduleOnRN(onCross);
+        }
+      })
+      .onEnd(({ velocityY }) => {
+        'worklet';
+        const from = goal.get();
+        const target =
+          velocityY > FLICK ? 1 : velocityY < -FLICK ? 0 : grab.get().crossed ? 1 - from : from;
+        glideTo(target, velocityY / travel);
+        scheduleOnRN(onRelease, target === 1);
+      });
+
+  // How far along its way from resting to reading the orb is (`t`), and its sideways share of that
+  // (`arc`), which starts slow so it drops before it slides. What travels with it uses the same two.
+  const glide = (p: number) => {
+    'worklet';
+    const t = reducedMotion ? (p < 0.5 ? 0 : 1) : p;
+    return { t, arc: t <= 0 ? 0 : t <= 1 ? t * t : 2 * t - 1 };
+  };
+
+  return { progress, glideTo, drag, glide };
+}
diff --git a/src/call/orb.tsx b/src/call/orb.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..017a617a1562ff1f2a5d2d9c5835f05bda1162f1
--- /dev/null
+++ b/src/call/orb.tsx
@@ -0,0 +1,73 @@
+import { useEffect, useState } from 'react';
+import {
+  useAnimatedReaction,
+  useSharedValue,
+  withRepeat,
+  withSpring,
+  withTiming,
+} from 'react-native-reanimated';
+
+import { personaOf, wakeOf, type Call } from '@/call/call';
+import { useLevels } from '@/call/use-call';
+import { Persona, type PersonaProps } from '@/components/persona';
+import { useVoiceTone } from '@/hooks/use-voice-tone';
+import { motion } from '@/motion';
+
+// The orb's face. Only it redraws as hex starts and stops speaking.
+export function CallPersona({ call, ...persona }: { call: Call } & Omit<PersonaProps, 'state'>) {
+  const [speaking, setSpeaking] = useState(false);
+  useLevels(({ output }) => setSpeaking(output > 0.035));
+  return <Persona {...persona} state={personaOf(call, speaking)} />;
+}
+
+// How the orb's body answers the call: `wake` settles from asleep (0, breathing) to awake (1), and
+// on a live call here `level`, `pitch` and `tone` follow your voice, by `reaction`.
+export function useOrbLife(
+  call: Call,
+  { reducedMotion, reaction }: { reducedMotion: boolean; reaction: number },
+) {
+  const wake = useSharedValue(0);
+  const breath = useSharedValue(0);
+  const level = useSharedValue(0);
+  const input = useSharedValue(0);
+  const awake = wakeOf(call);
+  const reacting =
+    call.kind === 'here' &&
+    call.phase === 'live' &&
+    !call.mic.muted &&
+    !reducedMotion &&
+    reaction > 0;
+  const { pitch, tone } = useVoiceTone(reacting);
+
+  useEffect(() => {
+    if (reducedMotion) {
+      wake.set(awake);
+      breath.set(0);
+      return;
+    }
+    wake.set(
+      awake === 1
+        ? withSpring(1, motion.wake)
+        : withTiming(awake, {
+            duration: awake === 0 ? motion.settle.asleep : motion.settle.connecting,
+            easing: motion.settle.easing,
+          }),
+    );
+    breath.set(
+      awake === 0
+        ? withRepeat(withTiming(1, motion.breath), -1, true)
+        : withTiming(0, { duration: motion.breath.out }),
+    );
+  }, [awake, reducedMotion, wake, breath]);
+
+  useLevels((levels) => input.set(levels.input));
+  useAnimatedReaction(
+    () => (reacting ? Math.max(0, input.get() - 0.06) / 0.94 : 0),
+    (loudness, before) => {
+      if (loudness !== before) level.set(withSpring(loudness, motion.reaction));
+    },
+    [reacting],
+  );
+
+  return { wake, breath, level, pitch, tone };
+}
