+        <Composer
+          key={thread.id}
+          field={field}
+          draft={`thread:${thread.id}`}
+          title={title}
+          working={running && !pending.some((sent) => !sent.failed)}
+          focus={focus}
+          foot={foot}
+          onSend={onSend}
+          onStop={onStop}
+          onTalk={onTalk}
+        />
+      ) : (
+        <Foot foot={foot}>
+          <Talk about={title} alone onPress={onTalk} />
+        </Foot>
+      )}
+    </Column>
+  );
+}
+
+// Send turns into Stop while the thread works and you've nothing typed, though not before what you
+// just sent reaches it, so a second tap on Send can't stop the turn you steered.
+function Composer({
+  field: input,
+  draft,
+  title,
+  working,
+  focus,
+  foot,
+  onSend,
+  onStop,
+  onTalk,
+}: {
+  field: RefObject<TextInputRef | null>;
+  draft: string;
+  title: string;
+  working: boolean;
+  focus: boolean;
+  foot: number;
+  onSend: (text: string) => void;
+  onStop: () => void;
+  onTalk: () => void;
+}) {
+  const { first, keep } = useDraft(draft);
+  const [text, setText] = useState(first);
+  const [typing, setTyping] = useState(false);
+  const typingHere = useContext(Typing);
+  useEffect(() => {
+    if (!focus) return;
+    const wait = setTimeout(() => input.current?.focus(), 350);
+    return () => clearTimeout(wait);
+  }, [focus]);
+  const words = text.trim();
+  const stops = working && !text;
+  const lit = stops || !!words;
+  const send = () => {
+    if (stops) return onStop();
+    if (!words) return;
+    onSend(words);
+    setText('');
+    keep('');
+    input.current?.clear();
+  };
+  return (
+    <Row
+      alignment="end"
+      spacing={space[2]}
+      modifiers={[
+        padding({
+          leading: space[4],
+          trailing: space[4],
+          top: space[2],
+          bottom: typing ? space[2] : Math.max(space[3.5], foot),
+        }),
+        frame({ maxWidth: Infinity }),
+      ]}
+    >
+      <Row
+        alignment="center"
+        spacing={0}
+        modifiers={[
+          padding({
+            leading: space[4.5],
+            trailing: space[4.5],
+            top: space[3.5],
+            bottom: space[3.5],
+          }),
+          frame({ minHeight: metrics.field }),
+          frame({ maxWidth: Infinity }),
+          background(theme.surface),
+          clipShape('roundedRectangle', radius.field),
+        ]}
+      >
+        <TextInput
+          ref={input}
+          multiline
+          defaultValue={first}
+          placeholder={`Message ${title}`}
+          placeholderTextColor={theme.tertiary}
+          cursorColor={theme.accent}
+          onChangeText={(now) => {
+            setText(now);
+            keep(now);
+          }}
+          onFocus={() => {
+            setTyping(true);
+            typingHere(true);
+          }}
+          onBlur={() => {
+            setTyping(false);
+            typingHere(false);
+          }}
+          textStyle={labelOf('body')}
+          testID="thread-input"
+          modifiers={[
+            foregroundStyle(theme.text),
+            frame({ maxWidth: Infinity, alignment: 'leading' }),
+          ]}
+        />
+      </Row>
+      <Row
+        alignment="center"
+        spacing={0}
+        onPress={send}
+        testID="thread-send"
+        modifiers={[
+          frame({ width: metrics.field, height: metrics.field }),
+          background(lit ? theme.prominent : theme.surface),
+          clipShape('circle'),
+          contentShape(shapes.circle()),
+          accessibilityLabel(stops ? 'Stop' : 'Send'),
+        ]}
+      >
+        <Icon
+          name={stops ? 'stop.fill' : 'arrow.up'}
+          size={stops ? 14 : 18}
+          color={lit ? theme.onProminent : theme.tertiary}
+        />
+      </Row>
+      {typing ? null : <Talk about={title} alone={false} onPress={onTalk} />}
+    </Row>
+  );
+}
+
+// A page's foot: its composer, or the field that opens one, and Talk it through.
+export function Foot({ foot, children }: { foot: number; children: ReactNode }) {
+  return (
+    <Row
+      alignment="center"
+      spacing={space[2]}
+      modifiers={[
+        padding({
+          leading: space[4],
+          trailing: space[4],
+          top: space[2],
+          bottom: Math.max(space[3.5], foot),
+        }),
+        frame({ maxWidth: Infinity }),
+      ]}
+    >
+      {children}
+    </Row>
+  );
+}
+
+// The composer's field as a way into the conversation, where its messages aren't on screen.
+export function WriteField({ title, onPress }: { title: string; onPress: () => void }) {
+  return (
+    <Row
+      alignment="center"
+      spacing={0}
+      onPress={onPress}
+      testID="thread-write"
+      modifiers={[
+        padding({ leading: space[4.5], trailing: space[4.5] }),
+        frame({ height: metrics.field }),
+        frame({ maxWidth: Infinity }),
+        background(theme.surface),
+        clipShape('roundedRectangle', radius.field),
+        contentShape(shapes.rectangle()),
+        accessibilityLabel(`Message ${title}`),
+      ]}
+    >
+      <Text tone="tertiary">{`Message ${title}`}</Text>
+      <Spacer flexible />
+    </Row>
+  );
+}
diff --git a/src/components/tasks/trace.tsx b/src/components/tasks/trace.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9c817eac7821387ae3052a754968f26e2949045b
--- /dev/null
+++ b/src/components/tasks/trace.tsx
@@ -0,0 +1,423 @@
+import { Column, Icon, Row, ScrollView, Spacer } from '@expo/ui';
+import { Background, Rectangle } from '@expo/ui/swift-ui';
+import {
+  accessibilityLabel,
+  contentShape,
+  foregroundStyle,
+  frame,
+  monospacedDigit,
+  padding,
+  scrollClipDisabled,
+  shapes,
+} from '@expo/ui/swift-ui/modifiers';
+import { useState, type ReactNode } from 'react';
+import type { SFSymbol } from 'sf-symbols-typescript';
+
+import { Header } from '@/components/tasks/bar';
+import { Mark } from '@/components/tasks/mark';
+import { Faded, SectionHead, Sections, Waiting } from '@/components/tasks/parts';
+import { useNow } from '@/hooks/use-now';
+import { PLACES, placeOf } from '@/live/inbox';
+import {
+  STATE_WORDS,
+  agentCounts,
+  agentMeta,
+  agentSteps,
+  agentsInOrder,
+  stepMark,
+  stepTimes,
+  taskTime,
+  type AgentTrail,
+  type StepKind,
+  type Task,
+  type TaskAgent,
+  type TaskStep,
+} from '@/live/tasks';
+import type { Answered } from '@/hooks/use-watch';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, space, type Tone } from '@/ui/tokens';
+
+// Each kind of step's icon, as shadcn's Trace marks what a line did.
+export const KIND: Record<StepKind, SFSymbol> = {
+  think: 'lightbulb',
+  say: 'text.bubble',
+  plan: 'list.bullet',
+  run: 'terminal',
+  read: 'doc.text',
+  edit: 'pencil',
+  search: 'magnifyingglass',
+  web: 'globe',
+  agent: 'arrow.triangle.branch',
+  tool: 'wrench.and.screwdriver',
+};
+const PLANNED = { done: 'done', running: 'working', pending: 'pending' } as const;
+const TEXT = metrics.list.inset - space[0.5] + metrics.list.mark + metrics.list.gap;
+// An open agent's rail runs from just under its mark to the middle of its last line.
+const RAIL_TOP = space[2] + metrics.list.line + space[0.5];
+const RAIL_FOOT = space[2] + metrics.list.line / 2;
+
+// Steps before hex has answered with the task: its bar and back, over the spinner.
+export function StepsLoading(answered: Answered) {
+  return (
+    <Column
+      alignment="center"
+      spacing={0}
+      modifiers={[frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' })]}
+    >
+      <Header title="Steps" subtitle=" " />
+      <Waiting {...answered} gone="These steps aren’t there any more." />
+    </Column>
+  );
+}
+
+export function Trace({ task, onOpen }: { task: Task; onOpen: (link: string) => void }) {
+  const working = task.state === 'working';
+  const done = task.plan.filter((item) => item.state === 'done').length;
+  const { shown, tries } = agentsInOrder(task.agents);
+  const place = PLACES[placeOf(task.app)];
+  return (
+    <Column
+      alignment="center"
+      spacing={0}
+      modifiers={[frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' })]}
+    >
+      <Header
+        title="Steps"
+        subtitle={`${task.place || task.name} · ${place} · ${working ? `working for ${taskTime(task)}` : STATE_WORDS[task.state]}`}
+      />
+      <Faded>
+        <ScrollView
+          showsIndicators={false}
+          modifiers={[
+            scrollClipDisabled(),
+            frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' }),
+          ]}
+        >
+          <Column alignment="start" spacing={0} modifiers={[padding({ bottom: space[10] })]}>
+            <Sections>
+              {task.plan.length ? (
+                <Column key="plan" alignment="start" spacing={0}>
+                  <SectionHead title="Plan" count={`${done} of ${task.plan.length}`} />
+                  {task.plan.map((item, i) => (
+                    <TraceLine
+                      key={`${i} ${item.text}`}
+                      lead={<Mark state={PLANNED[item.state]} />}
+                      text={item.text}
+                      tone={item.state === 'pending' ? 'secondary' : undefined}
+                    />
+                  ))}
+                </Column>
+              ) : null}
+              {shown.length ? (
+                <Column key="agents" alignment="start" spacing={0}>
+                  <SectionHead title="Agents" count={agentCounts(shown)} />
+                  {shown.map((agent) => (
+                    <Agent key={agent.id} agent={agent} onOpen={onOpen} />
+                  ))}
+                  {tries.length ? <Tries tries={tries} onOpen={onOpen} /> : null}
+                </Column>
+              ) : null}
+              <Column key="steps" alignment="start" spacing={0}>
+                <SectionHead title="Steps" count={task.steps.length ? 'newest first' : undefined} />
+                {task.steps.length ? (
+                  <Steps steps={task.steps} agents={task.agents} />
+                ) : (
+                  <Quiet text={working ? 'No steps yet' : 'Steps show while it works'} />
+                )}
+              </Column>
+            </Sections>
+          </Column>
+        </ScrollView>
+      </Faded>
+    </Column>
+  );
+}
+
+export function Steps({
+  steps,
+  agents = [],
+  indent = 0,
+  opens = true,
+}: {
+  steps: TaskStep[];
+  agents?: TaskAgent[];
+  indent?: number;
+  opens?: boolean;
+}) {
+  const [open, setOpen] = useState<string | null>(null);
+  const now = useNow(steps.some((step) => step.state === 'running'));
+  const times = stepTimes(steps, now);
+  return (
+    <Column alignment="start" spacing={0}>
+      {steps.map((step, i) => {
+        const key = step.id ?? `${step.at} ${step.text}`;
+        const words = step.kind === 'think' || step.kind === 'say';
+        const opened = open === key;
+        const mark = stepMark(step);
+        const agent = step.agent && agents.find((one) => one.id === step.agent);
+        return (
+          <TraceLine
+            key={key}
+            lead={
+              mark ? (
+                <Mark state={mark} />
+              ) : (
+                <Icon name={KIND[step.kind]} size={13} color={theme.secondary} />
+              )
+            }
+            text={step.text}
+            lines={opened ? 0 : words ? 3 : 1}
+            time={agent ? undefined : times[i]}
+            after={agent ? <Mark state={agent.state} /> : undefined}
+            indent={indent}
+            onPress={
+              opens && (words || step.detail || step.result)
+                ? () => setOpen(opened ? null : key)
+                : undefined
+            }
+          >
+            {opened && step.detail ? (
+              <Output lines={[step.detail]} wraps={4} tone="secondary" />
+            ) : null}
+            {opened && step.result ? (
+              <Output
+                lines={step.result.split('\n').slice(0, 6)}
+                wraps={1}
+                tone={step.state === 'failed' ? 'danger' : 'tertiary'}
+              />
+            ) : null}
+          </TraceLine>
+        );
+      })}
+    </Column>
+  );
+}
+
+function Output({ lines, wraps, tone }: { lines: string[]; wraps: number; tone: Tone }) {
+  return (
+    <Column alignment="start" spacing={0} modifiers={[padding({ top: space[1] })]}>
+      {lines.map((line, i) => (
+        <Text
+          key={i}
+          numberOfLines={wraps}
+          variant="snippet"
+          tone={tone}
+          modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+        >
+          {line}
+        </Text>
+      ))}
+    </Column>
+  );
+}
+
+function Agent({ agent, onOpen }: { agent: AgentTrail; onOpen: (link: string) => void }) {
+  const [open, setOpen] = useState(false);
+  const [whole, setWhole] = useState(false);
+  const working = agent.state === 'working';
+  const newest = working && !open ? (agent.line ?? agent.steps[0]?.text) : undefined;
+  const result = open && !working ? agent.result : undefined;
+  const steps = open ? agentSteps(agent) : [];
+  const meta = agentMeta(agent);
+  const link = open ? agent.link : undefined;
+  return (
+    <Background alignment="topLeading">
+      <Column alignment="start" spacing={0}>
+        <TraceLine
+          lead={<Mark state={agent.state} />}
+          text={agent.label}
+          tone={agent.state === 'stopped' ? 'secondary' : undefined}
+          time={meta}
+          onPress={() => setOpen(!open)}
+          label={`${agent.label}, ${meta || agent.state}${newest ? `: ${newest}` : ''}. ${open ? 'Hides' : 'Shows'} what it did`}
+        >
+          {newest ? <Under text={newest} /> : null}
+        </TraceLine>
+        {result ? (
+          <Row
+            alignment="start"
+            spacing={0}
+            onPress={() => setWhole(!whole)}
+            modifiers={[
+              padding({
+                leading: TEXT,
+                trailing: metrics.list.inset - space[0.5],
+                top: -space[2],
+                bottom: space[2],
+              }),
+              contentShape(shapes.rectangle()),
+            ]}
+          >
+            <Under
+              text={result}
+              lines={whole ? 0 : 3}
+              tone={agent.state === 'failed' ? 'danger' : 'secondary'}
+            />
+          </Row>
+        ) : null}
+        {steps.length ? (
+          <Steps steps={steps} indent={metrics.list.mark + metrics.list.gap} />
+        ) : null}
+        {link ? (
+          <TraceLine
+            lead={null}
+            text="Open in T3 Code ↗"
+            tone="secondary"
+            onPress={() => onOpen(link)}
+          />
+        ) : null}
+      </Column>
+      <Background.Content>
+        {result || steps.length || link ? (
+          <Rectangle
+            modifiers={[
+              frame({ width: 1 }),
+              foregroundStyle(theme.edge),
+              padding({
+                leading: metrics.list.inset - space[0.5] + metrics.list.mark / 2,
+                top: RAIL_TOP,
+                bottom: RAIL_FOOT,
+              }),
+            ]}
+          />
+        ) : null}
+      </Background.Content>
+    </Background>
+  );
+}
+
+function Tries({ tries, onOpen }: { tries: AgentTrail[]; onOpen: (link: string) => void }) {
+  const [open, setOpen] = useState(false);
+  const words = `${tries.length} earlier ${tries.length === 1 ? 'try' : 'tries'}, stopped`;
+  return (
+    <Column alignment="start" spacing={0}>
+      <TraceLine
+        lead={<Mark state="stopped" />}
+        text={words}
+        tone="tertiary"
+        chevron={open ? 'chevron.down' : 'chevron.right'}
+        onPress={() => setOpen(!open)}
+        label={`${words}. ${open ? 'Hides' : 'Shows'} them`}
+      />
+      {open ? tries.map((agent) => <Agent key={agent.id} agent={agent} onOpen={onOpen} />) : null}
+    </Column>
+  );
+}
+
+function Under({
+  text,
+  lines = 1,
+  tone = 'secondary',
+}: {
+  text: string;
+  lines?: number;
+  tone?: Tone;
+}) {
+  return (
+    <Text
+      numberOfLines={lines || undefined}
+      variant="subheadline"
+      tone={tone}
+      paragraph
+      modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+    >
+      {text}
+    </Text>
+  );
+}
+
+export function TraceLine({
+  lead,
+  text,
+  lines = 1,
+  time,
+  tone = 'text',
+  indent = 0,
+  after,
+  chevron,
+  onPress,
+  label,
+  children,
+}: {
+  lead: ReactNode;
+  text: string;
+  lines?: number;
+  time?: string;
+  tone?: Tone;
+  indent?: number;
+  after?: ReactNode;
+  chevron?: 'chevron.down' | 'chevron.right';
+  onPress?: () => void;
+  label?: string;
+  children?: ReactNode;
+}) {
+  return (
+    <Row
+      alignment="start"
+      spacing={metrics.list.gap}
+      onPress={onPress}
+      modifiers={[
+        padding({
+          leading: metrics.list.inset - space[0.5] + indent,
+          trailing: metrics.list.inset - space[0.5],
+          top: space[2],
+          bottom: space[2],
+        }),
+        frame({ maxWidth: Infinity, alignment: 'leading' }),
+        contentShape(shapes.rectangle()),
+        ...(label ? [accessibilityLabel(label)] : []),
+      ]}
+    >
+      <Row
+        alignment="center"
+        spacing={0}
+        modifiers={[frame({ width: metrics.list.mark, height: metrics.list.line })]}
+      >
+        {lead}
+      </Row>
+      <Column alignment="start" spacing={0} modifiers={[frame({ maxWidth: Infinity })]}>
+        <Text
+          numberOfLines={lines || undefined}
+          variant="subheadline"
+          tone={tone}
+          paragraph
+          modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+        >
+          {text}
+        </Text>
+        {children}
+      </Column>
+      {time ? (
+        <Text numberOfLines={1} variant="footnote" tone="tertiary" modifiers={[monospacedDigit()]}>
+          {time}
+        </Text>
+      ) : null}
+      {after ? (
+        <Row alignment="center" spacing={0} modifiers={[frame({ height: metrics.list.line })]}>
+          {after}
+        </Row>
+      ) : null}
+      {chevron ? (
+        <Row alignment="center" spacing={0} modifiers={[frame({ height: metrics.list.line })]}>
+          <Icon name={chevron} size={11} color={theme.tertiary} />
+        </Row>
+      ) : null}
+    </Row>
+  );
+}
+
+function Quiet({ text }: { text: string }) {
+  return (
+    <Row
+      alignment="center"
+      spacing={0}
+      modifiers={[padding({ leading: metrics.list.inset, top: space[1.5] })]}
+    >
+      <Text variant="subheadline" tone="tertiary">
+        {text}
+      </Text>
+      <Spacer flexible />
+    </Row>
+  );
+}
