+    pose: { regular: true, bar: 'right', fold: { ...upright, active: false } },
+  },
+  'Duo open, column leading': {
+    window: { width: 951, height: 669 },
+    insets: { ...column, right: 0, left: 84 },
+    pose: { regular: true, bar: 'left', fold: { ...upright, x: 539.5, active: false } },
+  },
+  'Duo partly open upright': {
+    window: { width: 951, height: 669 },
+    insets: column,
+    pose: { regular: true, bar: 'right', fold: { ...upright, active: true } },
+  },
+  'Duo open on its side': {
+    window: { width: 669, height: 951 },
+    insets: band,
+    pose: {
+      regular: true,
+      fold: { ...flat, active: false },
+      occlusions: [{ x: 535, y: 0, width: 134, height: 82 }],
+    },
+  },
+};
+
+const layoutOf = ({ window, insets, pose }: Fixture) => screenLayout(roomOf(pose, window, insets));
+
+test('on every screen, the call card rounds off by the one card corner whenever Calls is in, and meets Calls’ edge', () => {
+  for (const [name, screen] of Object.entries(screens)) {
+    const layout = layoutOf(screen);
+    const card = cardOf(layout, 1, 0, layout.tasks.width);
+    assert.equal(card.borderRadius, radius.card, name);
+    assert.equal(card.left, layout.content.x + layout.calls.width, `${name}: meets Calls' edge`);
+  }
+});
+
+test('on every screen, the call card rounds off against Tasks beside it, and Tasks over it leaves it whole', () => {
+  for (const [name, screen] of Object.entries(screens)) {
+    const layout = layoutOf(screen);
+    const card = cardOf(layout, 0, 1, layout.tasks.width);
+    assert.equal(card.borderRadius, layout.tasks.place === 'beside' ? radius.card : 0, name);
+  }
+});
+
+test('on every screen, a call card with nothing beside it fills the screen square', () => {
+  for (const [name, screen] of Object.entries(screens)) {
+    const layout = layoutOf(screen);
+    const card = cardOf(layout, 0, 0, layout.tasks.width);
+    assert.deepEqual(
+      { top: card.top, left: card.left, right: card.right, corner: card.borderRadius },
+      { top: 0, left: 0, right: 0, corner: 0 },
+      name,
+    );
+    assert.equal(card.stage.left, layout.content.x, `${name}: the stage sits on the content`);
+  }
+});
+
+test('what is on the call card stays put in the window unless the card slides aside to Calls’ edge', () => {
+  for (const [name, screen] of Object.entries(screens)) {
+    const layout = layoutOf(screen);
+    for (const drawer of [0.5, 1]) {
+      const card = cardOf(layout, drawer, 0, layout.tasks.width);
+      const slid = layout.calls.place === 'slide' ? drawer * layout.calls.width : 0;
+      assert.equal(card.left + card.stage.left, layout.content.x + slid, `${name} at ${drawer}`);
+      assert.equal(card.top + card.stage.top, 0, `${name} at ${drawer}`);
+      if (layout.calls.place === 'slide' && drawer === 1)
+        assert.equal(card.stage.left, 0, `${name}: the call's content peeks from Calls' edge`);
+    }
+  }
+});
+
+// The same rule in every window the app could be given, with or without a side column on either
+// side and with or without a fold: there is no screen or pose where Calls leaves the card square
+// or the card covers any of Calls.
+test('in any window, Calls in rounds the card at Calls’ edge, and nothing in leaves it square', () => {
+  const problems: string[] = [];
+  for (const width of [375, 440, 466, 669, 834, 951, 1194])
+    for (const height of [466, 669, 678, 834, 951, 1194])
+      for (const side of [undefined, 'left', 'right'] as const)
+        for (const folded of [false, true]) {
+          const across = width > height;
+          const fold = !folded
+            ? undefined
+            : across
+              ? { x: width / 2 - 20, y: 0, width: 40, height, active: false }
+              : { x: 0, y: height / 2 - 20, width, height: 40, active: false };
+          const layout = layoutOf({
+            window: { width, height },
+            insets: {
+              top: side ? 0 : 24,
+              bottom: 20,
+              left: side === 'left' ? 84 : 0,
+              right: side === 'right' ? 84 : 0,
+            },
+            pose: { regular: width >= 669, bar: side, fold },
+          });
+          const name = `${width}x${height} ${side ?? 'no'} column${folded ? ', folded' : ''}`;
+          const calls = cardOf(layout, 1, 0, layout.tasks.width);
+          if (calls.borderRadius !== radius.card) problems.push(`${name}: Calls in, square`);
+          if (calls.left !== layout.content.x + layout.calls.width)
+            problems.push(`${name}: card at ${calls.left}, Calls ends at ${layout.calls.width}`);
+          if (cardOf(layout, 0, 0, layout.tasks.width).borderRadius !== 0)
+            problems.push(`${name}: nothing in, rounded`);
+        }
+  assert.deepEqual(problems, []);
+});
+
+// barOf takes no pane, so Tasks opening or closing can't move the bar; this checks the one place
+// it keeps is clear of Tasks and holds every button.
+test('on every screen, the bar across the top keeps one place clear of Tasks beside it, and Calls only carries it', () => {
+  const least = 3 * metrics.tool + 2 * metrics.toolbar.row;
+  for (const [name, screen] of Object.entries(screens)) {
+    const layout = layoutOf(screen);
+    const { toolbar, calls, tasks } = layout;
+    if (toolbar.axis !== 'row') continue;
+    const window = screen.window.width;
+    for (const drawer of [0, 0.5, 1]) {
+      const { left, right } = barOf(layout, window, drawer);
+      const end = window - right;
+      const where = `${name}, Calls at ${drawer}`;
+      assert.ok(end - left >= least, `${where}: holds its buttons`);
+      if (calls.below !== undefined)
+        assert.deepEqual([left, end], [toolbar.x, toolbar.x + toolbar.width], `${where}: whole`);
+      if (drawer === 0) {
+        assert.ok(left >= 0 && end <= window, `${where}: inside the window`);
+        if (tasks.place === 'beside')
+          assert.ok(end <= window - tasks.width, `${where}: clear of Tasks`);
+      }
+    }
+    if (layout.inbox)
+      assert.ok(
+        toolbar.y + metrics.tool <= layout.inbox.top,
+        `${name}: the inbox starts under the bar`,
+      );
+  }
+});
diff --git a/tests/chat.test.ts b/tests/chat.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..38133bcbc3d426312e5cf5fbfc9edcb00883d019
--- /dev/null
+++ b/tests/chat.test.ts
@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { arrived, newKey, said } from '../src/live/chat';
+import { TaskId, type Chat } from '../src/live/tasks';
+
+const chat = (turns: Chat['turns'], waiting: Chat['waiting'] = [], total = turns.length): Chat => ({
+  version: 1,
+  sends: true,
+  total,
+  turns,
+  waiting,
+});
+
+test('what you sent shows until hex has it waiting under its key, or said after you sent it', () => {
+  const sent = { id: TaskId.parse('t'), key: 'app-abc12345', text: 'ship it', total: 2 };
+  const before = [
+    { from: 'me' as const, text: 'ship it' },
+    { from: 'hex' as const, text: 'Shipped.' },
+  ];
+  assert.equal(arrived(chat(before), sent), false);
+  assert.equal(
+    arrived(chat(before, [{ key: 'telegram:app-abc12345', text: 'ship it', at: '' }]), sent),
+    true,
+  );
+  assert.equal(arrived(chat([...before, { from: 'me', text: 'ship it' }]), sent), true);
+});
+
+test('a chat cut to its latest turns still finds what you said after you sent it', () => {
+  const sent = { id: TaskId.parse('t'), key: 'app-abc12345', text: 'and the docs', total: 150 };
+  const latest = Array.from({ length: 100 }, (_, i) => ({ from: 'hex' as const, text: `${i}` }));
+  assert.equal(arrived(chat(latest, [], 150), sent), false);
+  assert.equal(
+    arrived(chat([...latest.slice(1), { from: 'me', text: 'and the docs' }], [], 151), sent),
+    true,
+  );
+});
+
+test('app keys fit what hex takes', () => {
+  assert.match(newKey(), /^app-[\w-]{8,60}$/);
+});
+
+test('what you did in a thread reads as an event, and a voice message as your words', () => {
+  assert.deepEqual(said({ from: 'me', text: '(answered in the app) Ship it?: Yes' }), {
+    kind: 'event',
+    label: 'Answered in the app',
+    text: 'Ship it?: Yes',
+  });
+  assert.deepEqual(said({ from: 'me', text: '(vote: Go)' }), {
+    kind: 'event',
+    label: 'Vote: Go',
+    text: '',
+  });
+  assert.deepEqual(said({ from: 'me', text: '(voice message) call mom' }), {
+    kind: 'me',
+    text: 'call mom',
+  });
+  assert.deepEqual(said({ from: 'me', text: 'ship it (later)' }), {
+    kind: 'me',
+    text: 'ship it (later)',
+  });
+  assert.deepEqual(said({ from: 'hex', text: '(aside) done' }), {
+    kind: 'hex',
+    text: '(aside) done',
+  });
+});
diff --git a/tests/contract.test.ts b/tests/contract.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d0d7b6626ab4d9c41ff7cc94ae5a4d6c75ea094a
--- /dev/null
+++ b/tests/contract.test.ts
@@ -0,0 +1,110 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+
+import { AgentActivity } from '../src/live/agents';
+import { AskList, Check } from '../src/live/asks';
+import {
+  CallList,
+  CallRecord,
+  ENDINGS,
+  SOURCES,
+  callDetails,
+  callName,
+  timeline,
+} from '../src/live/calls';
+import { Chat, STATE_WORDS, TaskCounts, TaskList, TaskOrPage, stepMark } from '../src/live/tasks';
+
+// tests/fixtures holds real answers from hex's voice server, scrubbed (tests/fixtures/capture.mts).
+const real = (name: string): unknown =>
+  JSON.parse(readFileSync(new URL(`fixtures/${name}.json`, import.meta.url), 'utf8'));
+
+test('every answer hex gives today reads in this app', () => {
+  for (const [name, schema] of [
+    ['calls', CallList],
+    ['call', CallRecord],
+    ['tasks', TaskList],
+    ['tasks-summary', TaskCounts],
+    ['task', TaskOrPage],
+    ['page', TaskOrPage],
+    ['chat', Chat],
+    ['asks', AskList],
+    ['check', Check],
+    ['activity', AgentActivity],
+  ] as const) {
+    const answer = schema.safeParse(real(name));
+    assert.ok(answer.success, `${name}: ${answer.error?.message}`);
+  }
+});
+
+test('every call hex lists shows where it came from and how it ended', () => {
+  const { calls } = CallList.parse(real('calls'));
+  for (const call of calls) {
+    assert.ok(SOURCES[call.from].symbol, call.from);
+    if (call.end) assert.ok(ENDINGS[call.end].line, call.end);
+    assert.ok(callName(call) && callDetails(call));
+  }
+});
+
+test('a Discord call, as hex records one from its Discord voice channel, says so', () => {
+  const call = CallRecord.parse({ ...(real('call') as object), from: 'discord' });
+  assert.equal(SOURCES[call.from].started, 'You called from Discord');
+});
+
+test('a value hex adds later reads as the nearest one this app knows, and no list fails over it', () => {
+  const record = CallRecord.parse({
+    ...(real('call') as object),
+    from: 'zoom',
+    end: 'timeout',
+    moments: [{ at: 1, kind: 'joined', text: 'Someone joined' }],
+  });
+  assert.equal(SOURCES[record.from].symbol, 'phone');
+  assert.equal(record.end, undefined);
+  assert.equal(timeline(record).filter((moment) => moment.kind === 'mark').length, 0);
+
+  const [row] = TaskList.parse({
+    version: 1,
+    tasks: [{ ...(real('tasks') as { tasks: object[] }).tasks[0], state: 'paused' }],
+  }).tasks;
+  assert.equal(STATE_WORDS[row!.state], 'idle');
+
+  const task = TaskOrPage.parse({
+    ...(real('task') as object),
+    steps: [
+      { at: '2026-11-03T08:00:00.000Z', kind: 'browse', text: 'Opened a page', state: 'odd' },
+    ],
+  });
+  assert.ok(task.kind === 'task');
+  assert.equal(task.steps[0]!.kind, 'tool');
+  assert.equal(stepMark(task.steps[0]!), undefined);
+});
+
+test('a thread off the board reads as a page to read, and a task with a broken field never passes for one', () => {
+  const page = TaskOrPage.parse(real('page'));
+  assert.equal(page.kind, 'page');
+  assert.ok(!('steps' in page) && !('running' in page));
+  assert.equal(TaskOrPage.parse(real('task')).kind, 'task');
+  assert.equal(TaskOrPage.safeParse({ ...(real('task') as object), steps: 'none' }).success, false);
+});
+
+test('an ask answered on a call says what its answer reached, and the undo that took one back shows nothing', () => {
+  const [ask] = AskList.parse(real('asks')).asks;
+  const sent = { thread: 'telegram:-1001:2583', topic: 'voiceapp', settled: 1, missed: 0 };
+  const { asks } = AgentActivity.parse({
+    ...(real('activity') as object),
+    asks: [{ at: 1, ask, answer: 'Yes', sent }],
+  });
+  assert.deepEqual(asks?.[0]?.sent, sent);
+  const record = CallRecord.parse({
+    ...(real('call') as object),
+    moments: [
+      { at: 1, kind: 'answered', text: 'Yes', sent },
+      { at: 2, kind: 'undone', text: 'Yes' },
+    ],
+  });
+  assert.deepEqual(
+    record.moments?.map((moment) => moment.kind),
+    ['answered', 'undone'],
+  );
+  assert.equal(timeline(record).filter((moment) => moment.kind === 'mark').length, 0);
+});
