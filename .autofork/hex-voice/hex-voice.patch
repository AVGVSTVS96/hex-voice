+          backgroundColor: color,
+          experimental_backgroundImage: color ? undefined : ORIGINAL_OPAL,
+        }}
+      />
+    </Pressable>
+  );
+}
+
+function SkeletonSwatch({ size }: { size: number }) {
+  const inner = size - 10;
+  return (
