new file mode 100644
index 0000000000000000000000000000000000000000..6b4823c406992754d62a527d479649f10e4fb5fb
--- /dev/null
+++ b/src/components/tasks/last-check.tsx
@@ -0,0 +1,136 @@
+import { Column, Row, ScrollView } from '@expo/ui';
+import {
+  background,
+  clipShape,
+  frame,
+  padding,
+  scrollClipDisabled,
+} from '@expo/ui/swift-ui/modifiers';
+
+import { Header } from '@/components/tasks/bar';
+import { Mark } from '@/components/tasks/mark';
+import { Faded, SectionHead, Sections, Waiting } from '@/components/tasks/parts';
+import type { Check, CheckNote } from '@/live/asks';
+import { timeOfDay } from '@/live/calls';
+import type { Answered } from '@/hooks/use-watch';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, radius, space } from '@/ui/tokens';
+
+export function LastCheck({ check, ...answered }: Answered & { check?: Check }) {
+  return (
+    <Column
+      alignment="center"
+      spacing={0}
+      modifiers={[frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' })]}
+    >
+      <Header title="Last check" subtitle={check ? `${timeOfDay(check.at)} · ${check.why}` : ' '} />
+      <Faded>
+        <ScrollView
+          showsIndicators={false}
+          modifiers={[
+            scrollClipDisabled(),
+            frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' }),
+          ]}
+        >
+          {check ? (
+            <Column
+              alignment="start"
+              spacing={0}
+              modifiers={[padding({ top: space[5], bottom: space[10] })]}
+            >
+              <Sections>
+                <Read key="read" read={check.read} />
+                {check.fixed.length ? (
+                  <Column key="fixed" alignment="start" spacing={0}>
+                    <SectionHead title="Fixed on its own" count={check.fixed.length} />
+                    {check.fixed.map((note, i) => (
+                      <NoteRow key={i} note={note} fixed />
+                    ))}
+                  </Column>
+                ) : null}
+                {check.flagged.length ? (
+                  <Column key="flagged" alignment="start" spacing={0}>
+                    <SectionHead title="For you to look at" count={check.flagged.length} />
+                    {check.flagged.map((note, i) => (
+                      <NoteRow key={i} note={note} />
+                    ))}
+                  </Column>
+                ) : null}
+              </Sections>
+            </Column>
+          ) : (
+            <Waiting {...answered} gone="This check isn’t there any more." />
+          )}
+        </ScrollView>
+      </Faded>
+    </Column>
+  );
+}
+
+function Read({ read }: { read: Record<string, number> }) {
+  return (
+    <Row
+      alignment="start"
+      spacing={0}
+      modifiers={[
+        padding({ top: space[4], bottom: space[4], leading: space[2], trailing: space[2] }),
+        frame({ maxWidth: Infinity }),
+        background(theme.group),
+        clipShape('roundedRectangle', radius.group),
+        padding({ leading: metrics.list.inset, trailing: metrics.list.inset }),
+      ]}
+    >
+      {Object.entries(read).map(([what, count]) => (
+        <Column
+          key={what}
+          alignment="center"
+          spacing={space[0.5]}
+          modifiers={[frame({ maxWidth: Infinity })]}
+        >
+          <Text variant="stat">{String(count)}</Text>
+          <Text variant="footnote" tone="secondary">
+            {what}
+          </Text>
+        </Column>
+      ))}
+    </Row>
+  );
+}
+
+function NoteRow({ note, fixed = false }: { note: CheckNote; fixed?: boolean }) {
+  return (
+    <Row
+      alignment="start"
+      spacing={metrics.list.gap}
+      modifiers={[
+        padding({
+          leading: metrics.list.inset - space[0.5],
+          trailing: metrics.list.inset,
+          top: space[2.5],
+          bottom: space[2.5],
+        }),
+        frame({ maxWidth: Infinity, alignment: 'leading' }),
+      ]}
+    >
+      <Mark state={fixed ? 'done' : 'needs'} />
+      <Column
+        alignment="start"
+        spacing={space[0.75]}
+        modifiers={[frame({ maxWidth: Infinity, alignment: 'leading' })]}
+      >
+        <Text variant="subheadline" weight="medium" paragraph>
+          {note.title}
+        </Text>
+        <Text variant="subheadline" tone="secondary" paragraph>
+          {note.text}
+        </Text>
+        {note.did ? (
+          <Text variant="subheadline" weight="medium" tone="accent" paragraph>
+            {note.did}
+          </Text>
+        ) : null}
+      </Column>
+    </Row>
+  );
+}
diff --git a/src/components/tasks/list-head.tsx b/src/components/tasks/list-head.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4d526f7f242920aa4c278af9f89ae0dbb53845de
--- /dev/null
+++ b/src/components/tasks/list-head.tsx
@@ -0,0 +1,201 @@
+import { Column, Icon, Row, ScrollView, TextInput, type TextInputRef } from '@expo/ui';
+import { Capsule, Overlay, Rectangle } from '@expo/ui/swift-ui';
+import {
+  accessibilityAddTraits,
+  accessibilityLabel,
+  contentShape,
+  foregroundStyle,
+  frame,
+  monospacedDigit,
+  padding,
+  shapes,
+} from '@expo/ui/swift-ui/modifiers';
+import { useContext, type RefObject } from 'react';
+
+import { BackButton, BarButton, type Back } from '@/components/tasks/bar';
+import { Typing } from '@/components/tasks/pages';
+import { STAGES, type Stage } from '@/live/inbox';
+import { theme } from '@/theme';
+import { glass } from '@/ui/glass-button';
+import { Text } from '@/ui/text';
+import { labelOf, metrics, space } from '@/ui/tokens';
+
+export function SearchButton({ onPress }: { onPress: () => void }) {
+  return (
+    <BarButton shape="circle" label="Search" testID="tasks-search" onPress={onPress}>
+      <Icon name="magnifyingglass" size={metrics.symbol.bar} color={theme.text} />
+    </BarButton>
+  );
+}
+
+export function Tabs({
+  counts,
+  stage,
+  unknown,
+  onChange,
+  back,
+  onSearch,
+}: {
+  counts: Record<Stage, number>;
+  stage: Stage;
+  // Not loaded yet, or hex can't be reached: no count is better than a made-up 0.
+  unknown: boolean;
+  onChange: (stage: Stage) => void;
+  back?: Back;
+  onSearch?: () => void;
+}) {
+  return (
+    <Column
+      alignment="start"
+      spacing={0}
+      modifiers={[
+        frame({ maxWidth: Infinity }),
+        ...(onSearch ? [padding({ top: space[2.5] })] : []),
+      ]}
+    >
+      <Row alignment="center" spacing={0} modifiers={[frame({ maxWidth: Infinity })]}>
+        {back ? (
+          <Row
+            alignment="center"
+            spacing={0}
+            modifiers={[padding({ leading: metrics.list.inset - space[1], bottom: space[2] })]}
+          >
+            <BackButton back={back} />
+          </Row>
+        ) : null}
+        <ScrollView
+          direction="horizontal"
+          showsIndicators={false}
+          modifiers={[frame({ maxWidth: Infinity })]}
+        >
+          <Row
+            alignment="end"
+            spacing={space[5]}
+            modifiers={[padding({ leading: metrics.list.inset, trailing: metrics.list.inset })]}
+          >
+            {STAGES.map(({ key, title }) => {
+              const on = key === stage;
+              const count = counts[key];
+              const needs = !unknown && key === 'needs' && count > 0;
+              return (
+                <Overlay key={key} alignment="bottom">
+                  <Row
+                    alignment="center"
+                    spacing={metrics.tabs.gap}
+                    onPress={() => onChange(key)}
+                    modifiers={[
+                      padding({ bottom: metrics.tabs.underline }),
+                      contentShape(shapes.rectangle()),
+                      accessibilityLabel(unknown ? title : `${title}, ${count}`),
+                      ...(on ? [accessibilityAddTraits(['isSelected'])] : []),
+                    ]}
+                  >
+                    <Text
+                      numberOfLines={1}
+                      variant="subheadline"
+                      weight={on ? 'semibold' : 'medium'}
+                      tone={on ? 'text' : 'secondary'}
+                    >
+                      {title}
+                    </Text>
+                    <Text
+                      variant="subheadline"
+                      weight={on || needs ? 'semibold' : 'medium'}
+                      tone={needs ? 'accent' : on ? 'text' : 'tertiary'}
+                      modifiers={[monospacedDigit()]}
+                    >
+                      {unknown ? '–' : String(count)}
+                    </Text>
+                  </Row>
+                  {on ? (
+                    <Overlay.Content>
+                      <Capsule modifiers={[frame({ height: 2 }), foregroundStyle(theme.accent)]} />
+                    </Overlay.Content>
+                  ) : null}
+                </Overlay>
+              );
+            })}
+          </Row>
+        </ScrollView>
+        {onSearch ? (
+          <Row
+            alignment="center"
+            spacing={0}
+            modifiers={[padding({ trailing: metrics.list.inset - space[1], bottom: space[2] })]}
+          >
+            <SearchButton onPress={onSearch} />
+          </Row>
+        ) : null}
+      </Row>
+      <Rectangle
+        modifiers={[
+          frame({ height: 1 }),
+          frame({ maxWidth: Infinity }),
+          foregroundStyle(theme.edge),
+        ]}
+      />
+    </Column>
+  );
+}
+
+export function Search({
+  field,
+  query,
+  onChange,
+  onCancel,
+}: {
+  field: RefObject<TextInputRef | null>;
+  query: string;
+  onChange: (query: string) => void;
+  onCancel: () => void;
+}) {
+  const typing = useContext(Typing);
+  return (
+    <Row
+      alignment="center"
+      spacing={space[2.5]}
+      modifiers={[
+        padding({
+          leading: space[4],
+          trailing: metrics.list.inset - space[1],
+          top: space[4.5],
+          bottom: space[2.5],
+        }),
+        frame({ maxWidth: Infinity }),
+      ]}
+    >
+      <Row
+        alignment="center"
+        spacing={space[2]}
+        modifiers={[
+          padding({ leading: space[3.5], trailing: space[3.5] }),
+          frame({ height: metrics.bar.button }),
+          frame({ maxWidth: Infinity }),
+          glass('capsule'),
+        ]}
+      >
+        <Icon name="magnifyingglass" size={14} color={theme.secondary} />
+        <TextInput
+          ref={field}
+          autoFocus
+          testID="tasks-search-field"
+          onFocus={() => typing(true)}
+          onBlur={() => typing(false)}
+          defaultValue={query}
+          placeholder="Tasks, topics, asks"
+          placeholderTextColor={theme.tertiary}
+          cursorColor={theme.accent}
+          onChangeText={onChange}
+          textStyle={labelOf('callout')}
+          modifiers={[
+            foregroundStyle(theme.text),
+            frame({ maxWidth: Infinity, alignment: 'leading' }),
+          ]}
+        />
+      </Row>
+      <BarButton shape="circle" label="Cancel" testID="tasks-search-cancel" onPress={onCancel}>
+        <Icon name="xmark" size={metrics.symbol.bar} color={theme.text} />
+      </BarButton>
+    </Row>
+  );
+}
diff --git a/src/components/tasks/list.tsx b/src/components/tasks/list.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..610167af27386202a93b44b4caed17b33ad3d500
--- /dev/null
+++ b/src/components/tasks/list.tsx
@@ -0,0 +1,351 @@
+import { Column, Icon, Row, Spacer } from '@expo/ui';
+import { List } from '@expo/ui/swift-ui';
+import {
+  accessibilityLabel,
+  animation,
+  background,
+  clipShape,
+  contentShape,
+  frame,
+  listStyle,
+  padding,
+  scrollClipDisabled,
+  scrollContentBackground,
+  shapes,
+} from '@expo/ui/swift-ui/modifiers';
+import { useEffect, useMemo, useState } from 'react';
+
+import { PageBar, useChrome } from '@/components/tasks/bar';
+import { CheckRow, PicksRow, TopicHead } from '@/components/tasks/inbox';
+import { Search, SearchButton, Tabs } from '@/components/tasks/list-head';
+import { useField, type Pages, type Spot } from '@/components/tasks/pages';
+import {
+  Empty,
+  Faded,
+  Loading,
+  UNREACHED,
+  asks,
+  listRow,
+  type Feel,
+} from '@/components/tasks/parts';
+import { EntryRow, ProjectRow } from '@/components/tasks/rows';
+import type { TasksAt } from '@/components/tasks/tasks-view';
+import type { useAsks } from '@/hooks/use-asks';
+import type { Ask, AskOption } from '@/live/asks';
+import {
+  inboxEntries,
+  picksOf,
+  search,
+  stageCounts,
+  pageOf,
+  taskOf,
+  topicIn,
+  topicsOf,
+  tracksOf,
+  type Stage,
+  type Tile,
+  type PageId,
+} from '@/live/inbox';
+import type { TaskRow } from '@/live/tasks';
+import { motion, rowsKey } from '@/motion';
+import { theme } from '@/theme';
+import { Text } from '@/ui/text';
+import { metrics, space } from '@/ui/tokens';
+
+const TABS_WITH_BAR = 600;
+
+const EMPTY: Record<Stage, string> = {
+  needs: 'Nothing waits on you',
+  working: 'Nothing is working',
+  done: 'Nothing finished today',
+  quiet: 'Nothing is quiet',
+};
+
+export function ListPage({
+  open,
+  at,
+  pages,
+  spot,
+  paged,
+  tasks,
+  offline,
+  current,
+  yours,
+  feel,
+  onAnswer,
+  onUndo,
+  onOpenTile,
+  onGoThrough,
+}: {
+  open: boolean;
+  at: TasksAt;
+  pages: Pages;
+  spot: Spot;
+  paged: boolean;
+  tasks: TaskRow[] | undefined;
+  offline: boolean;
+  // hex has answered since this list showed what was kept on this device, and nothing failed since.
+  current: boolean;
+  yours: ReturnType<typeof useAsks>;
+  feel: Feel;
+  onAnswer: (ask: Ask, option: AskOption) => void;
+  onUndo: (ask: Ask) => void;
+  onOpenTile: (tile: Tile) => void;
+  onGoThrough: () => void;
+}) {
+  const { back } = useChrome();
+  const [stage, setStage] = useState<Stage>('needs');
+  const [query, setQuery] = useState<string | null>(null);
+  const entries = useMemo(
+    () => inboxEntries(tasks ?? [], yours.list, yours.shown),
+    [tasks, yours.list, yours.shown],
+  );
+  const counts = stageCounts(entries, yours.answered);
+  const loaded = !!(yours.list && tasks);
+  useEffect(() => {
+    if (open) setQuery(null);
+  }, [open, at]);
+  useEffect(() => {
+    if (open && loaded) setStage(at.stage ?? (counts.needs ? 'needs' : 'working'));
+  }, [open, loaded, at]);
+
+  const shown = useMemo(
+    () =>
+      query !== null ? search(entries, query) : entries.filter((entry) => entry.stage === stage),
+    [entries, stage, query],
+  );
+  const topics = useMemo(() => topicsOf(shown, entries), [shown, entries]);
+  const picks = picksOf(entries, yours.answered);
+  const beside = pages.shape !== 'one';
+  const searching = query !== null;
+  const first = searching ? shown.map(taskOf).find(Boolean) : topics[0] && pageOf(topics[0]);
+  useEffect(() => {
+    if (beside && open && !pages.task && first) pages.go({ to: 'beside', id: first });
+  }, [beside, open, pages.task, first]);
+  const selected = beside
+    ? ((
+        shown.find((entry) => entry.id === pages.row && taskOf(entry) === pages.task) ??
+        shown.find((entry) => taskOf(entry) === pages.task)
+      )?.id ?? null)
+    : null;
+  // The project open beside the list, by what its page shows.
+  const openTopic = beside
+    ? (entries.find((entry) => taskOf(entry) === pages.task)?.topic ?? topicIn(pages.task))
+    : undefined;
+  // Lanes end at now, as of the last time the list moved.
+  const [now, setNow] = useState(Date.now);
+  useEffect(() => setNow(Date.now()), [tasks]);
+
+  const searchField = useField();
+  const openPage = (id: PageId, row?: string) => {
+    feel.tick();
+    searchField.current?.blur();
+    pages.go({ to: 'topic', id, row });
+  };
+  const chooseStage = (next: Stage) => {
+    feel.tick();
+    setStage(next);
+    if (beside) pages.go({ to: 'beside', id: null });
+  };
+  const startSearch = () => {
+    feel.tick();
+    setQuery('');
+  };
+  const width = spot.width;
+  const actions = {
+    width,
+    selected,
+    answered: yours.answered,
+    onOpen: openPage,
+    onOpenTile,
+    onAnswer,
+    onUndo,
+    onDismiss: (ask: Ask) => {
+      feel.tap();
+      yours.dismiss(ask);
+    },
+    onAgain: (ask: Ask) => {
+      feel.tap();
+      yours.again(ask);
+    },
+    onAct: (id: string) => {
+      feel.tap();
+      void yours.act(id);
+    },
+    onRead: (id: string) => {
+      feel.tick();
+      void yours.read(id);
+    },
+  };
+  const unreachable = (offline || yours.offline) && !loaded;
+  const behind = loaded && !(current && yours.current);
+  // A page as wide as a landscape phone holds back, the stages and search in one row; a narrower
+  // one gives back, its title and search a bar of their own above the stages.
+  const compact = spot.width >= TABS_WITH_BAR;
+  const goThrough =
+    !searching && stage === 'needs' && yours.open.length > 0 ? (
+      <GoThrough
+        count={yours.open.length}
+        foot={spot.foot}
+        onPress={() => {
+          feel.tick();
+          onGoThrough();
+        }}
+      />
+    ) : null;
+  // The list ends above the pill, so no row ever shows cut beneath it.
+  return (
+    <Column
+      alignment="start"
+      spacing={0}
+      modifiers={[frame({ maxWidth: Infinity, maxHeight: Infinity, alignment: 'top' })]}
+    >
+      {searching ? (
+        <Search
+          field={searchField}
+          query={query}
+          onChange={setQuery}
+          onCancel={() => {
+            feel.tick();
+            setQuery(null);
+          }}
+        />
+      ) : (
+        <Column alignment="start" spacing={0} modifiers={[frame({ maxWidth: Infinity })]}>
+          {compact ? null : (
+            <PageBar title="Tasks" back={back} trailing={<SearchButton onPress={startSearch} />} />
+          )}
+          <Tabs
+            counts={counts}
+            stage={stage}
+            unknown={!loaded}
+            onChange={chooseStage}
+            back={compact ? back : undefined}
+            onSearch={compact ? startSearch : undefined}
+          />
+        </Column>
+      )}
+      <Faded>
+        <List
+          modifiers={[
+            listStyle('plain'),
+            scrollContentBackground('hidden'),
+            scrollClipDisabled(),
+            ...(paged ? [] : [background(theme.sheet)]),
+            frame({ maxWidth: Infinity, maxHeight: Infinity }),
+            animation(
+              motion.list,
+              rowsKey(shown.map((entry) => `${entry.id}:${yours.answered[entry.id] ?? ''}`)),
+            ),
+          ]}
+        >
+          {behind ? <Behind width={width} /> : null}
+          {!searching && stage === 'needs' && picks.length > 1 ? (
+            <PicksRow
+              picks={picks}
+              width={width}
+              onTake={() => {
+                feel.tap();
+                for (const { ask, option } of picks) yours.answer(ask, option);
+              }}
+            />
+          ) : null}
+          {topics.flatMap((topic) => {
+            if (!searching)
+              return [
+                <ProjectRow
+                  key={topic.name}
+                  topic={topic}
+                  stage={stage}
+                  tracks={tracksOf(topic.name, tasks ?? [])}
+                  now={now}
+                  width={width}
+                  selected={topic.name === openTopic}
+                  onOpen={() => openPage(pageOf(topic), topic.entries[0]?.id)}
+                />,
+              ];
+            const lead = topic.entries.map(taskOf).find(Boolean);
+            return [
+              <TopicHead
+                key={`${topic.name}:head`}
+                topic={topic}
+                width={width}
+                onPress={() => openPage(lead ?? pageOf(topic))}
+              />,
+              ...topic.entries.map((entry, i) => (
+                <EntryRow key={entry.id} entry={entry} first={i === 0} {...actions} />
+              )),
+            ];
+          })}
+          {!searching && stage === 'needs' && yours.list?.check ? (
+            <CheckRow
+              check={yours.list.check}
+              width={width}
+              onPress={() => {
+                feel.tick();
+                pages.go({ to: 'check' });
+              }}
+            />
+          ) : null}
+          {loaded && !topics.length ? (
+            <Empty text={query ? 'Nothing matches' : EMPTY[stage]} width={width} />
+          ) : null}
+          {unreachable ? (
+            <Empty text={UNREACHED} width={width} />
+          ) : !loaded ? (
+            <Loading width={width} />
+          ) : null}
+        </List>
+      </Faded>
+      {goThrough}
+    </Column>
+  );
+}
+
+// While hex is slow or out of reach, what's shown is what it last sent, and says so quietly.
+function Behind({ width }: { width: number }) {
+  return (
+    <Text
+      variant="footnote"
+      tone="tertiary"
+      modifiers={[
+        padding({ top: space[1.5], bottom: space[1.5] }),
+        frame({ maxWidth: Infinity }),
+        ...listRow(width, { top: false, bottom: false }),
+      ]}
+    >
+      Last from hex · waiting for an update
+    </Text>
+  );
+}
+
+function GoThrough({ count, foot, onPress }: { count: number; foot: number; onPress: () => void }) {
+  return (
+    <Row
+      alignment="center"
+      spacing={metrics.pill.gap}
+      onPress={onPress}
+      modifiers={[
+        frame({ height: metrics.pill.height }),
+        frame({ maxWidth: Infinity }),
+        background(theme.prominent),
+        clipShape('capsule'),
+        contentShape(shapes.capsule()),
+        padding({
+          leading: space[4],
+          trailing: space[4],
+          top: space[3],
+          bottom: Math.max(space[4], foot),
+        }),
+        accessibilityLabel(`Go through ${asks(count)} with hex, on a call`),
+      ]}
+    >
+      <Spacer flexible />
+      <Icon name="waveform" size={16} color={theme.onProminent} />
+      <Text variant="headline" tone="onProminent">
+        {`Go through ${asks(count)} with hex`}
+      </Text>
+      <Spacer flexible />
+    </Row>
+  );
+}
