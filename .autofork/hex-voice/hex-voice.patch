diff --git a/plugins/with-activity-orbs.js b/plugins/with-activity-orbs.js
new file mode 100644
index 0000000000000000000000000000000000000000..5f51988957f9c78ae7744d405a35e402d0a845a8
--- /dev/null
+++ b/plugins/with-activity-orbs.js
@@ -0,0 +1,41 @@
+// expo-widgets builds the Live Activity extension without resources, so this adds the orb
+// stills (made by `npm run activity-orbs`) to it as an asset catalog the extension compiles.
+const fs = require('fs');
+const path = require('path');
+const { withDangerousMod, withXcodeProject } = require('expo/config-plugins');
+
+const TARGET = 'ExpoWidgetsTarget';
+const CATALOG = 'Orbs.xcassets';
+
+module.exports = function withActivityOrbs(config) {
+  config = withDangerousMod(config, [
+    'ios',
+    (config) => {
+      const target = path.join(config.modRequest.platformProjectRoot, TARGET, CATALOG);
+      fs.rmSync(target, { recursive: true, force: true });
+      fs.cpSync(path.join(config.modRequest.projectRoot, 'assets/live-activity', CATALOG), target, {
+        recursive: true,
+      });
+      return config;
+    },
+  ]);
+  return withXcodeProject(config, (config) => {
+    const project = config.modResults;
+    const target = project.findTargetKey(TARGET);
+    const group = project.findPBXGroupKey({ name: TARGET });
+    if (!target || !group)
+      throw new Error(`with-activity-orbs: no ${TARGET} target to add orbs to`);
+    if (project.hasFile(CATALOG)) return config;
+    const phase = project
+      .pbxNativeTargetSection()
+      [target].buildPhases.find(({ comment }) => comment === 'Resources');
+    const resources = phase
+      ? project.hash.project.objects.PBXResourcesBuildPhase[phase.value]
+      : project.addBuildPhase([], 'PBXResourcesBuildPhase', 'Resources', target).buildPhase;
+    const file = project.addFile(CATALOG, group, { lastKnownFileType: 'folder.assetcatalog' });
+    Object.assign(file, { uuid: project.generateUuid(), target });
+    project.addToPbxBuildFileSection(file);
+    resources.files.push({ value: file.uuid, comment: `${CATALOG} in Resources` });
+    return config;
+  });
+};
diff --git a/plugins/with-call-audio.js b/plugins/with-call-audio.js
new file mode 100644
index 0000000000000000000000000000000000000000..8c4071009e5644aa83f2dad763d7cde2c9843dcd
--- /dev/null
+++ b/plugins/with-call-audio.js
@@ -0,0 +1,27 @@
+// WebRTC applies its own audio session configuration every time a call's audio starts,
+// so the call's session is set here, before React Native loads. Mixing with others lets
+// music from another app keep playing during a call instead of interrupting it.
+const { withAppDelegate } = require('expo/config-plugins');
+
+const LAUNCH =
+  '    return super.application(application, didFinishLaunchingWithOptions: launchOptions)';
+
+const CALL_AUDIO = `    let callAudio = RTCAudioSessionConfiguration.webRTC()
+    callAudio.mode = AVAudioSession.Mode.videoChat.rawValue
+    callAudio.categoryOptions = [.mixWithOthers, .defaultToSpeaker, .allowBluetoothHFP]
+    RTCAudioSessionConfiguration.setWebRTC(callAudio)
+
+`;
+
+module.exports = function withCallAudio(config) {
+  return withAppDelegate(config, (config) => {
+    let source = config.modResults.contents;
+    if (!source.includes('RTCAudioSessionConfiguration')) {
+      if (!source.includes(LAUNCH))
+        throw new Error('with-call-audio: unexpected AppDelegate.swift');
+      source = `import AVFoundation\nimport WebRTC\n${source}`.replace(LAUNCH, CALL_AUDIO + LAUNCH);
+    }
+    config.modResults.contents = source;
+    return config;
+  });
+};
diff --git a/plugins/with-rive-legacy.js b/plugins/with-rive-legacy.js
new file mode 100644
index 0000000000000000000000000000000000000000..14015a74004b0a3764177eff47dd7dc54228fa37
--- /dev/null
+++ b/plugins/with-rive-legacy.js
@@ -0,0 +1,12 @@
+// Rive 0.5's default iOS backend drops state machine inputs for data binding, and the persona
+// files only bind their color, so their states still run through inputs on the legacy backend.
+const { withPodfile } = require('expo/config-plugins');
+
+module.exports = function withRiveLegacy(config) {
+  return withPodfile(config, (config) => {
+    if (!config.modResults.contents.includes('$UseRiveLegacy')) {
+      config.modResults.contents = `$UseRiveLegacy = true\n${config.modResults.contents}`;
+    }
+    return config;
+  });
+};
diff --git a/plugins/without-push.js b/plugins/without-push.js
new file mode 100644
index 0000000000000000000000000000000000000000..42c7f1e994a98f8b501b48172c99a36e3d00f2ce
--- /dev/null
+++ b/plugins/without-push.js
@@ -0,0 +1,11 @@
+// expo-widgets always adds the push entitlement, even with enablePushNotifications off.
+// The app never uses push, and free Apple teams can't sign an app that has it.
+// It sits before expo-widgets in app.json because mods run in reverse plugin order.
+const { withEntitlementsPlist } = require('expo/config-plugins');
+
+module.exports = function withoutPush(config) {
+  return withEntitlementsPlist(config, (config) => {
+    delete config.modResults['aps-environment'];
+    return config;
+  });
+};
diff --git a/scripts/activity-orbs.mts b/scripts/activity-orbs.mts
new file mode 100644
index 0000000000000000000000000000000000000000..51178c37dd6f8a25742cdc016471cc21bac3dbd3
--- /dev/null
+++ b/scripts/activity-orbs.mts
@@ -0,0 +1,77 @@
+import { mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { dirname, join } from 'node:path';
+import { chromium } from 'playwright-core';
+
+import { ACTIVITY_ORBS, type ActivityOrb } from '../src/live/activity-orb';
+
+const ROOT = join(import.meta.dirname, '..');
+const OUT = join(ROOT, 'assets', 'live-activity', 'Orbs.xcassets');
+const RIVE = dirname(createRequire(import.meta.url).resolve('@rive-app/webgl2'));
+const CANVAS = 400;
+const SIZE = 144;
+// The idle orb at this moment matches the still the app shows before a call starts.
+const SETTLE_MS = 1000;
+
+const files: Record<string, [string, string]> = {
+  '/rive.js': [join(RIVE, 'rive.js'), 'text/javascript'],
+  '/rive.wasm': [join(RIVE, 'rive.wasm'), 'application/wasm'],
+  '/page.js': [join(import.meta.dirname, 'activity-orbs.page.js'), 'text/javascript'],
+};
+
+const page = `<body style="margin:0;background:transparent">
+<canvas id="orb" width="${CANVAS}" height="${CANVAS}"></canvas><script src="/rive.js"></script><script src="/page.js"></script>`;
+
+async function render(
+  browser: import('playwright-core').Browser,
+  orb: ActivityOrb,
+  color = orb.color,
+) {
+  const tab = await browser.newPage({ viewport: { width: CANVAS, height: CANVAS } });
+  await tab.route('http://orbs.local/**', (route) => {
+    const path = new URL(route.request().url()).pathname;
+    if (path === '/') return route.fulfill({ contentType: 'text/html', body: page });
+    if (path === '/orb.riv')
+      return route.fulfill({
+        body: readFileSync(join(ROOT, 'src/components/persona/assets', `${orb.variant}.riv`)),
+      });
+    const [file, contentType] = files[path];
+    return route.fulfill({ contentType, body: readFileSync(file) });
+  });
+  await tab.goto('http://orbs.local/');
+  await tab.evaluate((orb) => (window as any).loadOrb(orb), { color, palette: orb.palette });
+  await tab.waitForTimeout(SETTLE_MS);
+  const shot = await tab.locator('#orb').screenshot({ omitBackground: true });
+  const png: string = await tab.evaluate((args) => (window as any).cropOrb(args), {
+    shot: shot.toString('base64'),
+    size: SIZE,
+  });
+  await tab.close();
+  return Buffer.from(png, 'base64');
+}
+
+const info = { author: 'xcode', version: 1 };
+rmSync(OUT, { recursive: true, force: true });
+mkdirSync(OUT, { recursive: true });
+writeFileSync(join(OUT, 'Contents.json'), JSON.stringify({ info }, null, 2) + '\n');
+
+const browser = await chromium.launch({
+  args: ['--use-angle=swiftshader', '--ignore-gpu-blocklist'],
+});
+for (const orb of ACTIVITY_ORBS) {
+  const set = join(OUT, `${orb.name}.imageset`);
+  mkdirSync(set);
+  const images: object[] = [{ filename: 'orb.png', idiom: 'universal' }];
+  writeFileSync(join(set, 'orb.png'), await render(browser, orb));
+  if (orb.light) {
+    writeFileSync(join(set, 'orb-light.png'), await render(browser, orb, orb.light));
+    images.push({
+      filename: 'orb-light.png',
+      idiom: 'universal',
+      appearances: [{ appearance: 'luminosity', value: 'light' }],
+    });
+  }
+  writeFileSync(join(set, 'Contents.json'), JSON.stringify({ images, info }, null, 2) + '\n');
+  console.log(orb.name);
+}
+await browser.close();
diff --git a/scripts/activity-orbs.page.js b/scripts/activity-orbs.page.js
new file mode 100644
index 0000000000000000000000000000000000000000..ec3b5e2b53ff2f92c62c62893e72364f4530a441
--- /dev/null
+++ b/scripts/activity-orbs.page.js
@@ -0,0 +1,69 @@
+// Runs in the browser page that scripts/activity-orbs.mts drives.
+window.loadOrb = ({ color, palette }) =>
+  new Promise((resolve, reject) => {
+    const { Rive, RuntimeLoader, Layout, Fit } = window.rive;
+    RuntimeLoader.setWasmUrl('/rive.wasm');
+    const rive = new Rive({
+      src: '/orb.riv',
+      canvas: document.getElementById('orb'),
+      stateMachines: 'default',
+      autoplay: true,
+      autoBind: false,
+      layout: new Layout({ fit: Fit.Contain }),
+      onLoadError: reject,
+      onLoad: () => {
+        rive.resizeDrawingSurfaceToCanvas();
+        const model = rive.defaultViewModel()?.defaultInstance();
+        if (model) {
+          rive.bindViewModelInstance(model);
+          // The first advance writes the file's own color back, as in the native renderer.
+          const tint = model.color('color');
+          const rgb = color && [1, 3, 5].map((at) => parseInt(color.slice(at, at + 2), 16));
+          if (tint && rgb) setInterval(() => tint.argb(255, ...rgb), 16);
+        }
+        for (const input of rive.stateMachineInputs('default')) {
+          if (['listening', 'thinking', 'speaking', 'asleep'].includes(input.name))
+            input.value = false;
+          if (input.name === 'color' && palette) input.value = palette;
+        }
+        resolve();
+      },
+    });
+  });
+
+window.cropOrb = async ({ shot, size }) => {
+  const image = new Image();
+  image.src = `data:image/png;base64,${shot}`;
+  await image.decode();
+  const read = new OffscreenCanvas(image.width, image.height).getContext('2d');
+  read.drawImage(image, 0, 0);
+  const { data, width, height } = read.getImageData(0, 0, image.width, image.height);
+  let [left, top, right, bottom] = [width, height, 0, 0];
+  for (let y = 0; y < height; y++)
+    for (let x = 0; x < width; x++)
+      if (data[(y * width + x) * 4 + 3] > 8) {
+        left = Math.min(left, x);
+        right = Math.max(right, x);
+        top = Math.min(top, y);
+        bottom = Math.max(bottom, y);
+      }
+  const side = Math.max(right - left, bottom - top) + 2;
+  const out = new OffscreenCanvas(size, size);
+  out
+    .getContext('2d')
+    .drawImage(
+      image,
+      (left + right - side) / 2,
+      (top + bottom - side) / 2,
+      side,
+      side,
+      0,
+      0,
+      size,
+      size,
+    );
+  const bytes = new Uint8Array(
+    await (await out.convertToBlob({ type: 'image/png' })).arrayBuffer(),
+  );
+  return btoa(String.fromCharCode(...bytes));
+};
diff --git a/scripts/devicehub.c b/scripts/devicehub.c
new file mode 100644
index 0000000000000000000000000000000000000000..3e2fd6576e5c7d13c4451d9b9f38aa0f256ff9d5
--- /dev/null
+++ b/scripts/devicehub.c
@@ -0,0 +1,75 @@
+// Posts the private HID events Xcode's Device Hub sends to a simulator: the iPhone Duo's hinge (0 shut, 180 flat) and
+// the device's orientation, which turns the Duo's screens where an app's own rotation request doesn't. Runs inside the
+// simulator (`xcrun simctl spawn`); `scripts/duo` builds it. Undocumented, so a new Xcode may change it.
+//
+// Adapted from https://github.com/artemnovichkov/hinge (via Maestro #3621 and ace #1427).
