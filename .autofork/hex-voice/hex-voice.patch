diff --git a/modules/voice-tone/ios/VoiceToneModule.swift b/modules/voice-tone/ios/VoiceToneModule.swift
new file mode 100644
index 0000000000000000000000000000000000000000..95e6602889ffb0e1541ed3cb53c7ef2203a274fb
--- /dev/null
+++ b/modules/voice-tone/ios/VoiceToneModule.swift
@@ -0,0 +1,62 @@
+import AVFoundation
+import ExpoModulesCore
+
+public final class VoiceToneModule: Module {
+  private static let tick = 1.0 / 30
+  private static let window = 0.048
+
+  private let queue = DispatchQueue(label: "hex.voice-tone", qos: .userInteractive)
+  private var timer: DispatchSourceTimer?
+  private var routes: NSObjectProtocol?
+  private var state = VoiceTone()
+  private var samples = [Float](repeating: 0, count: 4096)
+  private var rate = Float(48000)
+  private var sent = (pitch: Float(0), tone: Float(0))
+
+  public func definition() -> ModuleDefinition {
+    Name("VoiceTone")
+    Events("onTone")
+    Function("start") { self.queue.async(execute: self.begin) }
+    Function("stop") { self.queue.async(execute: self.end) }
+    OnDestroy { self.queue.sync(execute: self.end) }
+  }
+
+  private func begin() {
+    guard timer == nil, voice_tap_install() else { return }
+    voice_tone_reset(&state)
+    sent = (0, 0)
+    rate = Float(AVAudioSession.sharedInstance().sampleRate)
+    routes = NotificationCenter.default.addObserver(
+      forName: AVAudioSession.routeChangeNotification, object: nil, queue: nil
+    ) { [weak self] _ in
+      let rate = Float(AVAudioSession.sharedInstance().sampleRate)
+      self?.queue.async { self?.rate = rate }
+    }
+    voice_tap_enable(true)
+    let timer = DispatchSource.makeTimerSource(queue: queue)
+    timer.schedule(deadline: .now(), repeating: Self.tick, leeway: .milliseconds(4))
+    timer.setEventHandler { [weak self] in self?.listen() }
+    timer.resume()
+    self.timer = timer
+  }
+
+  private func end() {
+    guard let timer else { return }
+    timer.cancel()
+    self.timer = nil
+    voice_tap_enable(false)
+    if let routes { NotificationCenter.default.removeObserver(routes) }
+    routes = nil
+  }
+
+  private func listen() {
+    let wanted = min(Int(rate * Float(Self.window)), samples.count)
+    let count = Int(voice_tap_read(&samples, Int32(wanted)))
+    voice_tone_step(&state, samples, Int32(count), rate, Float(Self.tick))
+    guard abs(state.pitch - sent.pitch) > 0.004 || abs(state.tone - sent.tone) > 0.004 else {
+      return
+    }
+    sent = (state.pitch, state.tone)
+    sendEvent("onTone", ["pitch": state.pitch, "tone": state.tone])
+  }
+}
diff --git a/modules/voice-tone/ios/tap.c b/modules/voice-tone/ios/tap.c
new file mode 100644
index 0000000000000000000000000000000000000000..c9bc463825e039ba477da6712f60574babf24d2c
--- /dev/null
+++ b/modules/voice-tone/ios/tap.c
@@ -0,0 +1,116 @@
+// WebRTC's iOS audio device renders the microphone from its voice-processing unit with
+// AudioUnitRender and has no public way to see those samples. Rebinding that one import inside
+// WebRTC.framework, the way https://github.com/facebook/fishhook does, lets us copy each
+// echo-cancelled buffer as WebRTC receives it, without touching the audio session, the unit or
+// the audio itself.
+#include "VoiceTone.h"
+
+#include <AudioToolbox/AudioToolbox.h>
+#include <mach-o/dyld.h>
+#include <mach-o/loader.h>
+#include <mach-o/nlist.h>
+#include <mach/mach.h>
+#include <stdatomic.h>
+#include <string.h>
+
+#define RING 8192
+#define MICROPHONE_BUS 1
+
+typedef OSStatus (*Render)(AudioUnit, AudioUnitRenderActionFlags *, const AudioTimeStamp *,
+                           UInt32, UInt32, AudioBufferList *);
+
+static Render render = AudioUnitRender;
+static float ring[RING];
+static _Atomic unsigned long written;
+static unsigned long consumed;
+static atomic_bool enabled;
+
+static OSStatus tapped_render(AudioUnit unit, AudioUnitRenderActionFlags *flags,
+                              const AudioTimeStamp *time, UInt32 bus, UInt32 frames,
+                              AudioBufferList *data) {
+  OSStatus status = render(unit, flags, time, bus, frames, data);
+  const AudioBuffer *buffer = &data->mBuffers[0];
+  if (status != noErr || bus != MICROPHONE_BUS ||
+      !atomic_load_explicit(&enabled, memory_order_relaxed) || data->mNumberBuffers < 1 ||
+      buffer->mNumberChannels != 1 || buffer->mDataByteSize != frames * sizeof(SInt16))
+    return status;
+  const SInt16 *samples = buffer->mData;
+  unsigned long head = atomic_load_explicit(&written, memory_order_relaxed);
+  for (UInt32 i = 0; i < frames; i++) ring[(head + i) % RING] = samples[i] / 32768.0f;
+  atomic_store_explicit(&written, head + frames, memory_order_release);
+  return status;
+}
+
+static bool rebind(const struct mach_header_64 *header, intptr_t slide) {
+  const struct segment_command_64 *linkedit = NULL;
+  const struct symtab_command *symtab = NULL;
+  const struct dysymtab_command *dysymtab = NULL;
+  const struct load_command *command = (const void *)(header + 1);
+  for (uint32_t i = 0; i < header->ncmds; i++) {
+    if (command->cmd == LC_SEGMENT_64 &&
+        !strcmp(((const struct segment_command_64 *)command)->segname, SEG_LINKEDIT))
+      linkedit = (const void *)command;
+    if (command->cmd == LC_SYMTAB) symtab = (const void *)command;
+    if (command->cmd == LC_DYSYMTAB) dysymtab = (const void *)command;
+    command = (const void *)((const char *)command + command->cmdsize);
+  }
+  if (!linkedit || !symtab || !dysymtab) return false;
+
+  uintptr_t base = slide + linkedit->vmaddr - linkedit->fileoff;
+  const struct nlist_64 *symbols = (const void *)(base + symtab->symoff);
+  const char *names = (const char *)(base + symtab->stroff);
+  const uint32_t *indirect = (const void *)(base + dysymtab->indirectsymoff);
+
+  bool bound = false;
+  command = (const void *)(header + 1);
+  for (uint32_t i = 0; i < header->ncmds; i++) {
+    const struct segment_command_64 *segment = (const void *)command;
+    command = (const void *)((const char *)command + command->cmdsize);
+    if (segment->cmd != LC_SEGMENT_64 || (strcmp(segment->segname, SEG_DATA) &&
+                                          strcmp(segment->segname, "__DATA_CONST")))
+      continue;
+    const struct section_64 *section = (const void *)(segment + 1);
+    for (uint32_t j = 0; j < segment->nsects; j++, section++) {
+      uint32_t type = section->flags & SECTION_TYPE;
+      if (type != S_LAZY_SYMBOL_POINTERS && type != S_NON_LAZY_SYMBOL_POINTERS) continue;
+      void **slots = (void **)(slide + section->addr);
+      for (uint64_t k = 0; k < section->size / sizeof(void *); k++) {
+        uint32_t symbol = indirect[section->reserved1 + k];
+        if (symbol & (INDIRECT_SYMBOL_ABS | INDIRECT_SYMBOL_LOCAL)) continue;
+        if (strcmp(names + symbols[symbol].n_un.n_strx, "_AudioUnitRender")) continue;
+        vm_protect(mach_task_self(), (vm_address_t)&slots[k], sizeof(void *), false,
+                   VM_PROT_READ | VM_PROT_WRITE);
+        slots[k] = (void *)tapped_render;
+        bound = true;
+      }
+    }
+  }
+  return bound;
+}
+
+bool voice_tap_install(void) {
+  static bool installed;
+  if (installed) return true;
+  for (uint32_t i = 0; i < _dyld_image_count(); i++) {
+    const char *name = _dyld_get_image_name(i);
+    if (name && strstr(name, "/WebRTC.framework/WebRTC"))
+      installed = rebind((const struct mach_header_64 *)_dyld_get_image_header(i),
+                         _dyld_get_image_vmaddr_slide(i));
+  }
+  return installed;
+}
+
+void voice_tap_enable(bool on) {
+  consumed = atomic_load_explicit(&written, memory_order_acquire);
+  atomic_store_explicit(&enabled, on, memory_order_relaxed);
+}
+
+int voice_tap_read(float *out, int count) {
+  unsigned long head = atomic_load_explicit(&written, memory_order_acquire);
+  if (head == consumed) return 0;
+  consumed = head;
+  if (count > RING / 2) count = RING / 2;
+  if ((unsigned long)count > head) count = (int)head;
+  for (int i = 0; i < count; i++) out[i] = ring[(head - count + i) % RING];
+  return count;
+}
diff --git a/modules/voice-tone/ios/tone.c b/modules/voice-tone/ios/tone.c
new file mode 100644
index 0000000000000000000000000000000000000000..26141b1f9f5ae504e8353f81749e1f5649e1f0a7
--- /dev/null
+++ b/modules/voice-tone/ios/tone.c
@@ -0,0 +1,126 @@
+#include "VoiceTone.h"
+
+#include <math.h>
+
+#define LOWEST_VOICE 60.0f
+#define HIGHEST_VOICE 500.0f
+#define ANALYSIS_RATE 12000.0f
+#define MAX_DECIMATED 1024
+#define MAX_LAG 256
+
+#define SEMITONES_FOR_FULL_LIFT 5.0f
+#define OCTAVES_FOR_FULL_TONE 0.7f
+#define OCTAVE_JUMP 0.75f
+
+static float clamp(float value) { return value < -1 ? -1 : value > 1 ? 1 : value; }
+
+static float approach(float value, float target, float dt, float seconds) {
+  return value + (target - value) * (1 - expf(-dt / seconds));
+}
+
+void voice_tone_reset(VoiceTone *state) { *state = (VoiceTone){.floor = -70}; }
+
+float voice_tone_f0(const float *samples, int count, float rate, float *clarity) {
+  *clarity = 0;
+  int step = rate > 16000 ? (int)lroundf(rate / ANALYSIS_RATE) : 1;
+  float fs = rate / step;
+  int n = count / step;
+  if (n > MAX_DECIMATED) n = MAX_DECIMATED;
+  float y[MAX_DECIMATED];
+  for (int i = 0; i < n; i++) {
+    float sum = 0;
+    for (int j = 0; j < step; j++) sum += samples[(count - n * step) + i * step + j];
+    y[i] = sum / step;
+  }
+
+  int shortest = (int)(fs / HIGHEST_VOICE);
+  int longest = (int)(fs / LOWEST_VOICE);
+  if (longest >= MAX_LAG) longest = MAX_LAG - 1;
+  int width = n - longest;
+  if (width < longest) return 0;
+
+  float cmnd[MAX_LAG] = {1};
+  float running = 0;
+  for (int lag = 1; lag <= longest; lag++) {
+    float d = 0;
+    for (int i = 0; i < width; i++) {
+      float delta = y[i] - y[i + lag];
+      d += delta * delta;
+    }
+    running += d;
+    cmnd[lag] = running > 0 ? d * lag / running : 1;
+  }
+
+  int best = 0;
+  for (int lag = shortest; lag <= longest; lag++) {
+    if (cmnd[lag] < 0.15f) {
+      while (lag < longest && cmnd[lag + 1] < cmnd[lag]) lag++;
+      best = lag;
+      break;
+    }
+    if (!best || cmnd[lag] < cmnd[best]) best = lag;
+  }
+  if (best <= shortest || best >= longest) return 0;
+
+  float a = cmnd[best - 1], b = cmnd[best], c = cmnd[best + 1];
+  float bend = a - 2 * b + c;
+  float shift = bend > 0 ? 0.5f * (a - c) / bend : 0;
+  *clarity = 1 - b;
+  return fs / (best + shift);
+}
+
+float voice_tone_brightness(const float *samples, int count, float rate) {
+  float energy = 0, change = 0;
+  for (int i = 1; i < count; i++) {
+    float delta = samples[i] - samples[i - 1];
+    energy += samples[i] * samples[i];
+    change += delta * delta;
+  }
+  if (energy <= 0) return 0;
+  float ratio = sqrtf(change / energy) / 2;
+  return rate / (float)M_PI * asinf(ratio > 1 ? 1 : ratio);
+}
+
+void voice_tone_step(VoiceTone *state, const float *samples, int count, float rate, float dt) {
+  float energy = 0;
+  for (int i = 0; i < count; i++) energy += samples[i] * samples[i];
+  float level = count ? 10 * log10f(energy / count + 1e-12f) : -120;
+  if (count) state->floor = level < state->floor ? level : state->floor + 1.5f * dt;
+
+  float clarity = 0;
+  float f0 = level > -55 && level > state->floor + 10
+                 ? voice_tone_f0(samples, count, rate, &clarity)
+                 : 0;
+  bool voiced = f0 > 0 && clarity > 0.75f;
+  float pitch = voiced ? log2f(f0) : 0;
+  if (voiced && state->voicedTime > 0.3f && fabsf(pitch - state->pitchBase) > OCTAVE_JUMP) {
+    state->stray += dt;
+    if (state->stray < 0.6f) voiced = false;
+    else state->voicedTime = 0;
+  }
+  float bright = voiced ? voice_tone_brightness(samples, count, rate) : 0;
+  float tone = bright > 0 ? log2f(bright) : 0;
+
+  if (!voiced || bright <= 0) {
+    state->silence += dt;
+    if (state->silence > 0.15f) {
+      state->pitch = approach(state->pitch, 0, dt, 0.3f);
+      state->tone = approach(state->tone, 0, dt, 0.4f);
+      if (fabsf(state->pitch) < 0.01f) state->pitch = 0;
+      if (fabsf(state->tone) < 0.01f) state->tone = 0;
+    }
+    return;
+  }
+
+  state->silence = 0;
+  state->stray = 0;
+  state->voicedTime += dt;
+  float pitchWeight = dt / fminf(state->voicedTime, 4);
+  float toneWeight = dt / fminf(state->voicedTime, 8);
+  state->pitchBase += (pitch - state->pitchBase) * pitchWeight;
+  state->toneBase += (tone - state->toneBase) * toneWeight;
+  float lift = (pitch - state->pitchBase) * 12 / SEMITONES_FOR_FULL_LIFT;
+  float shape = (tone - state->toneBase) / OCTAVES_FOR_FULL_TONE;
+  state->pitch = approach(state->pitch, clamp(lift), dt, 0.12f);
+  state->tone = approach(state->tone, clamp(shape), dt, 0.45f);
+}
