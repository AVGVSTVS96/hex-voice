index 0000000000000000000000000000000000000000..62a4faf38a0627b9ef5b9ac58750ed5735614ff5
--- /dev/null
+++ b/src/hooks/use-app-updates.ts
@@ -0,0 +1,34 @@
+import * as Updates from 'expo-updates';
+import { useEffect, useEffectEvent } from 'react';
+import { AppState } from 'react-native';
+
+// New JS arrives over the air (scripts/ship-js). The app looks for it each time it comes to the
+// front and downloads it in the background. It restarts into it only as you come back to the app
+// from elsewhere with no call live, never while you're in it, so a restart can't take the page
+// you're on from under you. Coming back from Control Center or a banner isn't coming back.
+export function useAppUpdates(callLive: boolean) {
+  const { isUpdatePending } = Updates.useUpdates();
+
+  const apply = useEffectEvent(() => {
+    if (isUpdatePending && !callLive) void Updates.reloadAsync();
+  });
+
+  useEffect(() => {
+    if (!Updates.isEnabled) return;
+    let last = AppState.currentState;
+    const listener = AppState.addEventListener('change', (state) => {
+      const back = last === 'background' && state === 'active';
+      last = state;
+      if (state !== 'active') return;
+      if (back) apply();
+      void download();
+    });
+    return () => listener.remove();
+  }, []);
+}
+
+async function download() {
+  try {
+    if ((await Updates.checkForUpdateAsync()).isAvailable) await Updates.fetchUpdateAsync();
+  } catch {}
+}
diff --git a/src/hooks/use-asks.ts b/src/hooks/use-asks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1fa2bda32264ad7900c51d17c0adc47ef1ad2403
--- /dev/null
+++ b/src/hooks/use-asks.ts
@@ -0,0 +1,132 @@
+import { useEffect, useMemo, useReducer, useRef, useState } from 'react';
+
+import { hex } from '@/hex';
+import { keepDraft, sentDraft } from '@/hooks/use-draft';
+import { useFailures } from '@/hooks/use-failures';
+import { useKept } from '@/hooks/use-kept';
+import { useAnswer, useWatch } from '@/hooks/use-watch';
+import {
+  AskList,
+  NOT_NEEDED,
+  failedOn,
+  openAsks,
+  yours,
+  type Ask,
+  type AskId,
+  type AskOption,
+  type Sent,
+} from '@/live/asks';
+
+// The one way to answer an ask, from Tasks or its card on a call: once hex has it, what you'd
+// started typing on it goes, and you get back what the answer reached.
+export async function answerAsk(ask: Ask, option: AskOption) {
+  const sent = await hex.asks.answer(ask.id, option.label);
+  keepDraft(`ask:${ask.id}`, '');
+  return sent;
+}
+
+// Your own words to the ask's thread. The ask stays open everywhere, so here only what you wrote
+// goes.
+export async function noteAsk(ask: Ask, text: string) {
+  await hex.asks.note(ask.id, text);
+  sentDraft(`ask:${ask.id}`, text);
+}
+
+// On a call, the voice starts going through your asks with you.
+export const raiseAsks = () => hex.asks.talk();
+
+// Everything waiting on you, live while the sheet is open. An answer or a not needed folds its card
+// where it sits and goes to hex; the card stays folded there with Undo until the sheet closes.
+// Whatever hex couldn't take says why on the item it was about, an answer that didn't land opens
+// again, and one that missed a place stays folded, through the sheet closing, and says so until
+// it's sent again or undone.
+export function useAsks(open: boolean) {
+  const [state, dispatch] = useReducer(yours, { answered: {} });
+  const tries = useFailures();
+  const [missed, setMissed] = useState<Record<string, number>>({});
+  const reached = (id: AskId, sent?: Sent) =>
+    setMissed(({ [id]: _, ...rest }) => (sent?.missed ? { ...rest, [id]: sent.missed } : rest));
+  // hex takes one thing at a time per ask, so each answer, undo or send again here goes once the
+  // one before it is done, and only the latest you did may change how its card shows.
+  const queue = useRef(new Map<AskId, { last: Promise<unknown>; turn: number }>());
+  const inTurn = (id: AskId, work: (latest: () => boolean) => Promise<unknown>) => {
+    const now = queue.current.get(id) ?? { last: Promise.resolve(), turn: 0 };
+    const turn = now.turn + 1;
+    const latest = () => queue.current.get(id)?.turn === turn;
+    queue.current.set(id, { last: now.last.then(() => work(latest)), turn });
+  };
+  // What went out for each ask and hasn't been taken back, sent the same way by Send again.
+  const out = useRef(new Map<AskId, () => Promise<Sent>>());
+  const [kept, keep] = useKept('asks', AskList);
+  useEffect(() => {
+    if (kept && !state.list) dispatch({ type: 'list', list: kept });
+  }, [kept]);
+  const watching = useWatch(open ? 'asks' : null, hex.asks.list, (list) => {
+    keep(list);
+    dispatch({ type: 'list', list });
+  });
+  useEffect(() => {
+    if (open) return;
+    dispatch({ type: 'close', keep: Object.keys(missed) });
+    tries.clear();
+  }, [open]);
+  const list = useMemo(
+    () => state.list && failedOn(state.list, tries.failed, missed),
+    [state.list, tries.failed, missed],
+  );
+
+  const settle = (ask: Ask, label: string, what: string, send: () => Promise<Sent>) => {
+    dispatch({ type: 'answer', id: ask.id, label });
+    inTurn(ask.id, async (latest) => {
+      if (await tries.attempt(ask.id, what, async () => reached(ask.id, await send())))
+        out.current.set(ask.id, send);
+      else if (latest()) dispatch({ type: 'failed', id: ask.id });
+    });
+  };
+  const undo = (id: AskId) => {
+    const label = state.answered[id];
+    if (!label) return;
+    dispatch({ type: 'undo', id });
+    reached(id);
+    inTurn(id, async (latest) => {
+      if (!out.current.has(id)) return;
+      if (await tries.attempt(id, 'Not undone', () => hex.asks.undo(id))) out.current.delete(id);
+      else if (latest()) dispatch({ type: 'answer', id, label });
+    });
+  };
+  return {
+    list,
+    shown: list?.asks ?? [],
+    answered: state.answered,
+    open: openAsks(state),
+    offline: watching === 'offline',
+    current: watching === 'current',
+    answer: (ask: Ask, option: AskOption) =>
+      settle(ask, option.label, 'Not answered', () => answerAsk(ask, option)),
+    dismiss: (ask: Ask) => settle(ask, NOT_NEEDED, 'Not put away', () => hex.asks.dismiss(ask.id)),
+    // What went out stands, so sending it again only reaches the places it missed, and it stays
+    // folded whether or not they answer this time.
+    again: (ask: Ask) => {
+      const send = out.current.get(ask.id);
+      if (!send) return;
+      reached(ask.id);
+      inTurn(ask.id, () =>
+        tries.attempt(ask.id, 'Not sent again', async () => reached(ask.id, await send())),
+      );
+    },
+    undo,
+    act: (id: string) => tries.attempt(id, 'Not sent', () => hex.asks.act(id)),
+    read: (id: string) => tries.attempt(id, 'Not marked read', () => hex.asks.read(id)),
+  };
+}
+
+// The last check in full, fetched when its page opens and again whenever a new one lands.
+export function useCheck(at: string | undefined) {
+  const { answer, ...answered } = useAnswer(at ?? null, undefined, () => hex.asks.check());
+  return { check: answer, ...answered };
+}
+
+// An ask's thread's own words, asked for while its card is open. Where hex has none, there are none.
+export function useWords(id: AskId | null) {
+  return useAnswer(id, undefined, (open) => hex.asks.words(open)).answer;
+}
diff --git a/src/hooks/use-call-activity.ts b/src/hooks/use-call-activity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8a0beef6d6891ab2a1f3cf6d453bcd1031db30d3
--- /dev/null
+++ b/src/hooks/use-call-activity.ts
@@ -0,0 +1,84 @@
+import { addUserInteractionListener, after, type LiveActivity } from 'expo-widgets';
+import { useEffect, useEffectEvent, useRef } from 'react';
+
+import type { Call } from '@/call/call';
+import CallActivity, { type CallActivityProps } from '@/live/call-activity';
+import { ENDINGS, clock } from '@/live/calls';
+
+// An ended call stays on the lock screen with how it ended, long enough to glance at.
+const LINGER = 2 * 60_000;
+
+// A call on this phone shows on the Lock Screen and in the Dynamic Island while it connects and
+// lasts, with mute and End.
+export function useCallActivity(
+  call: Call,
+  orb: string,
+  { toggleMute, end }: { toggleMute: () => void; end: () => Promise<void> },
+) {
+  const activity = useRef<LiveActivity<CallActivityProps>>(null);
+  const since = useRef(0);
+  const state =
+    call.kind !== 'here'
+      ? undefined
+      : call.phase !== 'live'
+        ? call.phase
+        : call.mic.muted
+          ? 'muted'
+          : 'live';
+  const last = call.kind === 'none' ? call.last : undefined;
+
+  const onControl = useEffectEvent((target: string) => {
+    if (target === 'mute') toggleMute();
+    if (target === 'end') void end();
+  });
+
+  useEffect(() => {
+    // An activity can outlive the app process that started it, and its call ended with it.
+    for (const stale of CallActivity.getInstances()) void stale.end('immediate');
+    const controls = addUserInteractionListener(({ target }) => onControl(target));
+    return () => {
+      controls.remove();
+      void activity.current?.end('immediate');
+      activity.current = null;
+    };
+  }, []);
+
+  useEffect(() => {
+    if (state === 'ending') return;
+    if (!state) {
+      const current = activity.current;
+      activity.current = null;
+      if (current) {
+        const ending = last?.ending;
+        const outcome = ending && ENDINGS[ending];
+        const line = !outcome
+          ? 'Call ended'
+          : since.current && ending !== 'no-connect'
+            ? `${outcome.line} · ${clock((last?.seconds ?? 0) * 1000)}`
+            : outcome.line;
+        void current
+          .end(after(new Date(Date.now() + LINGER)), {
+            orb,
+            since: since.current,
+            state: 'ended',
+            outcome: line,
+            bad: outcome?.bad,
+          })
+          .catch(() => {});
+      }
+      since.current = 0;
+      return;
+    }
+    if (state !== 'connecting' && !since.current) since.current = Date.now();
+    const props: CallActivityProps = { orb, since: since.current, state };
+    if (activity.current) {
+      void activity.current.update(props).catch(() => {});
+      return;
+    }
+    try {
+      activity.current = CallActivity.start(props);
+    } catch (error) {
+      console.warn('[hex] The call could not show a Live Activity.', error);
+    }
+  }, [state, orb, last?.ending]);
+}
diff --git a/src/hooks/use-call-elsewhere.ts b/src/hooks/use-call-elsewhere.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c70eebf26928fa60c5b4da3705620e5f44cafb13
--- /dev/null
+++ b/src/hooks/use-call-elsewhere.ts
@@ -0,0 +1,31 @@
+import { useState } from 'react';
+
+import { hex } from '@/hex';
+import { usePastCall } from '@/hooks/use-calls';
+import type { CallId } from '@/live/calls';
+
+// hex holds one call at a time. When it's one this app isn't on, a phone call or the web page, the
+// screen shows it as its own: the call's record follows it word by word until it ends, and the
+// ended call stays on screen, with how it ended, until a call starts here. A call that ended while
+// the app was away is read once more for its ending.
+export function useCallElsewhere(live: CallId | undefined, here: boolean) {
+  const [shown, setShown] = useState<CallId>();
+  const [leaving, setLeaving] = useState<CallId>();
+  if (live && live !== shown) setShown(live);
+  if (here && shown) setShown(undefined);
+  const { call } = usePastCall(shown);
+  const on = !!call && !call.ended;
+
+  const hangUp = async () => {
+    if (!call || call.ended) return;
+    setLeaving(call.id);
+    try {
+      await hex.session.close(call.id);
+    } catch (error) {
+      setLeaving(undefined);
+      throw error;
+    }
+  };
+
+  return { call, live: on, leaving: on && leaving === call.id, hangUp };
+}
