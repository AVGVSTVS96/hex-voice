+import { Pressable, StyleSheet, Text, View } from 'react-native';
+
+import type { CallSummary } from '@/live/calls';
+import { circle, theme } from '@/theme';
+import { space, textOf } from '@/ui/tokens';
+
+type Props = Pick<CallSummary, 'why' | 'summary' | 'waiting'> & {
+  center?: boolean;
+  onOpen?: () => void;
+  onMore?: () => void;
+};
+
+// Under the orb (`center`) only the first few of what's left for you fit; the rest are in Tasks.
+const UNDER_ORB = 3;
+
+// hex's own account of a call once its work settles: what happened, where things went, and what's
+// left for you. Until then a phone call hex placed still says why it called. Under the orb it's cut
+// to fit, and a tap opens the call, where it reads whole.
+export function WrapUp({ why, summary, waiting = [], center, onOpen, onMore }: Props) {
+  const lead = summary ?? (why && `hex called because: ${why}`);
+  if (!lead && !waiting.length) return null;
+  const shown = center ? waiting.slice(0, UNDER_ORB) : waiting;
+  const more = waiting.length - shown.length;
+  return (
+    <Pressable
+      disabled={!onOpen}
+      onPress={onOpen}
+      accessibilityHint={onOpen ? 'Opens the call' : undefined}
+      style={[styles.wrap, center && styles.center]}
+    >
+      {lead && (
+        <Text
+          selectable={!center}
+          numberOfLines={center ? 4 : undefined}
+          style={[styles.summary, center && styles.centered]}
+        >
+          {lead}
+        </Text>
+      )}
+      {waiting.length > 0 && (
+        <View style={styles.waiting}>
+          <Text style={[styles.label, center && styles.centered]}>Waiting on you</Text>
+          {shown.map((item) => (
+            <View key={item} style={styles.item}>
+              <View style={styles.dot} />
+              <Text
+                selectable={!center}
+                numberOfLines={center ? 2 : undefined}
+                style={styles.itemText}
+              >
+                {item}
+              </Text>
+            </View>
+          ))}
+          {more > 0 && (
+            <Text
+              accessibilityRole="button"
+              onPress={onMore}
+              style={[styles.label, styles.more, center && styles.centered]}
+            >
+              {`${more} more in Tasks`}
+            </Text>
+          )}
+        </View>
+      )}
+    </Pressable>
+  );
+}
+
+const styles = StyleSheet.create({
+  wrap: { gap: space[3.5] },
+  center: { alignItems: 'center' },
+  centered: { textAlign: 'center' },
+  summary: { ...textOf('callout'), color: theme.secondary },
+  waiting: { gap: space[2] },
+  label: { ...textOf('footnote', 'semibold'), color: theme.secondary },
+  item: { flexDirection: 'row', alignItems: 'flex-start', gap: space[2.5] },
+  dot: {
+    ...circle(6),
+    marginTop: space[2],
+    backgroundColor: theme.accent,
+  },
+  itemText: { ...textOf('subheadline'), flexShrink: 1, color: theme.text },
+  more: { color: theme.accent },
+});
diff --git a/src/hex/api.ts b/src/hex/api.ts
new file mode 100644
index 0000000000000000000000000000000000000000..157269da6a9fc218d1953d7ed2bae20a1cb37a1d
--- /dev/null
+++ b/src/hex/api.ts
@@ -0,0 +1,73 @@
+import * as z from 'zod/mini';
+
+import { AgentActivity } from '../live/agents';
+import { AskList, Check, Sent, Words, type AskId } from '../live/asks';
+import { CallId, CallList, CallRecord } from '../live/calls';
+import { Chat, TaskCounts, TaskList, TaskOrPage, type TaskId } from '../live/tasks';
+import type { SessionAPI } from '../live/types';
+
+import type { Client } from './client';
+
+// OpenAI's session, as hex hands it back for the app's offer.
+const Opened = z.object({
+  session: z.object({ id: CallId }),
+  transport: z.object({ sdp: z.string() }),
+});
+
+const enc = encodeURIComponent;
+
+// Every request the app makes to hex's voice plugin, each one answered in the app's own types.
+export function createHex({ request, send }: Client) {
+  const session: SessionAPI = {
+    create: async (sdp, voice, about) => {
+      const { session, transport } = await request('/session', Opened, {
+        method: 'POST',
+        body: { sdp, voice, from: 'app', about: about === 'asks' ? about : about?.task },
+      });
+      return { sdp: transport.sdp, sessionId: session.id };
+    },
+    close: (sessionId) => send('/session', { method: 'DELETE', body: { sessionId } }),
+    mark: (sessionId, kind) => send(`/calls/${enc(sessionId)}/moments`, { body: { kind } }),
+  };
+  return {
+    session,
+    activity: {
+      watch: (after: number | undefined, signal: AbortSignal) =>
+        request('/activity', AgentActivity, { after, signal }),
+    },
+    calls: {
+      list: (after?: number, signal?: AbortSignal) =>
+        request('/calls', CallList, { after, signal }),
+      get: (id: CallId, after?: number, signal?: AbortSignal) =>
+        request(`/calls/${enc(id)}`, CallRecord, { after, signal }),
+      remove: (id: CallId) => send(`/calls/${enc(id)}`, { method: 'DELETE' }),
+    },
+    tasks: {
+      list: (after?: number, signal?: AbortSignal) =>
+        request('/tasks', TaskList, { after, signal }),
+      counts: (after?: number, signal?: AbortSignal) =>
+        request('/tasks/summary', TaskCounts, { after, signal }),
+      get: (id: TaskId) => request(`/tasks/${enc(id)}`, TaskOrPage),
+      chat: (id: TaskId, after?: number, signal?: AbortSignal) =>
+        request(`/tasks/${enc(id)}/chat`, Chat, { after, signal }),
+      talk: (id: TaskId) => send(`/tasks/${enc(id)}/talk`),
+      send: (id: TaskId, text: string, key: string) =>
+        send(`/tasks/${enc(id)}/chat`, { body: { text, key } }),
+      stop: (id: TaskId) => send(`/tasks/${enc(id)}/stop`),
+    },
+    asks: {
+      list: (after?: number, signal?: AbortSignal) => request('/asks', AskList, { after, signal }),
+      check: () => request('/asks/check', Check),
+      words: (id: AskId) => request(`/asks/${enc(id)}/words`, Words),
+      answer: (id: AskId, label: string) =>
+        request(`/asks/${enc(id)}/answer`, Sent, { method: 'POST', body: { label } }),
+      note: (id: AskId, text: string) =>
+        request(`/asks/${enc(id)}/note`, Sent, { method: 'POST', body: { text } }),
+      dismiss: (id: AskId) => request(`/asks/${enc(id)}/dismiss`, Sent, { method: 'POST' }),
+      undo: (id: AskId) => send(`/asks/${enc(id)}/undo`),
+      act: (id: string) => send(`/stuck/${enc(id)}/act`),
+      read: (id: string) => send(`/fresh/${enc(id)}/read`),
+      talk: () => send('/asks/talk'),
+    },
+  };
+}
diff --git a/src/hex/client.ts b/src/hex/client.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9da0d0060150f026a941e1ad83cc9631dbb51cdb
--- /dev/null
+++ b/src/hex/client.ts
@@ -0,0 +1,111 @@
+import * as z from 'zod/mini';
+
+// hex heard the request and said no, so sending the same thing again gets the same answer.
+export class Refused extends Error {
+  constructor(
+    message: string,
+    readonly status: number,
+  ) {
+    super(message);
+  }
+}
+
+export type Config = { url?: string; token?: string; fetch: typeof globalThis.fetch };
+export type Client = ReturnType<typeof createClient>;
+
+type Options = {
+  method?: 'GET' | 'POST' | 'DELETE';
+  body?: unknown;
+  after?: number;
+  signal?: AbortSignal;
+  timeout?: number;
+};
+
+// How long to give hex, which can take a minute to answer when its machine is busy: a read, a
+// write, and a watch, which hex holds open until something changes before it answers.
+const READ = 90_000;
+const WRITE = 60_000;
+const WAIT = 120_000;
+const UNREACHABLE = ['Network request failed', 'Failed to fetch', 'fetch failed'];
+
+// The one way this app talks to hex: the address and token are read once, every request has a
+// deadline, and every answer is parsed before anything sees it.
+export function createClient({ url, token, fetch }: Config) {
+  const origin = url?.trim().replace(/\/+$/, '');
+  const auth: Record<string, string> = token ? { Authorization: `Bearer ${token}` } : {};
+
+  async function call(
+    path: string,
+    { method = 'GET', body, after, signal, timeout }: Options,
+  ): Promise<unknown> {
+    if (!origin)
+      throw new Error('Set EXPO_PUBLIC_HEX_URL to your hex voice address, then rebuild the app.');
+    const controller = new AbortController();
+    const abort = () => controller.abort();
+    signal?.addEventListener('abort', abort);
+    const deadline = setTimeout(abort, timeout);
+    try {
+      const response = await fetch(
+        `${origin}${after === undefined ? path : `${path}?after=${after}`}`,
+        {
+          method,
+          headers: body === undefined ? auth : { ...auth, 'Content-Type': 'application/json' },
+          body: body === undefined ? undefined : JSON.stringify(body),
+          signal: controller.signal,
+        },
+      );
+      const text = response.status === 204 ? '' : await response.text();
+      if (!response.ok) throw refusal(response.status, text);
+      return text ? JSON.parse(text) : undefined;
+    } catch (error) {
+      if (signal?.aborted) throw error;
+      if (
+        controller.signal.aborted ||
+        (error instanceof Error &&
+          (['AbortError', 'NetworkError'].includes(error.name) ||
+            UNREACHABLE.includes(error.message)))
+      )
+        throw new Error('Cannot reach hex. Check that Tailscale is on, then try again.');
+      throw error;
+    } finally {
+      clearTimeout(deadline);
+      signal?.removeEventListener('abort', abort);
+    }
+  }
+
+  return {
+    request: async <S extends z.ZodMiniType>(
+      path: string,
+      schema: S,
+      options: Options = {},
+    ): Promise<z.output<S>> => {
+      const answer = schema.safeParse(
+        await call(path, {
+          ...options,
+          timeout: options.timeout ?? (options.after === undefined ? READ : WAIT),
+        }),
+      );
+      if (answer.success) return answer.data;
+      const where = answer.error.issues[0]?.path.join('.');
+      throw new Error(
+        `hex sent ${path} in a shape this app can’t read${where ? ` (${where})` : ''}.`,
+      );
+    },
+    send: async (path: string, options: Omit<Options, 'after' | 'signal'> = {}) => {
+      await call(path, { method: 'POST', ...options, timeout: options.timeout ?? WRITE });
+    },
+  };
+}
+
+const Said = z.object({ error: z.object({ message: z.string() }) });
+
+// hex's own words, or OpenAI's error message it passed on. A 4xx is hex turning the request down.
+function refusal(status: number, text: string) {
+  let message = text.trim();
+  try {
+    message = Said.parse(JSON.parse(text)).error.message;
+  } catch {}
+  message = message.slice(0, 300) || `hex answered HTTP ${status}.`;
+  message = message[0]!.toUpperCase() + message.slice(1);
+  return status < 500 ? new Refused(message, status) : new Error(message);
+}
