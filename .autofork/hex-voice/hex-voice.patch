index 0000000000000000000000000000000000000000..78313beb7949f42f02687b3b910b3146bddffab9
--- /dev/null
+++ b/src/components/agent-line.tsx
@@ -0,0 +1,145 @@
+import { Icon } from '@expo/ui';
+import { useEffect } from 'react';
+import { StyleSheet, Text, View } from 'react-native';
+import Animated, {
+  Easing,
+  FadeIn,
+  FadeOut,
+  ZoomIn,
+  cancelAnimation,
+  useAnimatedStyle,
+  useReducedMotion,
+  useSharedValue,
+  withRepeat,
+  withTiming,
+} from 'react-native-reanimated';
+
+import type { AgentLine as Line } from '@/live/agents';
+import { motion } from '@/motion';
+import { circle, theme } from '@/theme';
+import { Host } from '@/ui/host';
+import { space, textOf } from '@/ui/tokens';
+
+const { step, turn, rise } = motion.agent;
+const timing = { duration: step, easing: Easing.out(Easing.cubic) };
+const enter = () => {
+  'worklet';
+  return {
+    initialValues: { opacity: 0, transform: [{ translateY: rise }] },
+    animations: {
+      opacity: withTiming(1, timing),
+      transform: [{ translateY: withTiming(0, timing) }],
+    },
+  };
+};
+const leave = () => {
+  'worklet';
+  return {
+    initialValues: { opacity: 1, transform: [{ translateY: 0 }] },
+    animations: {
+      opacity: withTiming(0, timing),
+      transform: [{ translateY: withTiming(-rise, timing) }],
+    },
+  };
+};
+
+export function AgentLine({ line }: { line: Line | null }) {
+  if (!line) return null;
+  const label = `hex is ${line.state === 'running' ? 'working' : line.state}: ${line.text}${line.where ? `, ${line.where}` : ''}`;
+  return (
+    <Animated.View
+      entering={FadeIn.duration(step)}
+      exiting={FadeOut.duration(step)}
+      accessible
+      accessibilityLabel={label}
+      accessibilityLiveRegion="polite"
+      style={styles.row}
+    >
+      <Mark state={line.state} />
+      <View style={styles.ticker}>
+        <Animated.Text
+          key={`${line.id} ${line.text}`}
+          entering={enter}
+          exiting={leave}
+          numberOfLines={1}
+          style={[styles.text, line.waiting && styles.waiting]}
+        >
+          {line.text}
+        </Animated.Text>
+      </View>
+      {line.where ? (
+        <Text
+          style={[
+            styles.where,
+            line.state === 'done' && styles.done,
+            line.state === 'failed' && styles.failed,
+          ]}
+        >
+          {line.where}
+        </Text>
+      ) : null}
+    </Animated.View>
+  );
+}
+
+// One mark, one meaning: the arc turns while something works, a check is done, ! failed.
+function Mark({ state }: { state: Line['state'] }) {
+  return (
+    <View style={[styles.mark, state === 'failed' && styles.markFailed]}>
+      {state === 'running' ? (
+        <Arc />
+      ) : (
+        <Animated.View key={state} entering={ZoomIn.springify().damping(14)}>
+          <Host matchContents>
+            <Icon
+              name={state === 'done' ? 'checkmark' : 'exclamationmark'}
+              size={11}
+              color={state === 'done' ? theme.accent : theme.danger}
+            />
+          </Host>
+        </Animated.View>
+      )}
+    </View>
+  );
+}
+
+// The turning arc of something at work, `size` across.
+export function Arc({ size = 12 }: { size?: number }) {
+  const spin = useSharedValue(0);
+  const still = useReducedMotion();
+  useEffect(() => {
+    if (still) return;
+    spin.set(withRepeat(withTiming(1, { duration: turn, easing: Easing.linear }), -1));
+    return () => cancelAnimation(spin);
+  }, [spin, still]);
+  const style = useAnimatedStyle(() => ({ transform: [{ rotate: `${spin.get() * 360}deg` }] }));
+  return <Animated.View style={[styles.arc, circle(size), style]} />;
+}
+
+const styles = StyleSheet.create({
+  row: { height: 22, flexDirection: 'row', alignItems: 'center', gap: space[2.5] },
+  mark: {
+    ...circle(22),
+    backgroundColor: theme.accentMuted,
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  markFailed: { backgroundColor: theme.dangerMuted },
+  arc: {
+    borderWidth: 2,
+    borderColor: theme.accentTrack,
+    borderTopColor: theme.accent,
+  },
+  ticker: { flex: 1, height: 22, overflow: 'hidden' },
+  text: {
+    ...textOf('subheadline', 'medium'),
+    position: 'absolute',
+    left: 0,
+    right: 0,
+    color: theme.text,
+  },
+  waiting: { color: theme.secondary },
+  where: { ...textOf('tag'), color: theme.tertiary, fontVariant: ['tabular-nums'] },
+  done: { color: theme.accent },
+  failed: { color: theme.danger },
+});
