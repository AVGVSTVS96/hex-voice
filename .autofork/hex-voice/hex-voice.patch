+++ b/src/hooks/use-draft.ts
@@ -0,0 +1,27 @@
+import { useState } from 'react';
+import { Settings } from 'react-native';
+
+// What you've typed and not sent yet, kept by where you typed it, so leaving the page, a restart
+// into an update or a crash never loses it. The app's defaults read at once, so a field opens with
+// its draft already in it.
+const KEY = 'HexDrafts';
+
+function saved(): Record<string, string> {
+  const all: unknown = Settings.get(KEY);
+  return all && typeof all === 'object' ? (all as Record<string, string>) : {};
+}
+
+export function keepDraft(where: string, text: string) {
+  const { [where]: _, ...rest } = saved();
+  Settings.set({ [KEY]: text.trim() ? { ...rest, [where]: text } : rest });
+}
+
+// Once what you typed has gone, its draft goes too, unless you've typed more since.
+export function sentDraft(where: string, text: string) {
+  if (saved()[where]?.trim() === text.trim()) keepDraft(where, '');
+}
+
+export function useDraft(where: string) {
+  const [first] = useState(() => saved()[where] ?? '');
+  return { first, keep: (text: string) => keepDraft(where, text) };
+}
diff --git a/src/hooks/use-failures.ts b/src/hooks/use-failures.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bca1260713a2b430904e2e1d0052bc06a3fcdda6
--- /dev/null
+++ b/src/hooks/use-failures.ts
@@ -0,0 +1,32 @@
+import { useState } from 'react';
+import { Linking } from 'react-native';
+
+// "Not answered · That question is already answered or settled": what didn't happen, then hex's
+// reason, which its client already words for you.
+export function failure(what: string, error: unknown) {
+  return `${what} · ${error instanceof Error ? error.message : String(error)}`;
+}
+
+// What you did that didn't go through, by what you did it to, so the place you did it can say so.
+// Doing it again clears it until that try fails too.
+export function useFailures() {
+  const [failed, setFailed] = useState<Record<string, string>>({});
+  const attempt = (key: string, what: string, work: () => Promise<unknown>) => {
+    setFailed(({ [key]: _, ...rest }) => rest);
+    return work().then(
+      () => true,
+      (error: unknown) => {
+        setFailed((now) => ({ ...now, [key]: failure(what, error) }));
+        return false;
+      },
+    );
+  };
+  return { failed, attempt, clear: () => setFailed({}) };
+}
+
+// iOS turns a link down without a word when no app here takes it.
+export function openURL(url: string) {
+  return Linking.openURL(url).catch(() => {
+    throw new Error('No app on this device opens this link');
+  });
+}
diff --git a/src/hooks/use-kept.ts b/src/hooks/use-kept.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0a998dcd7a6141e0e4ddd9ec4d81da1d7a2ebb27
--- /dev/null
+++ b/src/hooks/use-kept.ts
@@ -0,0 +1,35 @@
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import { useCallback, useEffect, useState } from 'react';
+import type * as z from 'zod/mini';
+
+// What this device kept, read back through the schema of hex's answer, since an older app may have
+// written it.
+export async function restore<S extends z.ZodMiniType>(key: string, schema: S) {
+  try {
+    const saved = await AsyncStorage.getItem(key);
+    return saved ? schema.safeParse(JSON.parse(saved)).data : undefined;
+  } catch {}
+}
+
+export function store(key: string, value: unknown) {
+  void AsyncStorage.setItem(key, JSON.stringify(value)).catch(() => {});
+}
+
+// What hex last sent, kept on this device, so while hex is slow or out of reach the screen shows
+// that, not an empty or zeroed list. hex's answer replaces it the moment it lands.
+export function useKept<S extends z.ZodMiniType>(key: string, schema: S) {
+  const [value, setValue] = useState<z.output<S>>();
+  useEffect(() => {
+    void restore(`kept:${key}`, schema).then((saved) => {
+      if (saved !== undefined) setValue((now) => now ?? saved);
+    });
+  }, [key]);
+  const keep = useCallback(
+    (next: z.output<S>) => {
+      setValue(next);
+      store(`kept:${key}`, next);
+    },
+    [key],
+  );
+  return [value, keep] as const;
+}
