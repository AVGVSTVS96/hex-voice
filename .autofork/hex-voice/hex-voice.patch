new file mode 100644
index 0000000000000000000000000000000000000000..96d5ac83fd4b44529f0240dd62806e2189c0f0db
--- /dev/null
+++ b/modules/markdown/index.tsx
@@ -0,0 +1,60 @@
+import { requireNativeView } from 'expo';
+import type { CommonViewModifierProps } from '@expo/ui/swift-ui';
+import { createViewModifierEventListener } from '@expo/ui/swift-ui/modifiers';
+import { processColor, type ColorValue, type NativeSyntheticEvent } from 'react-native';
+
+// Markdown as SwiftUI, drawn by Textual, so it sits in the tree Expo UI builds and takes its modifiers.
+// The block form lays out headings, lists, quotes, code and tables. `inline` is one run of words
+// for a preview or a line, folded to `lines`. The look comes from the caller: sizes in points, and
+// the colors of its words, the quiet ones (list marks, quotes), a quote's bar, a code block's
+// ground and links.
+export type MarkdownProps = CommonViewModifierProps & {
+  markdown: string;
+  inline?: boolean;
+  lines?: number;
+  selectable?: boolean;
+  size: number;
+  leading: number;
+  gap: number;
+  radius: number;
+  color: ColorValue;
+  secondary: ColorValue;
+  edge: ColorValue;
+  surface: ColorValue;
+  accent: ColorValue;
+  onLink: (url: string) => void;
+};
+
+type NativeProps = Omit<MarkdownProps, keyof Colors | 'onLink'> & {
+  [Color in keyof Colors]: ReturnType<typeof processColor>;
+} & { onLink: (event: NativeSyntheticEvent<{ url: string }>) => void };
+type Colors = Pick<MarkdownProps, 'color' | 'secondary' | 'edge' | 'surface' | 'accent'>;
+
+const Native =
+  process.env.EXPO_OS === 'ios' ? requireNativeView<NativeProps>('Markdown', 'MarkdownView') : null;
+
+export function MarkdownView({
+  modifiers,
+  color,
+  secondary,
+  edge,
+  surface,
+  accent,
+  onLink,
+  ...rest
+}: MarkdownProps) {
+  if (!Native) return null;
+  return (
+    <Native
+      modifiers={modifiers}
+      {...(modifiers ? createViewModifierEventListener(modifiers) : undefined)}
+      color={processColor(color)}
+      secondary={processColor(secondary)}
+      edge={processColor(edge)}
+      surface={processColor(surface)}
+      accent={processColor(accent)}
+      onLink={({ nativeEvent }) => onLink(nativeEvent.url)}
+      {...rest}
+    />
+  );
+}
