@@ -0,0 +1,70 @@
+import { mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { dirname, join } from 'node:path';
+import { chromium } from 'playwright-core';
+
+import { ACTIVITY_ORBS, type ActivityOrb } from '../src/live/activity-orb';
+
+const ROOT = join(import.meta.dirname, '..');
+const OUT = join(ROOT, 'assets', 'live-activity', 'Orbs.xcassets');
+const RIVE = dirname(createRequire(import.meta.url).resolve('@rive-app/webgl2'));
+const CANVAS = 400;
+const SIZE = 144;
+// The idle orb at this moment matches the still the app shows before a call starts.
+const SETTLE_MS = 1000;
+
+const files: Record<string, [string, string]> = {
+  '/rive.js': [join(RIVE, 'rive.js'), 'text/javascript'],
+  '/rive.wasm': [join(RIVE, 'rive.wasm'), 'application/wasm'],
+  '/page.js': [join(import.meta.dirname, 'activity-orbs.page.js'), 'text/javascript'],
+};
+
+const page = `<body style="margin:0;background:transparent">
+<canvas id="orb" width="${CANVAS}" height="${CANVAS}"></canvas><script src="/rive.js"></script><script src="/page.js"></script>`;
+
+async function render(browser: import('playwright-core').Browser, orb: ActivityOrb) {
+  const tab = await browser.newPage({ viewport: { width: CANVAS, height: CANVAS } });
+  await tab.route('http://orbs.local/**', (route) => {
+    const path = new URL(route.request().url()).pathname;
+    if (path === '/') return route.fulfill({ contentType: 'text/html', body: page });
+    if (path === '/orb.riv')
+      return route.fulfill({
+        body: readFileSync(join(ROOT, 'src/components/persona/assets', `${orb.variant}.riv`)),
+      });
+    const [file, contentType] = files[path];
+    return route.fulfill({ contentType, body: readFileSync(file) });
+  });
+  await tab.goto('http://orbs.local/');
+  await tab.evaluate((orb) => (window as any).loadOrb(orb), {
+    color: orb.color,
+    palette: orb.palette,
+  });
+  await tab.waitForTimeout(SETTLE_MS);
+  const shot = await tab.locator('#orb').screenshot({ omitBackground: true });
+  const png: string = await tab.evaluate((args) => (window as any).cropOrb(args), {
+    shot: shot.toString('base64'),
+    size: SIZE,
+  });
+  await tab.close();
+  return Buffer.from(png, 'base64');
+}
+
+const info = { author: 'xcode', version: 1 };
+rmSync(OUT, { recursive: true, force: true });
+mkdirSync(OUT, { recursive: true });
+writeFileSync(join(OUT, 'Contents.json'), JSON.stringify({ info }, null, 2) + '\n');
+
+const browser = await chromium.launch({
+  args: ['--use-angle=swiftshader', '--ignore-gpu-blocklist'],
+});
+for (const orb of ACTIVITY_ORBS) {
+  const set = join(OUT, `${orb.name}.imageset`);
+  mkdirSync(set);
+  writeFileSync(join(set, 'orb.png'), await render(browser, orb));
+  writeFileSync(
+    join(set, 'Contents.json'),
+    JSON.stringify({ images: [{ filename: 'orb.png', idiom: 'universal' }], info }, null, 2) + '\n',
+  );
+  console.log(orb.name);
+}
+await browser.close();
diff --git a/scripts/activity-orbs.page.js b/scripts/activity-orbs.page.js
new file mode 100644
index 0000000000000000000000000000000000000000..ec3b5e2b53ff2f92c62c62893e72364f4530a441
--- /dev/null
+++ b/scripts/activity-orbs.page.js
@@ -0,0 +1,69 @@
+// Runs in the browser page that scripts/activity-orbs.mts drives.
+window.loadOrb = ({ color, palette }) =>
+  new Promise((resolve, reject) => {
+    const { Rive, RuntimeLoader, Layout, Fit } = window.rive;
+    RuntimeLoader.setWasmUrl('/rive.wasm');
+    const rive = new Rive({
+      src: '/orb.riv',
+      canvas: document.getElementById('orb'),
+      stateMachines: 'default',
+      autoplay: true,
+      autoBind: false,
+      layout: new Layout({ fit: Fit.Contain }),
+      onLoadError: reject,
+      onLoad: () => {
+        rive.resizeDrawingSurfaceToCanvas();
+        const model = rive.defaultViewModel()?.defaultInstance();
+        if (model) {
+          rive.bindViewModelInstance(model);
+          // The first advance writes the file's own color back, as in the native renderer.
+          const tint = model.color('color');
+          const rgb = color && [1, 3, 5].map((at) => parseInt(color.slice(at, at + 2), 16));
+          if (tint && rgb) setInterval(() => tint.argb(255, ...rgb), 16);
+        }
+        for (const input of rive.stateMachineInputs('default')) {
+          if (['listening', 'thinking', 'speaking', 'asleep'].includes(input.name))
+            input.value = false;
+          if (input.name === 'color' && palette) input.value = palette;
+        }
+        resolve();
+      },
+    });
+  });
+
+window.cropOrb = async ({ shot, size }) => {
+  const image = new Image();
+  image.src = `data:image/png;base64,${shot}`;
+  await image.decode();
+  const read = new OffscreenCanvas(image.width, image.height).getContext('2d');
+  read.drawImage(image, 0, 0);
+  const { data, width, height } = read.getImageData(0, 0, image.width, image.height);
+  let [left, top, right, bottom] = [width, height, 0, 0];
+  for (let y = 0; y < height; y++)
+    for (let x = 0; x < width; x++)
+      if (data[(y * width + x) * 4 + 3] > 8) {
+        left = Math.min(left, x);
+        right = Math.max(right, x);
+        top = Math.min(top, y);
+        bottom = Math.max(bottom, y);
+      }
+  const side = Math.max(right - left, bottom - top) + 2;
+  const out = new OffscreenCanvas(size, size);
+  out
+    .getContext('2d')
+    .drawImage(
+      image,
+      (left + right - side) / 2,
+      (top + bottom - side) / 2,
+      side,
+      side,
+      0,
+      0,
+      size,
+      size,
+    );
+  const bytes = new Uint8Array(
+    await (await out.convertToBlob({ type: 'image/png' })).arrayBuffer(),
+  );
+  return btoa(String.fromCharCode(...bytes));
+};
