@@ -0,0 +1,124 @@
+import { ActivityIndicator, StyleSheet, Text, View, type ColorValue } from 'react-native';
+import type { SFSymbol } from 'sf-symbols-typescript';
+
+import { Glyph } from '@/components/glyph';
+import { WrapUp } from '@/components/wrap-up';
+import {
+  ENDINGS,
+  SOURCES,
+  clock,
+  timeOfDay,
+  timeline,
+  type CallRecord,
+  type CallSummary,
+  type CallTask,
+  type ShownMark,
+} from '@/live/calls';
+import { circle, theme } from '@/theme';
+import { ScrollView } from '@/ui/scroll';
+import { Turn } from '@/ui/turn';
+import { metrics, space, textOf } from '@/ui/tokens';
+
+const MARKS: Record<ShownMark['kind'], SFSymbol> = {
+  paused: 'pause.circle',
+  resumed: 'play.circle',
+  warned: 'timer',
+};
+
+const MARKERS: Record<
+  CallTask['state'],
+  { symbol: SFSymbol; color: ColorValue; fill: ColorValue }
+> = {
+  running: { symbol: 'circle.dotted', color: theme.accent, fill: theme.accentMuted },
+  done: { symbol: 'checkmark', color: theme.accent, fill: theme.accentMuted },
+  failed: { symbol: 'exclamationmark', color: theme.danger, fill: theme.dangerMuted },
+};
+
+type Props = { summary: CallSummary; call?: CallRecord; failed: boolean; live: boolean };
+
+export function CallTranscript({ summary, call, failed, live }: Props) {
+  const ending = summary.end && !live ? ENDINGS[summary.end] : undefined;
+  return (
+    <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={styles.content}>
+      <Line symbol={SOURCES[summary.from].symbol}>
+        {`${SOURCES[summary.from].started} · ${timeOfDay(summary.started)}`}
+      </Line>
+      <WrapUp
+        why={summary.why ?? call?.why}
+        summary={summary.summary ?? call?.summary}
+        waiting={summary.waiting ?? call?.waiting}
+      />
+      {call ? (
+        timeline(call).map((moment) =>
+          moment.kind === 'task' ? (
+            <Marker key={moment.key} task={moment.task} />
+          ) : moment.kind === 'mark' ? (
+            <Line key={moment.key} symbol={MARKS[moment.mark.kind]}>
+              {`${moment.mark.text} · ${clock(moment.at)}`}
+            </Line>
+          ) : (
+            <Turn key={moment.key} you={moment.turn.who === 'you'}>
+              <Text selectable style={styles.text}>
+                {moment.turn.text}
+              </Text>
+            </Turn>
+          ),
+        )
+      ) : failed ? (
+        <Text style={styles.note}>hex didn’t answer, so this call can’t open yet.</Text>
+      ) : (
+        <ActivityIndicator color={theme.secondary} style={styles.loading} />
+      )}
+      {call && ending && (
+        <Line symbol="phone.down" bad={ending.bad}>
+          {`${ending.line} · ${clock(summary.seconds * 1000)}`}
+        </Line>
+      )}
+    </ScrollView>
+  );
+}
+
+function Line({ symbol, bad, children }: { symbol: SFSymbol; bad?: boolean; children: string }) {
+  const color = bad ? theme.danger : theme.secondary;
+  return (
+    <View style={styles.line}>
+      <Glyph name={symbol} size={13} color={color} />
+      <Text style={[styles.lineText, { color }]}>{children}</Text>
+    </View>
+  );
+}
+
+function Marker({ task }: { task: CallTask }) {
+  const look = MARKERS[task.state];
+  return (
+    <View style={styles.marker}>
+      <View style={[styles.dot, { backgroundColor: look.fill }]}>
+        <Glyph name={look.symbol} size={10} color={look.color} />
+      </View>
+      <Text style={styles.task}>{task.text}</Text>
+      <Text style={styles.at}>{clock(task.at)}</Text>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  content: { gap: space[6], paddingTop: metrics.fade, paddingBottom: metrics.fade },
+  line: {
+    alignSelf: 'center',
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: space[1.5],
+  },
+  lineText: textOf('footnote'),
+  text: { ...textOf('words'), color: theme.text },
+  marker: { flexDirection: 'row', alignItems: 'flex-start', gap: space[2.5] },
+  dot: {
+    ...circle(22),
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  task: { ...textOf('subheadline', 'medium'), flex: 1, color: theme.text },
+  at: { ...textOf('tag'), color: theme.tertiary, fontVariant: ['tabular-nums'] },
+  note: { ...textOf('callout'), color: theme.secondary, textAlign: 'center' },
+  loading: { marginTop: space[10] },
+});
diff --git a/src/components/calls-sidebar.tsx b/src/components/calls-sidebar.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fa2d74cb86840c5d2bdc41a561a31452ddc4647b
--- /dev/null
+++ b/src/components/calls-sidebar.tsx
@@ -0,0 +1,303 @@
+import * as Haptics from 'expo-haptics';
+import { useState } from 'react';
+import { Pressable, StyleSheet, Text, View } from 'react-native';
+import { Gesture, GestureDetector } from 'react-native-gesture-handler';
+import Animated, {
+  FadeOut,
+  LinearTransition,
+  useAnimatedStyle,
+  useSharedValue,
+  withSpring,
+  withTiming,
+} from 'react-native-reanimated';
+import { scheduleOnRN } from 'react-native-worklets';
+
+import { Glyph } from '@/components/glyph';
+import {
+  ENDINGS,
+  SOURCES,
+  byDay,
+  callDetails,
+  callName,
+  timeOfDay,
+  type CallId,
+  type CallSummary,
+} from '@/live/calls';
+import { motion } from '@/motion';
+import { circle, theme } from '@/theme';
+import { ScrollView } from '@/ui/scroll';
+import { metrics, radius, space, textOf } from '@/ui/tokens';
+
+const ACTION = 64;
+const DELETE_AT = 180;
+
+type Props = {
+  top: number;
+  width: number;
+  calls?: CallSummary[];
+  live?: string;
+  viewing: string | null;
+  offline: boolean;
+  haptics: boolean;
+  onOpen: (call: CallSummary) => void;
+  onDelete: (id: CallId) => void;
+};
+
+export function CallsSidebar({
+  top,
+  width,
+  calls,
+  live,
+  viewing,
+  offline,
+  haptics,
+  onOpen,
+  onDelete,
+}: Props) {
+  return (
+    <View style={[styles.sidebar, { width, paddingTop: top }]}>
+      <Text accessibilityRole="header" style={styles.title}>
+        Calls
+      </Text>
+      {calls && !calls.length ? (
+        <Empty offline={offline} />
+      ) : (
+        <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={styles.list}>
+          {offline && (
+            <Text style={styles.offline}>Can’t reach hex. These are kept on this device.</Text>
+          )}
+          {byDay(calls ?? []).map((day) => (
+            <View key={day.label}>
+              <Text style={styles.day}>{day.label}</Text>
+              {day.calls.map((call) => (
+                <Row
+                  key={call.id}
+                  call={call}
+                  width={width}
+                  live={call.id === live}
+                  selected={call.id === viewing}
+                  haptics={haptics}
+                  onOpen={onOpen}
+                  onDelete={onDelete}
+                />
+              ))}
+            </View>
+          ))}
+        </ScrollView>
+      )}
+    </View>
+  );
+}
+
+function Row({
+  call,
+  width,
+  live,
+  selected,
+  haptics,
+  onOpen,
+  onDelete,
+}: {
+  call: CallSummary;
+  width: number;
+  live: boolean;
+  selected: boolean;
+  haptics: boolean;
+  onOpen: (call: CallSummary) => void;
+  onDelete: (id: CallId) => void;
+}) {
+  const x = useSharedValue(0);
+  const from = useSharedValue(0);
+  // Swiped open, its delete button is there for VoiceOver too; closed, the row's own action is.
+  const [open, setOpen] = useState(false);
+  const remove = () => {
+    if (process.env.EXPO_OS === 'ios' && haptics)
+      void Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium);
+    onDelete(call.id);
+  };
+  const settle = (to: number, velocity = 0) => {
+    'worklet';
+    x.set(withSpring(to, { ...motion.row, velocity }));
+    scheduleOnRN(setOpen, to !== 0);
+  };
+  const swipe = Gesture.Pan()
+    .enabled(!live)
+    .activeOffsetX([-12, 12])
+    .failOffsetY([-10, 10])
+    .onStart(() => {
+      from.set(x.get());
+    })
+    .onUpdate(({ translationX }) => {
+      x.set(Math.min(0, from.get() + translationX));
+    })
+    .onEnd(({ translationX, velocityX }) => {
+      const at = from.get() + translationX;
+      if (at < -DELETE_AT) {
+        x.set(withTiming(-width, { duration: motion.rowOut }));
+        scheduleOnRN(remove);
+      } else settle(at < -ACTION / 2 || velocityX < -400 ? -ACTION : 0, velocityX);
+    });
+  const tap = Gesture.Tap().onEnd(() => {
+    if (x.get() < -1) settle(0);
+    else scheduleOnRN(onOpen, call);
+  });
+  const slide = useAnimatedStyle(() => ({ transform: [{ translateX: x.get() }] }));
+  const action = useAnimatedStyle(() => ({
+    opacity: Math.min(1, -x.get() / ACTION),
+    transform: [{ scale: 0.6 + 0.4 * Math.min(1, -x.get() / ACTION) }],
+  }));
+
+  const ending = call.end && ENDINGS[call.end];
+  return (
+    <Animated.View
+      exiting={FadeOut.duration(motion.rowOut)}
+      layout={LinearTransition.duration(motion.rowOut)}
+      style={[styles.row, selected && styles.selected]}
+    >
+      <Animated.View style={[styles.action, action]}>
+        <Pressable
+          accessibilityLabel="Delete call"
+          accessibilityElementsHidden={!open}
