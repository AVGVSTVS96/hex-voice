@@ -0,0 +1,45 @@
+import {
+  DEFAULT_PERSONA_COLOR,
+  isOpalPalette,
+  isPersonaColor,
+  type OpalPalette,
+} from '@/components/persona/variants';
+import { useSavedPreference } from '@/hooks/use-saved-preference';
+
+export const REACTIONS = [
+  { id: 'off', label: 'Off', amount: 0 },
+  { id: 'subtle', label: 'Subtle', amount: 0.07 },
+  { id: 'lively', label: 'Lively', amount: 0.16 },
+] as const;
+
+export type Reaction = (typeof REACTIONS)[number]['id'];
+
+function isReaction(value: unknown): value is Reaction {
+  return REACTIONS.some((reaction) => reaction.id === value);
+}
+
+function isSwitch(value: unknown): value is 'on' | 'off' {
+  return value === 'on' || value === 'off';
+}
+
+export function useCallPreferences() {
+  const color = useSavedPreference('live.personaColor', DEFAULT_PERSONA_COLOR, isPersonaColor);
+  const opal = useSavedPreference<OpalPalette>('live.opalPalette', 'original', isOpalPalette);
+  const reaction = useSavedPreference<Reaction>('live.reaction', 'subtle', isReaction);
+  const sounds = useSavedPreference<'on' | 'off'>('live.sounds', 'on', isSwitch);
+  const haptics = useSavedPreference<'on' | 'off'>('live.haptics', 'on', isSwitch);
+  return {
+    personaColor: color.value,
+    setPersonaColor: color.setValue,
+    opalPalette: opal.value,
+    setOpalPalette: opal.setValue,
+    reaction: reaction.value,
+    setReaction: reaction.setValue,
+    sounds: sounds.value === 'on',
+    setSounds: (on: boolean) => sounds.setValue(on ? 'on' : 'off'),
+    haptics: haptics.value === 'on',
+    setHaptics: (on: boolean) => haptics.setValue(on ? 'on' : 'off'),
+  };
+}
+
+export type CallPreferences = ReturnType<typeof useCallPreferences>;
diff --git a/src/hooks/use-calls.ts b/src/hooks/use-calls.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6638d2baebe6cc7151e7877629917d9565c34ad6
--- /dev/null
+++ b/src/hooks/use-calls.ts
@@ -0,0 +1,98 @@
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import { useEffect, useMemo, useState } from 'react';
+import * as z from 'zod/mini';
+
+import { hex } from '@/hex';
+import { useFailures } from '@/hooks/use-failures';
+import { restore, store } from '@/hooks/use-kept';
+import { useWatch } from '@/hooks/use-watch';
+import { CallRecord, CallSummary, putBack, type CallId } from '@/live/calls';
+
+const LIST = 'calls';
+const saved = (id: CallId) => `call:${id}`;
+
+// The list shows what this device kept right away, then follows hex's copy while the app is in
+// front: each request waits on the server until a call changes, so a new call, its title and its
+// wrap-up arrive as they land. A call that just ended here leads the list until hex answers, and
+// only hex's answers are kept on this device.
+export function useCalls() {
+  const [listed, setListed] = useState<CallSummary[]>();
+  const [justEnded, setJustEnded] = useState<CallSummary[]>([]);
+  const [live, setLive] = useState<CallId>();
+  const tries = useFailures();
+
+  useEffect(() => {
+    void restore(LIST, z.array(CallSummary)).then((kept) => {
+      if (kept) setListed((current) => current ?? kept);
+    });
+  }, []);
+
+  useEffect(() => {
+    if (listed) store(LIST, listed);
+  }, [listed]);
+
+  const watching = useWatch('calls', hex.calls.list, (list) => {
+    setListed(list.calls);
+    setJustEnded([]);
+    setLive(list.live);
+  });
+
+  const add = (call: CallSummary) =>
+    setJustEnded((current) => [call, ...current.filter(({ id }) => id !== call.id)]);
+
+  const remove = (id: CallId) => {
+    const others = (calls: CallSummary[]) => calls.filter((call) => call.id !== id);
+    const fromHex = listed?.find((call) => call.id === id);
+    const fromHere = justEnded.find((call) => call.id === id);
+    setListed((current) => current && others(current));
+    setJustEnded(others);
+    void tries
+      .attempt(id, 'Not deleted', () => hex.calls.remove(id))
+      .then((deleted) => {
+        if (deleted) void AsyncStorage.removeItem(saved(id)).catch(() => {});
+        if (!deleted && fromHex) setListed((current) => putBack(current ?? [], fromHex));
+        if (!deleted && fromHere) setJustEnded((current) => putBack(current, fromHere));
+      });
+  };
+
+  // A call that wouldn't delete comes back in its place saying why.
+  const shown = useMemo(() => {
+    if (!listed && !justEnded.length) return undefined;
+    const calls = [
+      ...justEnded,
+      ...(listed ?? []).filter(({ id }) => !justEnded.some((call) => call.id === id)),
+    ];
+    return calls.map((call) =>
+      tries.failed[call.id] ? { ...call, failed: tries.failed[call.id] } : call,
+    );
+  }, [listed, justEnded, tries.failed]);
+  return { calls: shown, live, offline: watching === 'offline', add, remove };
+}
+
+// One call's record: a live one follows word by word until it ends, an ended one comes once and is
+// kept on this device, so it opens at once next time.
+export function usePastCall(id: CallId | undefined) {
+  const [call, setCall] = useState<CallRecord>();
+
+  useEffect(() => {
+    if (!id) return;
+    let active = true;
+    void restore(saved(id), CallRecord).then((kept) => {
+      if (active && kept) setCall((current) => (current?.id === id ? current : kept));
+    });
+    return () => {
+      active = false;
+    };
+  }, [id]);
+
+  const watching = useWatch(
+    id ?? null,
+    (after, signal, id) => hex.calls.get(id, after, signal),
+    (fresh) => {
+      setCall(fresh);
+      if (fresh.ended) store(saved(fresh.id), fresh);
+    },
+  );
+
+  return { call: call?.id === id ? call : undefined, failed: watching === 'offline' };
+}
diff --git a/src/hooks/use-chat.ts b/src/hooks/use-chat.ts
new file mode 100644
index 0000000000000000000000000000000000000000..01114d83e68fdd0b1367b97c21182a038ba23283
--- /dev/null
+++ b/src/hooks/use-chat.ts
@@ -0,0 +1,45 @@
+import { useState } from 'react';
+
+import { hex } from '@/hex';
+import { Refused } from '@/hex/client';
+import { useFailures, failure } from '@/hooks/use-failures';
+import { useWatch } from '@/hooks/use-watch';
+import { arrived, newKey, type Sending } from '@/live/chat';
+import type { Chat, TaskId } from '@/live/tasks';
+
+// One thread's chat, live while it's open, with your words showing the moment you send them. The
+// app names each message it sends, and hex's chat says when it has one: waiting to be taken, or in
+// the chat itself.
+export function useChat(id: TaskId | null) {
+  const [seen, setSeen] = useState<{ id: TaskId; chat: Chat }>();
+  const [sending, setSending] = useState<Sending[]>([]);
+  const tries = useFailures();
+  useWatch(
+    id,
+    (after, signal, id) => hex.tasks.chat(id, after, signal),
+    (chat, id) => setSeen({ id, chat }),
+  );
+
+  const chat = seen && seen.id === id ? seen.chat : undefined;
+  const pending = sending.filter((sent) => sent.id === id && !(chat && arrived(chat, sent)));
+
+  const deliver = (sent: Sending) => {
+    setSending((now) => [
+      ...now.filter(({ key }) => key !== sent.key),
+      { ...sent, failed: undefined },
+    ]);
+    hex.tasks.send(sent.id, sent.text, sent.key).catch((error: unknown) => {
+      const failed = { why: failure('Not sent', error), again: !(error instanceof Refused) };
+      setSending((now) => now.map((each) => (each.key === sent.key ? { ...each, failed } : each)));
+    });
+  };
+
+  return {
+    chat,
+    pending,
+    send: (text: string) => id && deliver({ id, key: newKey(), text, total: chat?.total ?? 0 }),
+    retry: deliver,
+    stop: () => id && tries.attempt(id, 'Not stopped', () => hex.tasks.stop(id)),
+    failed: id ? tries.failed[id] : undefined,
+  };
+}
