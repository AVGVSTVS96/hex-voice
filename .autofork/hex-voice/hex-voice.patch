diff --git a/scripts/release.sh b/scripts/release.sh
new file mode 100644
index 0000000000000000000000000000000000000000..67501776703c93049a8f28b9150361a779b36911
--- /dev/null
+++ b/scripts/release.sh
@@ -0,0 +1,68 @@
+# Shared by ship-js, ship-native and duo: the release checkout is origin/main with its own
+# node_modules and .env.local (see .env.example), and the update store sits beside it.
+set -euo pipefail
+
+home=${HEX_VOICE_HOME:-$HOME/.local/share/hex-voice}
+release=$home/release
+updates=$home/updates
+
+die() {
+  echo "$*" >&2
+  exit 1
+}
+
+install_modules() {
+  local lock
+  lock=$(git hash-object package-lock.json)
+  [ "$(cat node_modules/.lock 2>/dev/null)" = "$lock" ] && return
+  npm ci --no-audit --no-fund >/dev/null
+  echo "$lock" >node_modules/.lock
+}
+
+refresh_release() {
+  local origin
+  origin=$(git -C "$(dirname "${BASH_SOURCE[0]}")" remote get-url origin)
+  [ -d "$release/.git" ] || git clone -q "$origin" "$release"
+  git -C "$release" fetch -q origin main
+  git -C "$release" checkout -q --force --detach origin/main
+  [ -f "$release/.env.local" ] || die "$release/.env.local is missing: copy .env.example and fill it in"
+  (cd "$release" && install_modules)
+}
+
+runtime_version() {
+  (cd "${1:-$release}" && node node_modules/expo-updates/bin/cli.js runtimeversion:resolve --platform ios) |
+    jq -r .runtimeVersion
+}
+
+# pod install re-extracts React Native's prebuilt frameworks, which makes Xcode recompile every
+# pod, so it only runs when what it reads has changed. package-lock.json already pins every pod,
+# so it resolves without the last Podfile.lock, whose old pins would block a package that moved on.
+install_pods() {
+  local inputs
+  inputs=$({
+    cat ios/Podfile ios/Podfile.properties.json package-lock.json
+    find modules -type f | sort
+    find modules -name '*.podspec' -exec cat {} +
+  } | git hash-object --stdin)
+  [ "$(cat ios/Pods/.inputs 2>/dev/null)" = "$inputs" ] && return
+  rm -f ios/Podfile.lock
+  (cd ios && pod install --repo-update) >build/pod-install.log 2>&1 ||
+    die "pod install failed, see $PWD/build/pod-install.log on the Mac"
+  echo "$inputs" >ios/Pods/.inputs
+}
+
+# Runs on the Mac, in a copy of the app: writes its ios folder and installs its pods, so Xcode
+# only rebuilds what changed.
+prepare_native() {
+  export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 PATH=/opt/homebrew/bin:$PATH
+  set -a && . ./.env.local && set +a
+  install_modules
+  # Prebuild only writes its native template into a new ios folder, so a new SDK starts one.
+  local sdk
+  sdk=$(node -p 'require("expo/package.json").version.split(".")[0]')
+  [ "$(cat ios/.sdk 2>/dev/null)" = "$sdk" ] || rm -rf ios
+  CI=1 npx expo prebuild --platform ios --no-install --no-clean >/dev/null
+  echo "$sdk" >ios/.sdk
+  mkdir -p build
+  install_pods
+}
diff --git a/scripts/resign b/scripts/resign
new file mode 100755
index 0000000000000000000000000000000000000000..c8bf830c89dc04105d8b376c425c03090871ee89
--- /dev/null
+++ b/scripts/resign
@@ -0,0 +1,53 @@
+#!/bin/sh
+# Runs on the Mac (sh scripts/resign <serial> <app, relative to $HOME>): signs the app that xtool provisioned
+# (scripts/ship-native) with the Mac's identity whose certificate has that serial number, its frameworks, Live Activity
+# extension and itself, each with the entitlements its embedded profile grants. The free team holds one development
+# certificate, and when it's the Mac's, xtool provisions for it but can't sign with it, since its key stays in the Mac's
+# login keychain. That keychain opens only in the login session, never over ssh, so the signing runs there as a
+# one-off launch agent, which no one sees.
+set -eu
+serial=$1
+app=$2
+identity=
+for hash in $(security find-identity -v -p codesigning | awk '/"Apple Development/ {print $2}'); do
+  security find-certificate -a -Z -p -c "Apple Development" | awk -v h="$hash" '/^SHA-1 hash:/ {on = $3 == h} on && !/^SHA-1/' |
+    openssl x509 -noout -serial 2>/dev/null | grep -qi "=$serial\$" && identity=$hash
+done
+[ -n "$identity" ] || { echo "the Mac's keychain has no signing identity with serial $serial" >&2; exit 1; }
+dir=$(mktemp -d /tmp/hexvoice-resign.XXXXXX)
+cat > "$dir/run" <<RUN
+#!/bin/sh
+cd "\$HOME/$app"
+for framework in Frameworks/*; do
+  codesign -f -s $identity "\$framework" || exit 1
+done
+for bundle in PlugIns/*.appex .; do
+  security cms -D -i "\$bundle/embedded.mobileprovision" > "$dir/profile.plist" || exit 1
+  /usr/bin/python3 -c '
+import plistlib, sys
+granted = plistlib.load(open(sys.argv[1], "rb"))["Entitlements"]
+keys = ("application-identifier", "com.apple.developer.team-identifier", "get-task-allow", "com.apple.security.application-groups")
+entitlements = {k: granted[k] for k in keys if k in granted}
+entitlements["keychain-access-groups"] = [granted["application-identifier"]]
+plistlib.dump(entitlements, open(sys.argv[2], "wb"))' "$dir/profile.plist" "$dir/entitlements.plist" || exit 1
+  codesign -f -s $identity --entitlements "$dir/entitlements.plist" --generate-entitlement-der "\$bundle" || exit 1
+done
+codesign --verify --deep --strict .
+RUN
+chmod +x "$dir/run"
+label=com.shahidy.hexvoice.resign
+cat > "$dir/agent.plist" <<PLIST
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0"><dict><key>Label</key><string>$label</string>
+<key>ProgramArguments</key><array><string>/bin/sh</string><string>-c</string><string>$dir/run > $dir/out 2>&amp;1; echo \$? > $dir/status</string></array>
+<key>RunAtLoad</key><true/></dict></plist>
+PLIST
+launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
+launchctl bootstrap "gui/$(id -u)" "$dir/agent.plist"
+while [ ! -f "$dir/status" ]; do sleep 1; done
+launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
+cat "$dir/out"
+status=$(cat "$dir/status")
+rm -rf "$dir"
+exit "$status"
