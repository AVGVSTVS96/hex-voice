+  large: { ...textOf('wordsLarge'), color: theme.text },
+  warm: { color: theme.secondary },
+  fresh: { color: theme.tertiary },
+  empty: {
+    ...textOf('callout'),
+    color: theme.secondary,
+    textAlign: 'center',
+    paddingBottom: space[3],
+  },
+});
