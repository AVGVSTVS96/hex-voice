diff --git a/plugins/with-activity-orbs.js b/plugins/with-activity-orbs.js
new file mode 100644
index 0000000000000000000000000000000000000000..5f51988957f9c78ae7744d405a35e402d0a845a8
--- /dev/null
+++ b/plugins/with-activity-orbs.js
@@ -0,0 +1,41 @@
+// expo-widgets builds the Live Activity extension without resources, so this adds the orb
+// stills (made by `npm run activity-orbs`) to it as an asset catalog the extension compiles.
+const fs = require('fs');
+const path = require('path');
+const { withDangerousMod, withXcodeProject } = require('expo/config-plugins');
+
+const TARGET = 'ExpoWidgetsTarget';
+const CATALOG = 'Orbs.xcassets';
+
+module.exports = function withActivityOrbs(config) {
+  config = withDangerousMod(config, [
+    'ios',
+    (config) => {
+      const target = path.join(config.modRequest.platformProjectRoot, TARGET, CATALOG);
+      fs.rmSync(target, { recursive: true, force: true });
+      fs.cpSync(path.join(config.modRequest.projectRoot, 'assets/live-activity', CATALOG), target, {
+        recursive: true,
+      });
+      return config;
+    },
+  ]);
+  return withXcodeProject(config, (config) => {
+    const project = config.modResults;
+    const target = project.findTargetKey(TARGET);
+    const group = project.findPBXGroupKey({ name: TARGET });
+    if (!target || !group)
+      throw new Error(`with-activity-orbs: no ${TARGET} target to add orbs to`);
+    if (project.hasFile(CATALOG)) return config;
+    const phase = project
+      .pbxNativeTargetSection()
+      [target].buildPhases.find(({ comment }) => comment === 'Resources');
+    const resources = phase
+      ? project.hash.project.objects.PBXResourcesBuildPhase[phase.value]
+      : project.addBuildPhase([], 'PBXResourcesBuildPhase', 'Resources', target).buildPhase;
+    const file = project.addFile(CATALOG, group, { lastKnownFileType: 'folder.assetcatalog' });
+    Object.assign(file, { uuid: project.generateUuid(), target });
+    project.addToPbxBuildFileSection(file);
+    resources.files.push({ value: file.uuid, comment: `${CATALOG} in Resources` });
+    return config;
+  });
+};
diff --git a/plugins/with-call-audio.js b/plugins/with-call-audio.js
new file mode 100644
index 0000000000000000000000000000000000000000..8c4071009e5644aa83f2dad763d7cde2c9843dcd
--- /dev/null
+++ b/plugins/with-call-audio.js
@@ -0,0 +1,27 @@
+// WebRTC applies its own audio session configuration every time a call's audio starts,
+// so the call's session is set here, before React Native loads. Mixing with others lets
+// music from another app keep playing during a call instead of interrupting it.
+const { withAppDelegate } = require('expo/config-plugins');
+
+const LAUNCH =
+  '    return super.application(application, didFinishLaunchingWithOptions: launchOptions)';
+
+const CALL_AUDIO = `    let callAudio = RTCAudioSessionConfiguration.webRTC()
+    callAudio.mode = AVAudioSession.Mode.videoChat.rawValue
+    callAudio.categoryOptions = [.mixWithOthers, .defaultToSpeaker, .allowBluetoothHFP]
+    RTCAudioSessionConfiguration.setWebRTC(callAudio)
+
+`;
+
+module.exports = function withCallAudio(config) {
+  return withAppDelegate(config, (config) => {
+    let source = config.modResults.contents;
+    if (!source.includes('RTCAudioSessionConfiguration')) {
+      if (!source.includes(LAUNCH))
+        throw new Error('with-call-audio: unexpected AppDelegate.swift');
