+#!/usr/bin/env bash
+# Ships main's JS to the app over the air: the iPhone and iPad pick it up the next time the app
+# comes to the front with no call live. Native changes need scripts/ship-native instead.
+. "$(dirname "$0")/release.sh"
+
+mkdir -p "$home"
+exec 9>"$home/release.lock"
+flock 9
+refresh_release
+runtime=$(runtime_version)
+[ -d "$updates/ios/$runtime" ] ||
+  die "main changed native code (runtime $runtime has no native build): run npm run ship:native"
+
+cd "$release"
+rm -rf dist
+npx expo export --platform ios --output-dir dist >/dev/null
+npx expo config --type public --json >dist/expo-config.json
+HEX_UPDATES_DIR=$updates node updates/store.mts publish dist ios "$runtime" dist/expo-config.json
+echo "shipped $(git log --oneline -1 | cut -c1-80)"
diff --git a/scripts/ship-native b/scripts/ship-native
new file mode 100755
index 0000000000000000000000000000000000000000..f4644e14e3b90855904c86e33a416a992400a50a
--- /dev/null
+++ b/scripts/ship-native
@@ -0,0 +1,109 @@
+#!/usr/bin/env bash
+# Builds main once and installs it on the iPhone and iPad. The Mac builds it unsigned in one warm
+# folder, so Xcode only rebuilds what changed. The free Apple team has one development certificate,
+# and it's the Mac's, so xtool on the server (Bassim's fork) only makes the profiles for it and
+# signs ad hoc, and scripts/resign signs on the Mac, whose login keychain has the key. Then the Mac
+# installs with devicectl on the devices it reaches by cable or Wi-Fi. Never let xtool revoke the
+# certificate to make its own: that breaks what Xcode signs, hex keyboard included.
+# Runs queue up: one that waited behind another builds the newest main, or nothing when the
+# devices already run it. Installing ends a call the app carries, so installs wait for that call
+# to end; phone, web and Discord calls don't run in the app.
+. "$(dirname "$0")/release.sh"
+
+mac=${HEX_VOICE_MAC:-mac}
+folder=Developer/hex-voice-release
+app=build/Build/Products/Release-iphoneos/hex.app
+
+# Runs on the Mac: builds the app, ad-hoc signed with its and the Live Activity extension's
+# entitlements for xtool to read, and prints its runtime version.
+build() {
+  prepare_native
+  xcodebuild -workspace ios/hex.xcworkspace -scheme hex -configuration Release \
+    -destination generic/platform=iOS -derivedDataPath build CODE_SIGNING_ALLOWED=NO \
+    build >build/xcodebuild.log 2>&1 || {
+    grep -E 'error:' build/xcodebuild.log | sort -u >&2
+    die "xcodebuild failed, see $PWD/build/xcodebuild.log on the Mac"
+  }
+  for framework in "$app"/Frameworks/*; do codesign -f -s - "$framework" 2>/dev/null; done
+  codesign -f -s - --entitlements ios/ExpoWidgetsTarget/ExpoWidgetsTarget.entitlements \
+    "$app/PlugIns/ExpoWidgetsTarget.appex" 2>/dev/null
+  codesign -f -s - --entitlements ios/hex/hex.entitlements "$app" 2>/dev/null
+  cat "$app/EXUpdates.bundle/fingerprint"
+}
+
+wait_for_no_call() {
+  local calls after=
+  while true; do
+    calls=$(ssh "$mac" curl -sf -m 60 -H "'Authorization: Bearer $EXPO_PUBLIC_HEX_TOKEN'" \
+      "'$EXPO_PUBLIC_HEX_URL/calls${after:+?after=$after}'") ||
+      die "couldn't ask hex whether a call is live, so nothing was installed"
+    [ -n "$(jq -r '.live as $live | .calls[] | select(.id == $live and .from == "app") | .id' <<<"$calls")" ] ||
+      return 0
+    [ -n "$after" ] || echo "waiting for the app's live call to end before installing"
+    after=$(jq -r .version <<<"$calls")
+  done
+}
+
+if [ "${1:-}" = build ]; then
+  cd "$(dirname "$0")/.."
+  build
+  exit
+fi
+
+mkdir -p "$home/installed"
+exec 8>"$home/native.lock"
+flock -n 8 || {
+  echo "another native ship is running; this one ships the newest main after it"
+  flock 8
+}
+exec 9>"$home/release.lock"
+flock 9
+refresh_release
+commit=$(git -C "$release" rev-parse HEAD)
+title=$(git -C "$release" log --oneline -1 | cut -c1-80)
+bundle=$(jq -r .expo.ios.bundleIdentifier "$release/app.json")
+set -a && . "$release/.env.local" && set +a
+devices=()
+for device in $IOS_DEVICES; do
+  [ "$(cat "$home/installed/$device" 2>/dev/null)" = "$commit" ] || devices+=("$device")
+done
+[ ${#devices[@]} -gt 0 ] || {
+  echo "the iPhone and iPad already run $title"
+  exit
+}
+runtime=$(runtime_version)
+rsync -a --delete --exclude={/node_modules,/ios,/build,/dist,/.expo,/.git} "$release/" "$mac:$folder/"
+flock -u 9
+
+echo "building $title on the Mac"
+built=$(ssh "$mac" "$folder/scripts/ship-native build" </dev/null)
+[ "$built" = "$runtime" ] || die "the Mac built runtime $built, but main's runtime is $runtime"
+mkdir -p "$updates/ios/$runtime"
+
+echo "making its profiles with xtool and signing it with the Mac's certificate"
+signed=build/signed/hex.app
+rsync -a --delete "$mac:$folder/$app/" "$home/hex.app/"
+xtool sign "$home/hex.app" </dev/null
+ssh "$mac" "mkdir -p $folder/build/signed"
+rsync -a --delete "$home/hex.app/" "$mac:$folder/$signed/"
+serial=$(python3 -c "
+import glob, os, plistlib, subprocess
+path = max(glob.glob(os.path.expanduser('~/.config/xtool/data/??????????')), key=os.path.getmtime)
+der = plistlib.load(open(path, 'rb'))['certificate']
+print(subprocess.run(['openssl', 'x509', '-inform', 'DER', '-noout', '-serial'], input=der, capture_output=True).stdout.decode().split('=')[1].strip())")
+ssh "$mac" sh "$folder/scripts/resign" "$serial" "$folder/$signed" </dev/null
+
+wait_for_no_call
+failed=
+for device in "${devices[@]}"; do
+  if timeout 5m ssh "$mac" xcrun devicectl device install app --device "$device" \
+    "$folder/$signed" >"$home/install-$device.log" 2>&1 </dev/null; then
+    echo "$commit" >"$home/installed/$device"
+    echo "installed $title on $device"
+    ssh "$mac" xcrun devicectl device process launch --device "$device" --terminate-existing \
+      "$bundle" >/dev/null 2>&1 || echo "couldn't open it on $device"
+  else
+    failed+=" $device"
+  fi
+done
+[ -z "$failed" ] || die "couldn't install on$failed, see $home/install-<udid>.log"
diff --git a/scripts/voice-previews.mts b/scripts/voice-previews.mts
new file mode 100644
index 0000000000000000000000000000000000000000..cfb1119f8600b7afb0120d22112374ee737de4cf
--- /dev/null
+++ b/scripts/voice-previews.mts
@@ -0,0 +1,105 @@
+import { execFileSync } from 'node:child_process';
+import { join } from 'node:path';
+
+import { VOICES, type LiveVoice } from '../src/live/voices';
+
+const KEY = process.env.OPENAI_API_KEY;
+const OUT = join(import.meta.dirname, '..', 'assets', 'voices');
+const RATE = 24000;
+const CHUNK_MS = 100;
+// Output audio streams silence between turns and has no done event, so the transcript marks where
+// the line ends: no new words for QUIET_MS, then audio up to the last word's end plus TAIL_MS.
+const QUIET_MS = 1500;
+const TAIL_MS = 600;
+
+const previewLine = (name: string) => `Hi, I'm ${name}. Whenever you need me, I'm right here.`;
+
+async function render(voice: LiveVoice, name: string) {
+  // Node's WebSocket (undici) takes headers, which the DOM type it shares doesn't list.
+  const socket = new WebSocket('wss://api.openai.com/v1/live/sessions', {
+    headers: { Authorization: `Bearer ${KEY}` },
+  } as unknown as string[]);
+  const audio: Buffer[] = [];
+  let transcript = '';
+  let spokenUntil = 0;
+  let received = 0;
+  let quiet = false;
+  let silence: NodeJS.Timeout | undefined;
+  let pause: NodeJS.Timeout | undefined;
+
+  await new Promise<void>((resolve, reject) => {
+    const finish = () => {
+      if (!quiet || received < spokenUntil + TAIL_MS) return;
+      quiet = false;
+      clearInterval(silence);
+      socket.send(JSON.stringify({ type: 'session.close' }));
+      setTimeout(() => socket.close(), 500);
+      resolve();
+    };
+    socket.onopen = () =>
+      socket.send(
+        JSON.stringify({
+          type: 'session.start',
+          session: {
+            model: 'gpt-live-1',
+            instructions:
+              'You are recording a short voice sample. Say only the line you are given, warmly and naturally, in English, then stay silent.',
+            delegation: { type: 'client' },
+            audio: { format: { type: 'audio/pcm', rate: RATE }, output: { voice } },
+          },
+        }),
+      );
+    socket.onmessage = ({ data }) => {
+      const event = JSON.parse(String(data));
+      if (event.type === 'error') reject(new Error(`${voice}: ${JSON.stringify(event.error)}`));
+      if (event.type === 'session.started') {
+        const zeros = Buffer.alloc((RATE * 2 * CHUNK_MS) / 1000).toString('base64');
+        silence = setInterval(
+          () => socket.send(JSON.stringify({ type: 'session.input_audio.append', audio: zeros })),
+          CHUNK_MS,
+        );
+        socket.send(
+          JSON.stringify({
+            type: 'session.instructions.append',
+            delegation_id: null,
+            content: `Immediately say exactly this, and nothing else: "${previewLine(name)}"`,
+          }),
+        );
+      }
+      if (event.type === 'session.output_transcript.delta') {
+        transcript += event.delta;
+        spokenUntil = event.end_ms;
+        clearTimeout(pause);
+        pause = setTimeout(() => {
+          quiet = true;
+          finish();
+        }, QUIET_MS);
+      }
+      if (event.type === 'session.output_audio.delta') {
+        const chunk = Buffer.from(event.delta, 'base64');
+        audio.push(chunk);
+        received += (chunk.length / 2 / RATE) * 1000;
+        finish();
+      }
+    };
+    socket.onerror = () => reject(new Error(`${voice}: socket error`));
+  });
+
+  const trim = 'silenceremove=start_periods=1:start_threshold=-50dB,areverse';
+  execFileSync(
+    'ffmpeg',
+    [
+      ...`-loglevel error -y -f s16le -ar ${RATE} -ac 1 -i pipe:0`.split(' '),
+      // Trim the silence around the line and match loudness, so swiping compares voices, not volume.
+      ...['-af', `${trim},${trim},loudnorm=I=-18:TP=-1.5`],
+      ...`-ar ${RATE} -c:a aac -b:a 64k`.split(' '),
+      join(OUT, `${voice}.m4a`),
+    ],
+    { input: Buffer.concat(audio) },
+  );
+  console.log(`${voice}: ${transcript.trim()}`);
+}
+
+if (!KEY) throw new Error('Set OPENAI_API_KEY.');
+const only = process.argv.slice(2);
+for (const { id, label } of VOICES) if (!only.length || only.includes(id)) await render(id, label);
