{
  "name": "hex-voice",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/ui": "~57.0.23",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rive-app/react-native": "^0.4.20",
    "expo": "57.0.28",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.20",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-screen-orientation": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-widgets": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-incall-manager": "^4.3.0",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@rive-app/webgl2": "^2.44.2",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client --port 8088 --lan",
    "ios": "python3 scripts/build-ios.py --port 8088",
    "ios:device": "python3 scripts/build-ios.py --port 8088 --device",
    "ship:js": "scripts/ship-js",
    "ship:native": "scripts/ship-native",
    "android": "expo run:android --port 8088",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "voice-previews": "tsx scripts/voice-previews.mts",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "check": "npm run typecheck && npm test && npm run format:check",
    "eas-build-post-install": "python3 scripts/eas-post-install.py",
    "activity-orbs": "tsx scripts/activity-orbs.mts"
  },
  "private": true,
  "description": "hex's iPhone voice app: call your hex from a real app, on GPT-Live 1.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  }
}
