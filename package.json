{
  "name": "hex-voice",
  "version": "1.0.0",
  "private": true,
  "description": "hex's iPhone voice app: call your hex from a real app, on GPT-Live 1.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --port 8088 --lan",
    "ios": "expo run:ios --port 8088",
    "ios:device": "expo run:ios --port 8088 --device",
    "ship:js": "scripts/ship-js",
    "ship:native": "scripts/ship-native",
    "android": "expo run:android --port 8088",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "voice-previews": "tsx scripts/voice-previews.mts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm test && python3 -m unittest discover -s scripts/tests && npm run format:check",
    "postinstall": "patch-package",
    "activity-orbs": "tsx scripts/activity-orbs.mts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/ui": "58.0.27",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rive-app/react-native": "^0.5.5",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "expo-widgets": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-incall-manager": "^4.3.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-webrtc": "^155.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.92.0",
    "@rive-app/webgl2": "^2.44.2",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
