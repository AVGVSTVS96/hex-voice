# The tap script scripts/duo tap plays by default; uitests/DuoTests.swift lists its commands, and a
# line starting "duo: " plays only on the Duo.
shoot call
mark tasks-button
tap tasks-button
shoot tasks-open
selected tasks-button
still tasks-button
tap tasks-search
type tasks-search-field voice
shoot searching
above-keyboard tasks-search-field
still tasks-button
tap Cancel
tap tasks-button
shoot closed-by-tasks
unselected tasks-button
still tasks-button
duo: tap tasks-button
duo: tap back
duo: shoot closed-by-back
duo: unselected tasks-button
duo: tap tasks-button
duo: swipe-back tasks-edge
duo: shoot closed-by-edge-swipe
duo: unselected tasks-button
tap voice-settings-button
shoot settings
mark voice-row
# Settings holds its place beside the column, so a swipe down leaves it, and Tasks swaps in for it.
# Settings then opens again from Tasks.
swipe-down voice-settings-sheet
# A swiped sheet takes a moment to go, and a tap before then lands on it.
wait 3
tap tasks-button
tap voice-settings-button
shoot settings-again
still voice-row
