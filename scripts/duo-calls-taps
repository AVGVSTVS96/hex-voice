# Opens and closes Calls by its button, an edge swipe and Tasks, and from settings goes to Tasks,
# checking only one of Calls, Tasks and settings is lit:
# scripts/duo tap <ref> scripts/duo-calls-taps
launch hexvoice:///
wait 3
tap calls-button
shoot calls-by-button
selected calls-button
tap calls-button
shoot closed-by-button
unselected calls-button
swipe-back calls-edge
shoot calls-by-edge
selected calls-button
tap calls-button
shoot closed-after-edge
unselected calls-button
tap calls-button
tap tasks-button
shoot tasks-over-calls
selected tasks-button
unselected calls-button
tap calls-button
shoot calls-over-tasks
selected calls-button
unselected tasks-button
tap calls-button
shoot closed-after-tasks
unselected calls-button
unselected tasks-button
# From settings, the column's Tasks button still answers: Tasks shows and settings goes.
tap voice-settings-button
wait 1
shoot settings-open
tap tasks-button
wait 1
shoot tasks-from-settings
selected tasks-button
unselected voice-settings-button
tap tasks-button
