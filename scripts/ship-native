#!/usr/bin/env bash
# Builds main once on the Mac, in one warm build folder so Xcode only rebuilds what changed, and
# installs that build on the iPhone and iPad as soon as no call is live (installing ends a call).
# Signing over ssh needs the Mac's login keychain unlocked in the same session, so the build gets
# its password on stdin from KEYCHAIN_PASSWORD_COMMAND. Hex is asked about calls from the Mac,
# since the server can't reach its own tailnet name.
. "$(dirname "$0")/release.sh"

mac=${HEX_VOICE_MAC:-mac}
folder=Developer/hex-voice-release
app=build/Build/Products/Release-iphoneos/hex.app

build() {
  export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 PATH=/opt/homebrew/bin:$PATH
  set -a && . ./.env.local && set +a
  local password
  password=$(cat)
  [ -z "$password" ] || security unlock-keychain -p "$password" login.keychain-db
  install_modules
  CI=1 npx expo prebuild --platform ios --no-install >/dev/null
  (cd ios && pod install >/dev/null)
  mkdir -p build
  xcodebuild -workspace ios/hex.xcworkspace -scheme hex -configuration Release \
    -destination generic/platform=iOS -derivedDataPath build \
    -allowProvisioningUpdates -allowProvisioningDeviceRegistration \
    DEVELOPMENT_TEAM="$APPLE_TEAM_ID" build >build/xcodebuild.log 2>&1 || {
    grep -E 'error:' build/xcodebuild.log | sort -u >&2
    die "xcodebuild failed, see $PWD/build/xcodebuild.log on the Mac"
  }
  cat "$app/EXUpdates.bundle/fingerprint"
}

keychain_password() {
  [ -z "${KEYCHAIN_PASSWORD_COMMAND:-}" ] || eval "$KEYCHAIN_PASSWORD_COMMAND"
}

wait_for_no_call() {
  local calls after=
  while true; do
    calls=$(ssh "$mac" curl -sf -m 60 -H "'Authorization: Bearer $EXPO_PUBLIC_HEX_TOKEN'" \
      "'$EXPO_PUBLIC_HEX_URL/calls${after:+?after=$after}'") ||
      die "couldn't ask hex whether a call is live, so nothing was installed"
    [ -n "$(jq -r '.live // empty' <<<"$calls")" ] || return 0
    [ -n "$after" ] || echo "waiting for the live call to end before installing"
    after=$(jq -r .version <<<"$calls")
  done
}

if [ "${1:-}" = build ]; then
  cd "$(dirname "$0")/.."
  build
  exit
fi

mkdir -p "$home"
exec 8>"$home/native.lock"
flock 8
exec 9>"$home/release.lock"
flock 9
refresh_release
runtime=$(runtime_version)
commit=$(git -C "$release" log --oneline -1 | cut -c1-80)
bundle=$(jq -r .expo.ios.bundleIdentifier "$release/app.json")
set -a && . "$release/.env.local" && set +a
rsync -a --delete --exclude={/node_modules,/ios,/build,/dist,/.expo,/.git} "$release/" "$mac:$folder/"
flock -u 9

echo "building $commit on the Mac"
built=$(keychain_password | ssh "$mac" "$folder/scripts/ship-native build")
[ "$built" = "$runtime" ] || die "the Mac built runtime $built, but main's runtime is $runtime"
mkdir -p "$updates/ios/$runtime"

wait_for_no_call
failed=
for device in $IOS_DEVICES; do
  if ssh "$mac" "xcrun devicectl device install app --device $device $folder/$app >/dev/null &&
    xcrun devicectl device process launch --device $device --terminate-existing $bundle >/dev/null"; then
    echo "installed $commit on $device"
  else
    failed+=" $device"
  fi
done
[ -z "$failed" ] || die "couldn't install on$failed"
