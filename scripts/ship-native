#!/usr/bin/env bash
# Builds main once and installs it on the iPhone and iPad. The Mac builds it unsigned in one warm
# folder, so Xcode only rebuilds what changed, and xtool on the server signs and installs it: the
# free Apple team has one development certificate, and it lives with xtool on the server.
# Runs queue up: one that waited behind another builds the newest main, or nothing when the
# devices already run it. Installing ends a live call, so installs wait for the call to end.
. "$(dirname "$0")/release.sh"

mac=${HEX_VOICE_MAC:-mac}
folder=Developer/hex-voice-release
app=build/Build/Products/Release-iphoneos/hex.app

# pod install re-extracts React Native's prebuilt frameworks, which makes Xcode recompile every
# pod, so it only runs when what it reads has changed. package-lock.json already pins every pod,
# so it resolves without the last Podfile.lock, whose old pins would block a package that moved on.
install_pods() {
  local inputs
  inputs=$({
    cat ios/Podfile ios/Podfile.properties.json package-lock.json
    find modules -type f | sort
    find modules -name '*.podspec' -exec cat {} +
  } | git hash-object --stdin)
  [ "$(cat ios/Pods/.inputs 2>/dev/null)" = "$inputs" ] && return
  rm -f ios/Podfile.lock
  (cd ios && pod install --repo-update) >build/pod-install.log 2>&1 ||
    die "pod install failed, see $PWD/build/pod-install.log on the Mac"
  echo "$inputs" >ios/Pods/.inputs
}

# Runs on the Mac: builds build/ipa/hex.ipa, ad-hoc signed with the app's and the Live Activity
# extension's entitlements for xtool to read, and prints its runtime version.
build() {
  export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 PATH=/opt/homebrew/bin:$PATH
  set -a && . ./.env.local && set +a
  install_modules
  # Prebuild only writes its native template into a new ios folder, so a new SDK starts one.
  local sdk
  sdk=$(node -p 'require("expo/package.json").version.split(".")[0]')
  [ "$(cat ios/.sdk 2>/dev/null)" = "$sdk" ] || rm -rf ios
  CI=1 npx expo prebuild --platform ios --no-install --no-clean >/dev/null
  echo "$sdk" >ios/.sdk
  mkdir -p build
  install_pods
  xcodebuild -workspace ios/hex.xcworkspace -scheme hex -configuration Release \
    -destination generic/platform=iOS -derivedDataPath build CODE_SIGNING_ALLOWED=NO \
    build >build/xcodebuild.log 2>&1 || {
    grep -E 'error:' build/xcodebuild.log | sort -u >&2
    die "xcodebuild failed, see $PWD/build/xcodebuild.log on the Mac"
  }
  for framework in "$app"/Frameworks/*; do codesign -f -s - "$framework" 2>/dev/null; done
  codesign -f -s - --entitlements ios/ExpoWidgetsTarget/ExpoWidgetsTarget.entitlements \
    "$app/PlugIns/ExpoWidgetsTarget.appex" 2>/dev/null
  codesign -f -s - --entitlements ios/hex/hex.entitlements "$app" 2>/dev/null
  rm -rf build/ipa && mkdir -p build/ipa/Payload && cp -R "$app" build/ipa/Payload/
  (cd build/ipa && zip -qry hex.ipa Payload)
  cat "$app/EXUpdates.bundle/fingerprint"
}

wait_for_no_call() {
  local calls after=
  while true; do
    calls=$(ssh "$mac" curl -sf -m 60 -H "'Authorization: Bearer $EXPO_PUBLIC_HEX_TOKEN'" \
      "'$EXPO_PUBLIC_HEX_URL/calls${after:+?after=$after}'") ||
      die "couldn't ask hex whether a call is live, so nothing was installed"
    [ -n "$(jq -r '.live // empty' <<<"$calls")" ] || return 0
    [ -n "$after" ] || echo "waiting for the live call to end before installing"
    after=$(jq -r .version <<<"$calls")
  done
}

# xtool reaches a device over Wi-Fi through netmuxd, or plugged into the Mac through the Mac's
# usbmuxd, forwarded here over ssh.
open_sockets() {
  netmuxd=UNIX:${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/netmuxd.sock
  on_wifi=$(USBMUXD_SOCKET_ADDRESS=$netmuxd xtool devices --no-wait 2>/dev/null || true)
  mac_usb=$home/mac-usbmuxd.sock
  rm -f "$mac_usb"
  ssh -NT -o ExitOnForwardFailure=yes -o StreamLocalBindUnlink=yes \
    -L "$mac_usb:/var/run/usbmuxd" "$mac" &
  trap "kill $!" EXIT
  while [ ! -S "$mac_usb" ]; do sleep 0.2; done
}

socket_for() {
  if grep -q "$1" <<<"$on_wifi"; then echo "$netmuxd"; else echo "UNIX:$mac_usb"; fi
}

if [ "${1:-}" = build ]; then
  cd "$(dirname "$0")/.."
  build
  exit
fi

mkdir -p "$home/installed"
exec 8>"$home/native.lock"
flock -n 8 || {
  echo "another native ship is running; this one ships the newest main after it"
  flock 8
}
exec 9>"$home/release.lock"
flock 9
refresh_release
commit=$(git -C "$release" rev-parse HEAD)
title=$(git -C "$release" log --oneline -1 | cut -c1-80)
bundle=$(jq -r .expo.ios.bundleIdentifier "$release/app.json")
set -a && . "$release/.env.local" && set +a
devices=()
for device in $IOS_DEVICES; do
  [ "$(cat "$home/installed/$device" 2>/dev/null)" = "$commit" ] || devices+=("$device")
done
[ ${#devices[@]} -gt 0 ] || {
  echo "the iPhone and iPad already run $title"
  exit
}
runtime=$(runtime_version)
rsync -a --delete --exclude={/node_modules,/ios,/build,/dist,/.expo,/.git} "$release/" "$mac:$folder/"
flock -u 9

echo "building $title on the Mac"
built=$(ssh "$mac" "$folder/scripts/ship-native build" </dev/null)
[ "$built" = "$runtime" ] || die "the Mac built runtime $built, but main's runtime is $runtime"
mkdir -p "$updates/ios/$runtime"
scp -q "$mac:$folder/build/ipa/hex.ipa" "$home/hex.ipa"

wait_for_no_call
open_sockets
failed=
for device in "${devices[@]}"; do
  socket=$(socket_for "$device")
  if USBMUXD_SOCKET_ADDRESS=$socket XTL_KEEP_IDENTIFIERS=1 timeout 5m xtool install \
    --udid "$device" "$home/hex.ipa" >"$home/install-$device.log" 2>&1; then
    echo "$commit" >"$home/installed/$device"
    echo "installed $title on $device"
    ssh "$mac" xcrun devicectl device process launch --device "$device" --terminate-existing \
      "$bundle" >/dev/null 2>&1 || echo "couldn't open it on $device"
  else
    failed+=" $device"
  fi
done
[ -z "$failed" ] || die "couldn't install on$failed, see $home/install-<udid>.log"
