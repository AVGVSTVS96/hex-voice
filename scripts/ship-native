#!/usr/bin/env bash
# Builds main once and puts it on the install link (/install/ on the update server), where the
# app's update toast, or the link's page in Safari, installs it when Bassim taps: nothing installs
# by itself. The Mac builds it unsigned in one warm folder, so Xcode only rebuilds what changed.
# Bassim's paid Apple team signs it with the Mac's development certificate, in profiles that last a
# year: xtool on the server (Bassim's fork) only makes the profiles for it and signs ad hoc, and
# scripts/resign signs on the Mac, whose login keychain has the key. Never let xtool revoke the
# certificate to make its own: that breaks what Xcode signs, hex keyboard included.
# A build goes up only when main's native code (its runtime) isn't on the link yet, since an app
# with that runtime already gets main's JS over the air; --rebuild puts it up anyway, which renews
# the year the profiles last.
# Runs queue up: one that waited behind another builds the newest main, and reuses a signed build
# of that main already on the Mac. When the Mac doesn't answer, it's asleep, and the run stops and
# says so.
#   scripts/ship-native [--rebuild]
. "$(dirname "$0")/release.sh"

mac=${HEX_VOICE_MAC:-mac}
folder=Developer/hex-voice-release
app=build/Build/Products/Release-iphoneos/hex.app

# Runs on the Mac: builds the app with Xcode 27.3, whose iOS SDK is the first where Siri can use Ask
# hex (plugins/siri), ad-hoc signed with its and the Live Activity extension's entitlements for xtool
# to read, and prints its runtime version.
build() {
  export DEVELOPER_DIR=/Applications/Xcode-27.3-beta.app/Contents/Developer
  prepare_native
  xcodebuild -workspace ios/hex.xcworkspace -scheme hex -configuration Release \
    -destination generic/platform=iOS -derivedDataPath build CODE_SIGNING_ALLOWED=NO \
    build >build/xcodebuild.log 2>&1 || {
    grep -E 'error:' build/xcodebuild.log | sort -u >&2
    die "xcodebuild failed, see $PWD/build/xcodebuild.log on the Mac"
  }
  for framework in "$app"/Frameworks/*; do codesign -f -s - "$framework" 2>/dev/null; done
  codesign -f -s - --entitlements ios/ExpoWidgetsTarget/ExpoWidgetsTarget.entitlements \
    "$app/PlugIns/ExpoWidgetsTarget.appex" 2>/dev/null
  codesign -f -s - --entitlements ios/hex/hex.entitlements "$app" 2>/dev/null
  cat "$app/EXUpdates.bundle/fingerprint"
}

# Gives the app the link's build number as CFBundleVersion, its extensions too, and registers the
# scheme <bundle id>-<number>, which hangar opens to know the install finished and bring it back.
# Only the built app changes, so the runtime fingerprint keeps meaning native code alone.
number_build() {
  python3 - "$@" <<'PY'
import glob, plistlib, sys
app, bundle, number = sys.argv[1:]
for path in [f"{app}/Info.plist", *glob.glob(f"{app}/PlugIns/*.appex/Info.plist")]:
    info = plistlib.load(open(path, "rb"))
    info["CFBundleVersion"] = number
    if path == f"{app}/Info.plist":
        info["CFBundleURLTypes"] = [*info.get("CFBundleURLTypes", []), {"CFBundleURLSchemes": [f"{bundle}-{number}"]}]
    plistlib.dump(info, open(path, "wb"), fmt=plistlib.FMT_BINARY)
PY
}

if [ "${1:-}" = build ]; then
  cd "$(dirname "$0")/.."
  build
  exit
fi

link=$updates/install
mkdir -p "$link"
exec 8>"$home/native.lock"
flock -n 8 || {
  echo "another native ship is running; this one ships the newest main after it"
  flock 8
}
exec 9>"$home/release.lock"
flock 9
refresh_release
commit=$(git -C "$release" rev-parse HEAD)
title=$(git -C "$release" log --oneline -1 | cut -c1-80)
bundle=$(jq -r .expo.ios.bundleIdentifier "$release/app.json")
number=$(git -C "$release" rev-list --count HEAD)
set -a && . "$release/.env.local" && set +a
runtime=$(runtime_version)
[ "${1:-}" = --rebuild ] || [ "$(jq -r .runtime "$link/latest.json" 2>/dev/null)" != "$runtime" ] || {
  echo "the install link already has main's native code (runtime $runtime): npm run ship:js ships the rest"
  exit
}
ssh -o ConnectTimeout=15 -o BatchMode=yes "$mac" true </dev/null 2>/dev/null ||
  die "the Mac didn't answer, so it's asleep: $title wasn't built"
asleep() { [ $? != 255 ] || echo "the Mac stopped answering, so it's asleep: $title isn't on the link" >&2; }
trap asleep EXIT
signed=build/signed/hex.app
if [ "$(cat "$home/signed" 2>/dev/null)" = "$commit $runtime" ]; then
  flock -u 9
  echo "the Mac already holds $title, signed"
else
  rsync -a --delete --exclude={/node_modules,/ios,/build,/dist,/.expo,/.git} "$release/" "$mac:$folder/"
  flock -u 9

  echo "building $title on the Mac"
  built=$(ssh "$mac" "$folder/scripts/ship-native build" </dev/null)
  [ "$built" = "$runtime" ] || die "the Mac built runtime $built, but main's runtime is $runtime"

  echo "making its profiles with xtool and signing it with the Mac's certificate"
  rsync -a --delete "$mac:$folder/$app/" "$home/hex.app/"
  number_build "$home/hex.app" "$bundle" "$number"
  xtool sign "$home/hex.app" </dev/null
  ssh "$mac" "mkdir -p $folder/build/signed"
  rsync -a --delete "$home/hex.app/" "$mac:$folder/$signed/"
  serial=$(python3 -c "
import glob, os, plistlib, subprocess
path = max(glob.glob(os.path.expanduser('~/.config/xtool/data/??????????')), key=os.path.getmtime)
der = plistlib.load(open(path, 'rb'))['certificate']
print(subprocess.run(['openssl', 'x509', '-inform', 'DER', '-noout', '-serial'], input=der, capture_output=True).stdout.decode().split('=')[1].strip())")
  ssh "$mac" sh "$folder/scripts/resign" "$serial" "$folder/$signed" </dev/null
  echo "$commit $runtime" >"$home/signed"
fi

echo "putting it on the install link"
ssh "$mac" "cd $folder/build/signed && rm -rf Payload hex.ipa && mkdir Payload && cp -R hex.app Payload/ &&
  ditto -c -k --keepParent Payload hex.ipa && rm -rf Payload" </dev/null
scp -q "$mac:$folder/build/signed/hex.ipa" "$link/hex-$number.ipa.part"
mv "$link/hex-$number.ipa.part" "$link/hex-$number.ipa"
url=${HEX_UPDATES_URL%/manifest}/install
python3 - "$link" "$url" "$number" "$bundle" "$runtime" "$title" "$home/hex.app/Info.plist" <<'PY'
import html, json, plistlib, sys, urllib.parse
link, url, number, bundle, runtime, title, info = sys.argv[1:]
version = plistlib.load(open(info, "rb"))["CFBundleVersion"]
plistlib.dump({"items": [{
    "assets": [{"kind": "software-package", "url": f"{url}/hex-{number}.ipa"}],
    "metadata": {"bundle-identifier": bundle, "bundle-version": version, "kind": "software", "title": "hex"},
}]}, open(f"{link}/manifest.plist", "wb"))
install = "itms-services://?action=download-manifest&url=" + urllib.parse.quote(f"{url}/manifest.plist", safe="")
open(f"{link}/index.html", "w").write(f"""<!doctype html>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>hex {number}</title>
<style>
body {{ font: 17px/1.4 -apple-system, system-ui; max-width: 30em; margin: 18vh auto 0; padding: 0 20px }}
a {{ display: block; padding: 14px; border-radius: 14px; background: #1F8A6D; color: white; text-align: center; font-weight: 600; text-decoration: none }}
p {{ opacity: .6; font-size: 15px; margin-top: 20px }}
</style>
<a href="{html.escape(install)}">Install hex {number}</a>
<p>{html.escape(title)}</p>
""")
json.dump({"version": int(number), "runtime": runtime, "install": install}, open(f"{link}/latest.json.part", "w"))
PY
mv "$link/latest.json.part" "$link/latest.json"
find "$link" -name 'hex-*.ipa' ! -name "hex-$number.ipa" -delete
mkdir -p "$updates/ios/$runtime"
hangar=$HOME/Developer/hangar/bin/hangar
[ ! -x "$hangar" ] || "$hangar" put "$link/hex-$number.ipa" --notes "$(git -C "$release" log -1 --format=%s)"
echo "$title is on the install link, $url/: the app shows its update toast"
