#!/usr/bin/env bash
# Checks a commit on the iPhone Duo simulator, the one hex-voice keeps on the Mac ("hexvoice Duo",
# iOS 27.1), or with DEVICE=ipad on an iPad 11" simulator, and screenshots the real Duo.
#
#   scripts/duo build [ref]           bundles and builds it, printing any compile errors
#   scripts/duo shoot [ref] [states]  each state in the states file (the ref's scripts/duo-states
#                                     by default) in each pose, dark and light
#   scripts/duo tap [ref] [taps]      the tap script (the ref's scripts/duo-taps by default) in
#                                     each pose, dark and light: XCUITest really taps
#   scripts/duo verify [ref]          what ship:js and ship:native run first: npm run check, then
#                                     scripts/duo-moves filmed and judged by a fresh reviewer
#   scripts/duo fold [ref] [states]   films the states moving through FOLDS and counts the frames
#                                     each move takes to settle (scripts/fold_frames.py)
#   scripts/duo phone [update]        the real Duo's screen, once it runs that OTA update if given
#
# POSES picks poses (the Duo's 4 by default, cover-up cover-side open-up open-side; 110-up is the
# hinge at 110°, upright) and APPEARANCES dark, light or both. Shots land in
# $home/shots/<commit>/ (tap's in tap/), with one sheet per pose and notes.txt naming each
# state the app wasn't running in (how a crash or a JS error shows in a release build) or the
# screen didn't turn for. ref defaults to main, and a run that waited behind another checks the
# newest main, or nothing when that commit was already shot. DEVICE=ipad uses "hexvoice iPad", an
# iPad Pro 11" on iOS 27.3 run through Xcode 27.3 beta (27.1 and Xcode-beta are the Duo's), in place
# of the Duo, shutting the Duo down so only one is booted; its poses are up and side, and its shots land in ipad/ beside the Duo's. HEX=kept answers the app's reads from the
# last ones hex answered (kept on the Mac), so a before/after pair sees the same lists and runs
# while hex is slow; its notes say when they were kept, and its shots land in kept/. With it,
# ANSWERS=<file of answers by path> answers those paths from the file, its shots in kept/<file>/. The JS is bundled here; the Mac builds the
# app for the simulator only when the commit's native fingerprint has no build yet, keeping the
# last three. A lane's simulator stays booted between checks, since each boot starts hundreds of
# iOS services at once and loads the Mac for minutes; each check installs the app fresh instead.
. "$(dirname "$0")/release.sh"

mac=${HEX_VOICE_MAC:-mac}
DEVICE=${DEVICE:-duo}
HEX=${HEX:-live}
case $DEVICE in
  duo | ipad) ;;
  *) echo "DEVICE is duo or ipad" >&2 && exit 1 ;;
esac
bundle=com.shahidy.hexvoice

# A lane is a Duo and an iPad simulator with its own Mac folder, stand-in port, lock and checkout
# here, so lanes check side by side. Checks take whichever of lanes 1 ("") and 2 is free first, and
# verify has a lane of its own, so it never waits behind them. Every lane installs the simulator
# builds lane 1's folder makes. The app under check talks to scripts/duo-hex.mjs on the lane's port,
# which never passes a write on to hex.
use_lane() {
  LANE=$1
  lane=${1:+-$1}
  folder=Developer/hex-voice-sim$lane
  duo="${1:+$1 }hexvoice Duo"
  ipad="${1:+$1 }hexvoice iPad"
  case $DEVICE in
    duo) sim=$duo model=iPhone-Duo os=iOS-27-1 xcode=Xcode-beta ;;
    ipad) sim=$ipad model=iPad-Pro-11-inch-M5-12GB os=iOS-27-3 xcode=Xcode-27.3-beta ;;
  esac
  case $1 in
    '') hexport=8799 ;;
    verify) hexport=8800 ;;
    *) hexport=$((8799 + $1)) ;;
  esac
  verify=$home/verify$lane
  js=$home/js$lane
}
use_lane "${LANE:-}"

# A Duo pose is <fold>-<up|side>: the fold is cover (shut), open (flat) or the hinge's angle in
# degrees. The iPad's are up and side.
if [ "$DEVICE" = ipad ]; then POSES=${POSES:-up side}; else POSES=${POSES:-cover-up cover-side open-up open-side}; fi
APPEARANCES=${APPEARANCES:-dark light}
# The moves `scripts/duo fold` films, from cover-up: turning the cover, opening, turning open,
# folding partway, and shutting.
FOLDS=${FOLDS:-cover-side cover-up open-up open-side open-up 150-up open-up cover-up}

# Sets hinge, orientation and the simulator display that shows the pose.
pose_of() {
  case ${1%-*} in
    cover) hinge=0 display=1 ;;
    open) hinge=180 display=3 ;;
    up | side) hinge='' display='' ;;
    *) hinge=${1%-*} display=3 ;;
  esac
  case ${1##*-} in
    up) orientation=portrait ;;
    side) orientation=landscape-right ;;
  esac
}

# Runs on the Mac, in $folder: app/ is the commit's tree, apps/<runtime>.app its simulator builds,
# js/ its bundle, harness/ this script with what it needs.
# Checks run each simulator with its own Xcode, set here per device, and build with the Duo's, since
# every device installs the same simulator builds; .env.local's DEVELOPER_DIR is the one ship:native
# builds with.
on_mac() {
  export DEVELOPER_DIR=/Applications/$xcode.app/Contents/Developer
  export PATH=/opt/homebrew/bin:$PATH
  cd ~/"$folder"
  local command=$1
  shift
  "mac_$command" "$@"
}

mac_build() {
  local runtime=$1
  (cd app && prepare_native && DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer SKIP_BUNDLING=1 xcodebuild -workspace ios/hex.xcworkspace -scheme hex \
    -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' \
    -derivedDataPath build ARCHS=arm64 CODE_SIGNING_ALLOWED=NO build >build/xcodebuild.log 2>&1) || {
    grep -E 'error:' app/build/xcodebuild.log | sort -u >&2
    die "xcodebuild failed, see ~/$folder/app/build/xcodebuild.log on the Mac"
  }
  mkdir -p apps
  rm -rf "apps/$runtime.app"
  cp -cR app/build/Build/Products/Release-iphonesimulator/hex.app "apps/$runtime.app"
  ls -t apps | tail -n +4 | sed 's|^|apps/|' | xargs rm -rf
}

# The commit's bundle in its runtime's build, which never looks for an OTA update, talking to
# the read-only stand-in for hex for as long as this check runs. It installs fresh, so nothing a
# run left saved (a collapsed list, a chosen voice) changes what the next run sees.
mac_install() {
  rm -f hex-down
  mac_tls
  (set -a && . harness/.env.local && set +a && DUO_HEX_PORT=$hexport DUO_HEX_ANSWERS=$PWD/answers.json DUO_HEX_DOWN=$PWD/hex-down \
    DUO_HEX_TLS=$PWD/tls \
    DUO_HEX_REPLAY=$([ "$HEX" != kept ] || echo 1) DUO_HEX_ALSO=$([ ! -f harness/also.json ] || echo harness/also.json) \
    exec node harness/duo-hex.mjs) &
  standin=$!
  # The simulator stays booted for the next check, but the app closes: its orb draws all the while.
  # While ~/.config/turn/cold exists, as when the Mac is short of memory, the simulator shuts down too.
  trap 'kill "$standin"; xcrun simctl terminate "$id" "$bundle" 2>/dev/null
    [ ! -e ~/.config/turn/cold ] || xcrun simctl shutdown "$id"' EXIT
  # When hex reads slowly the app shows empty lists or "Can't reach hex", which would pass for its look.
  curl -sf -m 10 --retry 3 --retry-connrefused --retry-delay 1 --cacert tls/ca.pem -o /dev/null \
    "https://127.0.0.1:$hexport/tasks/summary" ||
    die "hex didn't answer a read in 10 s (with HEX=kept: none is kept), so the screens would be empty: nothing was checked"
  rm -rf stage shots && mkdir stage shots
  [ "$HEX" != kept ] || echo "answered from hex's reads kept $(date -r answers.json '+%b %-d %H:%M')" >>shots/notes.txt
  [ ! -f harness/also.json ] || echo "and $(jq -r 'keys | join(", ")' harness/also.json) from the run's own answers" >>shots/notes.txt
  cp -cR "apps/$1.app" stage/hex.app
  rsync -a js/ stage/hex.app/
  plutil -replace EXUpdatesEnabled -bool NO stage/hex.app/Expo.plist
  codesign -f -s - stage/hex.app 2>/dev/null
  mac_simulator
  xcrun simctl keychain "$id" add-root-cert tls/ca.pem
  xcrun simctl uninstall "$id" "$bundle" 2>/dev/null || true
  xcrun simctl install "$id" stage/hex.app
}

# The stand-in's certificate for 127.0.0.1 and the root it hangs from, made once and kept here.
mac_tls() {
  [ ! -f tls/cert.pem ] || return 0
  rm -rf tls && mkdir tls
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj /CN=hex-voice-standin -keyout tls/ca-key.pem \
    -out tls/ca.pem -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign 2>/dev/null
  openssl req -newkey rsa:2048 -nodes -subj /CN=127.0.0.1 -keyout tls/key.pem -out tls/cert.csr 2>/dev/null
  printf 'subjectAltName=IP:127.0.0.1\nextendedKeyUsage=serverAuth\nbasicConstraints=CA:FALSE\n' >tls/cert.ext
  openssl x509 -req -in tls/cert.csr -CA tls/ca.pem -CAkey tls/ca-key.pem -CAcreateserial -days 800 \
    -extfile tls/cert.ext -out tls/cert.pem 2>/dev/null
}

mac_simulator() {
  local runtime=com.apple.CoreSimulator.SimRuntime.$os other
  id=$(xcrun simctl list devices -j | jq -r --arg name "$sim" \
    '.devices[][] | select(.name == $name and .isAvailable) | .udid' | head -1)
  [ -n "$id" ] || id=$(xcrun simctl create "$sim" "com.apple.CoreSimulator.SimDeviceType.$model" "$runtime")
  for other in $(xcrun simctl list devices booted -j | jq -r --arg id "$id" --arg duo "$duo" --arg ipad "$ipad" \
    '.devices[][] | select((.name == $duo or .name == $ipad) and .udid != $id) | .udid'); do
    xcrun simctl shutdown "$other"
  done
  # iOS asks "Open in hex?" for each link until the scheme is approved, and reads approvals at boot.
  local approvals=~/Library/Developer/CoreSimulator/Devices/$id/data/Library/Preferences
  approvals=$approvals/com.apple.launchservices.schemeapproval.plist
  /usr/libexec/PlistBuddy -c "Print :com.apple.CoreSimulator.CoreSimulatorBridge-->hexvoice" "$approvals" \
    >/dev/null 2>&1 || {
    xcrun simctl shutdown "$id" 2>/dev/null || true
    mkdir -p "$(dirname "$approvals")"
    /usr/libexec/PlistBuddy -c "Add :com.apple.CoreSimulator.CoreSimulatorBridge-->hexvoice string $bundle" \
      "$approvals" >/dev/null
  }
  xcrun simctl bootstatus "$id" -b >/dev/null
  rm -f build/hinge
  xcrun simctl status_bar "$id" clear
  [ build/devicehub -nt harness/devicehub.c ] || {
    mkdir -p build
    xcrun -sdk iphonesimulator clang -arch arm64 -mios-simulator-version-min=27.0 -O2 -o build/devicehub \
      harness/devicehub.c -framework IOKit -framework CoreFoundation
    codesign -f -s - build/devicehub 2>/dev/null
  }
}

hub() { xcrun simctl spawn "$id" "$PWD/build/devicehub" "$@" </dev/null; }

# Opens the Duo to a pose: the hinge only moves when it changes, since that takes a few seconds, and
# sweeps from where it is (kept in build/hinge since the simulator booted), never through the closed Duo.
place() {
  local at
  pose_of "$1"
  at=$(cat build/hinge 2>/dev/null || true)
  [ -z "$hinge" ] || [ "$hinge" = "$at" ] || {
    hub hinge "$hinge" ${at:+"$at"}
    [ -z "${burst:-}" ] || shoot_burst
    sleep 3
    echo "$hinge" >build/hinge
  }
  hub orientation "$orientation"
  sleep 1
  hub orientation "$orientation"
}

# Whether a shot has the shape its pose turns the screen to: the open screen is wide upright and
# tall on its side, the cover and the iPad the other way round.
turned() {
  local width height
  read -r width height < <(sips -g pixelWidth -g pixelHeight "$1" | awk '/pixel/ { printf "%s ", $2 }')
  case $display:${pose##*-} in
    3:up | 1:side | :side) [ "$width" -gt "$height" ] ;;
    *) [ "$width" -lt "$height" ] ;;
  esac
}

ms() { perl -MTime::HiRes=time -e 'printf "%d", time * 1000'; }

# Three shots as fast as the simulator gives them once the hinge has settled, to catch a frame
# drawn for the wrong window, each named by its ms after and the clock's ms (the clock the app's
# HexPoseLog stamps its changes with), then that log as it stands just after.
shoot_burst() {
  local start=$(ms) now i
  for i in 1 2 3; do
    now=$(ms)
    xcrun simctl io "$id" screenshot ${display:+--display=$display} "$burst-$((now - start))ms-at$now.png" >/dev/null 2>&1
  done
  xcrun simctl spawn "$id" defaults read "$prefs" HexPoseLog 2>/dev/null </dev/null | jq . >"$burst-log.json" 2>/dev/null ||
    rm -f "$burst-log.json"
  burst=
}

# Places a pose mid-check and, when the screen hasn't turned to it, says so and turns it again from
# upright, as a shot whose shape is wrong does.
place_turned() {
  local pose=$1
  place "$pose"
  sleep 2
  xcrun simctl io "$id" screenshot ${display:+--display=$display} build/turn.png >/dev/null 2>&1
  turned build/turn.png && return
  echo "$pose: the screen hadn't turned to $pose (the app may have locked it), so it was turned again" >>shots/notes.txt
  hub orientation portrait
  sleep 1
  hub orientation "$orientation"
  sleep 2
  xcrun simctl io "$id" screenshot ${display:+--display=$display} build/turn.png >/dev/null 2>&1
  turned build/turn.png || echo "$pose: the screen didn't turn to $pose" >>shots/notes.txt
}

running() {
  xcrun simctl spawn "$id" launchctl list </dev/null | grep "UIKitApplication:$bundle" | grep -qv '^-'
}

# Reads "<state> <url> [launch argument…]" lines: each state opens cold from its URL (after
# launching with its arguments, if it has any), in each pose and each appearance, set before the app
# launches: an app whose appearance changes under it redraws late and partly, so a shot taken after
# switching comes out half in the old one. A pose the app reports (?report=pose) lands beside the
# shots as <pose>-<state>.json.
mac_shoot() {
  local states pose hinge orientation display state url arguments appearance file prefs
  mac_install "$1"
  prefs=$(xcrun simctl get_app_container "$id" "$bundle" data)/Library/Preferences/$bundle
  states=$(cat)
  for pose in $POSES; do
    while read -r -u 4 state url arguments; do
      for appearance in $APPEARANCES; do
        xcrun simctl terminate "$id" "$bundle" 2>/dev/null || true
        xcrun simctl spawn "$id" defaults delete "$prefs" HexPose >/dev/null 2>&1 || true
        xcrun simctl ui "$id" appearance "$appearance"
        place "$pose"
        if [ -n "$arguments" ]; then
          # shellcheck disable=SC2086
          xcrun simctl launch "$id" "$bundle" $arguments >/dev/null
          sleep 2
        fi
        xcrun simctl openurl "$id" "$url"
        sleep "${SETTLE:-5}"
        running || echo "$pose $state $appearance: the app wasn't running" >>shots/notes.txt
        xcrun simctl spawn "$id" defaults read "$prefs" HexPose 2>/dev/null </dev/null |
          jq . >"shots/$pose-$state.json" 2>/dev/null || rm -f "shots/$pose-$state.json"
        file=shots/$pose-$state-$appearance.png
        xcrun simctl io "$id" screenshot ${display:+--display=$display} "$file" >/dev/null 2>&1
        turned "$file" || {
          hub orientation portrait
          sleep 1
          hub orientation "$orientation"
          sleep 2
          xcrun simctl io "$id" screenshot ${display:+--display=$display} "$file" >/dev/null 2>&1
          turned "$file" || echo "$pose $state $appearance: the screen didn't turn to $pose" >>shots/notes.txt
        }
      done
    done 4<<<"$states"
  done
}

# Plays the tap script it reads (uitests/DuoTests.swift has its commands) in each pose and
# appearance: each "shoot <name>" is shot as shots/<pose>-<name>-<appearance>.png, "pose <pose>"
# moves the Duo there without relaunching the app (turning it again if the screen didn't turn), a
# step opened with ?report=pose keeps the pose the app had as <pose>-<name>-<appearance>.json and its
# last changes as …-log.json, "pose-burst <pose>" also shoots three frames right as the hinge lands,
# failures go to notes.txt, and the
# accessibility tree at the end lands beside the shots.
mac_tap() {
  local tests=~/$folder/build/uitests taps pose hinge orientation display appearance result line prefs step
  mac_install "$1"
  prefs=$(xcrun simctl get_app_container "$id" "$bundle" data)/Library/Preferences/$bundle
  taps=$(cat)
  (cd harness/uitests && xcodegen generate -q)
  xcodebuild build-for-testing -project harness/uitests/DuoTests.xcodeproj -scheme DuoTests \
    -destination "id=$id" -derivedDataPath "$tests" -quiet >"$tests.log" 2>&1 || {
    grep -E 'error:' "$tests.log" | sort -u >&2
    die "the UI tests didn't build"
  }
  for pose in $POSES; do
    for appearance in $APPEARANCES; do
      # CoreSimulatorService restarting shuts every simulator down; boot it again for the next pose.
      xcrun simctl bootstatus "$id" -b >/dev/null
      place_turned "$pose"
      xcrun simctl ui "$id" appearance "$appearance"
      result=$tests/$pose-$appearance.xcresult
      rm -rf "$result" "$tests/attachments"
      [ "${VIDEO:-}" != "$appearance" ] || {
        rm -f build/recording.log
        xcrun simctl io "$id" recordVideo --codec=h264 ${display:+--display=$display} --force \
          "shots/$pose-$appearance.mov" >/dev/null 2>build/recording.log &
        recording=$!
        # The film's first frame, the moment the steps' ms count from.
        until grep -q "Recording started" build/recording.log; do sleep 0.1; done
        filmed=$(ms)
      }
      rm -rf build/sync && mkdir -p build/sync
      answered=0
      # The Device Hub's turn only drives the Duo, so on the iPad XCUITest turns the device itself.
      TEST_RUNNER_DUO_TURN=$([ "$DEVICE" != ipad ] || echo "$orientation") \
        TEST_RUNNER_DUO_TAPS=$taps TEST_RUNNER_DUO_SYNC=$PWD/build/sync xcodebuild test-without-building -project harness/uitests/DuoTests.xcodeproj \
        -scheme DuoTests -destination "id=$id" -derivedDataPath "$tests" -resultBundlePath "$result" \
        -collect-test-diagnostics never 2>&1 | { while IFS= read -r line; do
        case $line in
          *"duo-line "*)
            [ "${VIDEO:-}" != "$appearance" ] || echo "$(($(ms) - filmed)) ${line##*duo-}" >>"shots/$pose-$appearance-steps.txt"
            ;;
          *"duo-touch "*)
            [ "${VIDEO:-}" != "$appearance" ] || echo "$((${line##*duo-touch } - filmed)) touch" >>"shots/$pose-$appearance-steps.txt"
            ;;
          *"duo-step "*)
            step=${line##*duo-step }
            xcrun simctl io "$id" screenshot ${display:+--display=$display} \
              "shots/$pose-$step-$appearance.png" >/dev/null 2>&1
            touch "build/sync/$((answered += 1))"
            {
              xcrun simctl spawn "$id" defaults read "$prefs" HexPose 2>/dev/null </dev/null |
                jq . >"shots/$pose-$step-$appearance.json" 2>/dev/null || rm -f "shots/$pose-$step-$appearance.json"
              xcrun simctl spawn "$id" defaults read "$prefs" HexPoseLog 2>/dev/null </dev/null |
                jq . >"shots/$pose-$step-$appearance-log.json" 2>/dev/null || rm -f "shots/$pose-$step-$appearance-log.json"
            } &
            ;;
          *"duo-snap "*)
            xcrun simctl io "$id" screenshot ${display:+--display=$display} \
              "shots/$pose-${line##*duo-snap }-$appearance.png" >/dev/null 2>&1 &
            ;;
          *"duo-pose "*)
            place_turned "${line##*duo-pose }"
            touch "build/sync/$((answered += 1))"
            ;;
          *"duo-burst "*)
            bursts=$((${bursts:-0} + 1))
            burst=shots/$pose-burst$bursts-${line##*duo-burst }-$appearance
            place_turned "${line##*duo-burst }"
            touch "build/sync/$((answered += 1))"
            ;;
          *"duo-hex down"*) touch hex-down ;;
          *"duo-hex up"*) rm -f hex-down ;;
          *error:* | *XCTAssert* | *failed* | *duo-frame*) echo "$pose $appearance: $line" >>shots/notes.txt ;;
        esac
      done; wait; } || true
      [ "${VIDEO:-}" != "$appearance" ] || { kill -INT "$recording" && wait "$recording"; } || true
      xcrun xcresulttool export attachments --path "$result" --output-path "$tests/attachments" >/dev/null
      jq -r '.[].attachments[] | select(.suggestedHumanReadableName | startswith("tree")) |
        "\(.exportedFileName) \(.suggestedHumanReadableName | sub("_[0-9]+_[0-9A-F-]+.*$"; ""))"' \
        "$tests/attachments/manifest.json" | while read -r exported name; do
        cp "$tests/attachments/$exported" "shots/$pose-$name-$appearance.txt"
      done
    done
  done
}

# Moves the Duo from one pose to the next as a hand would, at once: the hinge or the turn, whichever
# changes. A turn is sent again a second later, as place does, since the simulator can miss the
# first. Whether the screen turned shows in the film: the probe's turns and the app's side by side.
move() {
  local from
  pose_of "$1"
  from=$hinge:$orientation
  pose_of "$2"
  [ "${from%:*}" = "$hinge" ] || hub hinge "$hinge" "${from%:*}"
  [ "${from#*:}" = "$orientation" ] || { hub orientation "$orientation" && sleep 1 && hub orientation "$orientation"; }
  echo "$hinge" >build/hinge
}

# Films each state it reads moving through FOLDS from cover-up, once filming the open screen and
# once the cover (the simulator films one screen at a time): shots/<state>-<screen>.mov, the ms its
# film started in shots/<state>-<screen>.start, and each move as "<ms> <from> <to>" in
# shots/<state>-<screen>-moves.txt. A state's URL launch:<bundle> launches that app instead: the
# probe, FOLD_PROBE's app, which is installed first.
mac_fold() {
  local states state url arguments pose hinge orientation display at screen film tries
  mac_install "$1"
  [ -z "${FOLD_PROBE:-}" ] || xcrun simctl install "$id" "${FOLD_PROBE/#\~/$HOME}"
  xcrun simctl ui "$id" appearance dark
  states=$(cat)
  while read -r -u 4 state url arguments; do
    for screen in 3 1; do
      xcrun simctl terminate "$id" "$bundle" 2>/dev/null || true
      xcrun simctl terminate "$id" "${url#launch:}" 2>/dev/null || true
      place cover-up
      case $url in
        launch:*) xcrun simctl launch "$id" "${url#launch:}" >/dev/null ;;
        *) xcrun simctl openurl "$id" "$url" ;;
      esac
      sleep "${SETTLE:-5}"
      xcrun simctl io "$id" recordVideo --codec=h264 --display=$screen --force "shots/$state-$screen.mov" \
        >/dev/null 2>build/recording.log &
      film=$!
      tries=0
      until grep -q "Recording started" build/recording.log || [ $((tries += 1)) -gt 500 ]; do sleep 0.02; done
      ms >"shots/$state-$screen.start"
      grep -q "Recording started" build/recording.log ||
        echo "$state: screen $screen didn't film: $(cat build/recording.log)" >>shots/notes.txt
      sleep 1
      at=cover-up
      for pose in $FOLDS; do
        echo "$(ms) $at $pose" >>"shots/$state-$screen-moves.txt"
        move "$at" "$pose"
        at=$pose
        sleep "${FOLD_HOLD:-7}"
      done
      kill -INT "$film" 2>/dev/null || true
      wait "$film" || true
    done
  done 4<<<"$states"
}

[ "${1:-}" = mac ] && {
  shift
  on_mac "$@"
  exit
}

repo=$(cd "$(dirname "$0")/.." && pwd)
shots=$home/shots

# Sets commit to the ref's, main's being origin/main as it is now.
resolve() {
  local ref=${1:-main}
  git -C "$repo" fetch -q origin main
  [ "$ref" != main ] || ref=origin/main
  commit=$(git -C "$repo" rev-parse --short=7 "$ref^{commit}") || die "no commit $ref"
}

# Checks the ref out in $verify with its node_modules, bundles its JS, and builds its native code
# on the Mac if no build has its fingerprint.
prepare() {
  resolve "${1:-}"
  [ -d "$verify" ] || git -C "$repo" worktree add -q --detach "$verify" "$commit"
  git -C "$verify" checkout -q --force --detach "$commit"
  cp "$release/.env.local" "$verify/.env.local"
  (cd "$verify" && install_modules)
  title=$(git -C "$verify" log --oneline -1 | cut -c1-80)
  runtime=$(runtime_version "$verify")
  rm -rf "$js" && mkdir -p "$js"
  (cd "$verify" && EXPO_PUBLIC_HEX_URL=https://127.0.0.1:$hexport EXPO_PUBLIC_HEX_TOKEN=check \
    turn npx expo export:embed --platform ios --dev false --minify true \
    --entry-file node_modules/expo-router/entry.js --bundle-output "$js/main.jsbundle" \
    --assets-dest "$js") >"$js.log" 2>&1 || {
    tail -20 "$js.log" >&2
    die "$title didn't bundle"
  }
  (set -a && . "$release/.env.local" &&
    ! grep -qF -e "$EXPO_PUBLIC_HEX_TOKEN" -e "$EXPO_PUBLIC_HEX_URL" "$js/main.jsbundle") ||
    die "$title's bundle can reach hex itself, so it isn't checked"
  [ -z "$lane" ] || ssh "$mac" "mkdir -p $folder && ln -sfn ../hex-voice-sim/apps $folder/apps"
  rsync -a --delete "$repo/scripts/duo" "$repo/scripts/release.sh" "$repo/scripts/devicehub.c" \
    "$repo/scripts/duo-hex.mjs" "$repo/uitests" "$mac:$folder/harness/"
  rsync -a --chmod=600 "$release/.env.local" "$mac:$folder/harness/.env.local"
  [ -z "${ANSWERS:-}" ] || rsync -a "$ANSWERS" "$mac:$folder/harness/also.json"
  rsync -a --delete "$js/" "$mac:$folder/js/"
  ssh "$mac" test -d "$folder/apps/$runtime.app" || {
    exec 6>"$home/build.lock"
    flock 6
    ssh "$mac" test -d "$folder/apps/$runtime.app" || {
      echo "building $title's native code for the simulator"
      rsync -a --delete --exclude={/node_modules,/ios,/build,/dist,/.expo,/.git} "$verify/" "$mac:Developer/hex-voice-sim/app/"
      ssh "$mac" "LANE= $folder/harness/duo mac build $runtime" </dev/null
    }
    flock -u 6
  }
}

# Copies the Mac's shots to $1 with a sheet per pose, dark beside light, adds this run's notes
# to the commit's notes.txt and prints them.
collect() {
  local out=$1 pose notes
  mkdir -p "$out"
  rsync -a --exclude=notes.txt "$mac:$folder/shots/" "$out/"
  notes=$(ssh "$mac" cat "$folder/shots/notes.txt" 2>/dev/null || true)
  for pose in $POSES; do
    montage -label '%t' -pointsize 28 -tile 2x -geometry 640x640+12+12 -background '#222' -fill white \
      "$out/$pose"-*.png "$out/sheet-$pose.png" 2>/dev/null || true
  done
  [ -z "$notes" ] || { echo "$notes" >>"$out/notes.txt"; echo "$notes"; }
  echo "shots: $out"
}

shoot() {
  local states=${1:-}
  [ -n "$states" ] || [ ! -f "$out/done" ] || {
    echo "$title was already shot: $out"
    return
  }
  echo "shooting $title"
  { if [ -n "$states" ]; then cat "$states"; else
    git -C "$verify" show HEAD:scripts/duo-states 2>/dev/null || cat "$repo/scripts/duo-states"
  fi; } |
    grep -v -e '^#' -e '^$' | ssh "$mac" "LANE=$LANE DEVICE=$DEVICE HEX=$HEX POSES='$POSES' APPEARANCES='$APPEARANCES' TURN_POOL=sims TURN_FIRST=${FIRST:-} lockf $folder.lock turn $folder/harness/duo mac shoot $runtime"
  collect "$out"
  echo "$title" >"$out/done"
}

# A tap script's line that starts "duo: " or "ipad: " plays only on that device.
tap() {
  echo "tapping through $title"
  { if [ -n "${1:-}" ]; then cat "$1"; else
    git -C "$verify" show HEAD:scripts/duo-taps 2>/dev/null || cat "$repo/scripts/duo-taps"
  fi; } | sed -E -e "s/^$DEVICE: //" -e '/^(duo|ipad): /d' |
    ssh "$mac" "LANE=$LANE DEVICE=$DEVICE HEX=$HEX VIDEO=${VIDEO:-} POSES='$POSES' APPEARANCES='$APPEARANCES' TURN_POOL=sims TURN_FIRST=${FIRST:-} lockf $folder.lock turn $folder/harness/duo mac tap $runtime"
  collect "${2:-$out/tap}"
}

# Turns each film in $1 into the frames the screen drew in the second after each touch (a tap, swipe
# or keystroke lands), 20 a second without repeats, labelled by their ms after it: one row of frames
# per touch, titled by its step, four touches to a sheet, moves/<pose>-<appearance>-<n>.png, with
# every frame kept in moves/<pose>-<appearance>/<row>/. The films have a keyframe every half second,
# so each second is cut on its own, eight at once.
filmstrips() {
  local dir=$1 movie frames at step row frame rows n
  for movie in "$dir"/*.mov; do
    [ -f "$movie" ] || continue
    frames=$dir/moves/$(basename "$movie" .mov)
    rm -rf "$frames" && mkdir -p "$frames"
    n=0
    while read -r at step; do
      row=$frames/$(printf %02d $n)
      n=$((n + 1))
      mkdir -p "$row" && echo "$step" >"$row.step"
      [ "$(jobs -rp | wc -l)" -lt 8 ] || wait -n
      ffmpeg -nostdin -loglevel error -ss "$((at / 1000)).$(printf %03d $((at % 1000)))" -t 1 -i "$movie" \
        -vf fps=20,scale=-2:480,mpdecimate -fps_mode passthrough -frame_pts 1 "$row/%03d.png" &
    done < <(awk '$2 == "touch" { print $1, step; next } { $1 = ""; step = substr($0, 7) }' "${movie%.mov}-steps.txt")
  done
  wait
  for frames in "$dir"/moves/*/; do
    frames=${frames%/}
    rows=()
    for row in "$frames"/??; do
      for frame in "$row"/*.png; do
        [ -f "$frame" ] && mv "$frame" "$row/$(printf %04d $((10#$(basename "$frame" .png) * 50)))ms.png"
      done
      montage -label '%t' -pointsize 22 -fill white "$row"/*.png -tile 10x -geometry +3+3 -background '#333' \
        -title "$(cat "$row.step")" "$row.png" 2>/dev/null && rows+=("$row.png")
    done
    for i in $(seq 0 4 $((${#rows[@]} - 1))); do
      magick "${rows[@]:$i:4}" -background '#111' -append "$frames-$((i / 4 + 1)).png"
    done
  done
}

# Films the states (tasks open, and on a pretend call, by default) through FOLDS and counts per move
# the frames the app showed a wrong layout after iOS's own part of the move had landed
# (scripts/fold_frames.py), into $out/fold/table.md with a sheet of each move's frames. iOS's part is
# what a plain UIKit app takes: FOLD_PROBE, the path of a simulator build of one on the Mac
# (FoldProbe, com.shahidy.foldprobe), filmed alongside as the state "probe".
fold() {
  local dir=$out/fold
  echo "folding $title"
  rm -rf "$dir"
  { if [ -n "${1:-}" ]; then cat "$1"; else
    git -C "$verify" show HEAD:scripts/duo-states 2>/dev/null | grep -E '^tasks(-call)? '
  fi
    [ -z "${FOLD_PROBE:-}" ] || echo "probe launch:com.shahidy.foldprobe"; } |
    ssh "$mac" "LANE=$LANE DEVICE=duo HEX=$HEX FOLDS='$FOLDS' FOLD_PROBE='${FOLD_PROBE:-}' TURN_POOL=sims TURN_FIRST=${FIRST:-} lockf $folder.lock turn $folder/harness/duo mac fold $runtime" ||
    echo "the Mac's half ended with $?; counting what it filmed"
  mkdir -p "$dir"
  rsync -a "$mac:$folder/shots/" "$dir/"
  [ ! -f "$dir/notes.txt" ] || cat "$dir/notes.txt"
  python3 "$repo/scripts/fold_frames.py" "$dir"
  echo "frames: $dir"
}

passed() {
  [ "$(head -c4 "$verdict" 2>/dev/null)" = pass ] && echo "what $commit ships already passed: $(cat "$verdict")"
}

# The check a builder's commits pass before they ship: npm run check, then scripts/duo-moves on the
# Duo in its 4 poses and the iPad in its 2, dark and light, filmed, and a reviewer who never saw the
# work (scripts/review.md) judging each shot and each frame the screens draw as they move. A pass is
# kept for what ships: the commit's tree without its tests, scripts and docs, so a commit that changes
# only those passes at once.
verify() {
  local dir moves
  resolve "${1:-}"
  verdict=$home/verdicts/$(git -C "$repo" ls-tree "$commit" |
    grep -vP '\t(tests|scripts|uitests|docs|[^/]*\.md)$' | git hash-object --stdin)
  passed && return
  take_lane verify
  passed && return
  prepare "$commit"
  dir=$shots/$commit/verify
  rm -rf "$dir" && mkdir -p "$dir" "$home/verdicts"
  echo "checking $title"
  (cd "$verify" && npm run check) >"$dir/check.log" 2>&1 || {
    tail -30 "$dir/check.log" >&2
    die "npm run check failed on $title, see $dir/check.log"
  }
  moves=$dir/duo-moves
  git -C "$verify" show HEAD:scripts/duo-moves >"$moves" 2>/dev/null || cp "$repo/scripts/duo-moves" "$moves"
  VIDEO=dark APPEARANCES=dark DEVICE=duo POSES='cover-up cover-side open-up open-side' tap "$moves" "$dir/duo"
  VIDEO=dark APPEARANCES=dark DEVICE=ipad POSES='up side' tap "$moves" "$dir/ipad"
  # Light comes from cold launches in light, since switching mid-walk leaves shots half redrawn.
  git -C "$verify" show HEAD:scripts/duo-states >"$dir/duo-states" 2>/dev/null || cp "$repo/scripts/duo-states" "$dir/duo-states"
  DEVICE=duo POSES='cover-up cover-side open-up open-side' APPEARANCES=light out=$dir/duo-light shoot "$dir/duo-states"
  DEVICE=ipad POSES='up side' APPEARANCES=light out=$dir/ipad-light shoot "$dir/duo-states"
  filmstrips "$dir/duo"
  filmstrips "$dir/ipad"
  echo "three fresh reviewers are looking at $title: the folded Duo, the open Duo and the iPad"
  local share
  for share in "duo/cover-up duo/cover-side duo-light/cover-up duo-light/cover-side" \
    "duo/open-up duo/open-side duo-light/open-up duo-light/open-side" "ipad/up ipad/side ipad-light/up ipad-light/side"; do
    # claude -p is charged as an SDK run, at a higher rate than the terminal, unless it says
    # otherwise (anthropics/claude-code#97074).
    { cat "$repo/scripts/review.md"; echo; echo "Your share is everything for these poses: $share."; } |
      (cd "$dir" && CLAUDE_CODE_ENTRYPOINT=cli claude -p --model claude-opus-5-5 --effort high \
        --tools Read Glob Bash --allowedTools Read Glob 'Bash(magick:*)') >"$dir/review-$(echo "${share%% *}" | tr / -).md" &
  done
  wait
  for share in duo-cover-up duo-open-up ipad-up; do
    echo "## $share and its pair" && cat "$dir/review-$share.md"
  done >"$dir/review.md"
  cat "$dir/review.md"
  if [ "$(grep -cx PASS "$dir/review.md")" = 3 ]; then
    echo "pass $title $dir" >"$verdict"
  else
    echo "fail $title $dir" >"$verdict"
    die "$title didn't pass: fix what the reviewer found, commit, and run scripts/duo verify again"
  fi
}

# The Duo's lit screen. Given an OTA update id, it first waits until a device asks for updates
# while running it. That proves the update is on a device, not that hex is in front: the iPad
# asks too, and so does hex in the background, so the shot is often another app.
phone() {
  set -a && . "$release/.env.local" && set +a
  local since file
  since=$(date '+%F %T')
  [ -z "${1:-}" ] || {
    until journalctl --user -u hex-voice-updates --since "$since" | grep -q "runs $1"; do
      sleep 5
    done
    sleep 8
  }
  file=$shots/phone/$(date +%m%d-%H%M%S).png
  mkdir -p "$shots/phone"
  # The cover is the Duo's primary display even while it's open and off, so this shoots the lit one.
  ssh "$mac" "xcrun devicectl device info displays --device $DUO_UDID --json-output /tmp/duo-displays.json >/dev/null &&
    xcrun devicectl device capture screenshot --device $DUO_UDID --destination /tmp/duo-phone.png \
      --display-unique-id \$(jq -r '.result.displays[] | select(.active) | .uniqueId' /tmp/duo-displays.json) >/dev/null" ||
    die "couldn't screenshot the Duo; is it unlocked and near the Mac?"
  scp -q "$mac:/tmp/duo-phone.png" "$file" && ssh "$mac" rm /tmp/duo-phone.png
  [ "$(magick "$file" -format '%[fx:maxima]' info:)" != 0 ] || die "the Duo's screen was black ($file): off, or the app is stuck"
  echo "$file"
}

# Holds the lock of the first free lane of those given. Checks waiting for a lane take one in the
# order they came, by ticket, and FIRST=1 puts a check someone is waiting on ahead of the rest (it
# goes first for the Mac's simulator turn too). A lane whose stand-in port is taken on the Mac is
# busy as well, and on the Mac a check also holds the lane's own lock (<folder>.lock) while it runs,
# so one that outlived its run here makes the next wait there instead of colliding.
take_lane() {
  local queue=$home/queue-${1:-checks} candidate waiting ticket told=
  mkdir -p "$queue"
  ticket=$queue/$([ -n "${FIRST:-}" ] && echo 0 || echo 1)-$(date +%s)-$$
  echo "$(date +%H:%M) scripts/duo $command" >"$ticket"
  while :; do
    for waiting in "$queue"/*; do
      kill -0 "${waiting##*-}" 2>/dev/null || rm -f "$waiting"
    done
    if [ "$(ls "$queue" | sort -t- -k1,1 -k2,2n | head -1)" = "${ticket##*/}" ]; then
      for candidate in "$@"; do
        exec 7>"$home/duo${candidate:+-$candidate}.lock"
        flock -n 7 || continue
        use_lane "$candidate"
        ssh "$mac" lsof -nP -iTCP:"$hexport" -sTCP:LISTEN >/dev/null || {
          rm -f "$ticket"
          # A check stopped here stops on the Mac too, or its stand-in would hold the lane's port.
          trap 'ssh "$mac" "pkill -f \"[${folder:0:1}]${folder:1}/harness/duo mac \"; lsof -ti tcp:$hexport -sTCP:LISTEN | xargs kill" 2>/dev/null; exit 143' TERM INT HUP
          return 0
        }
        flock -u 7
      done
    fi
    [ -n "$told" ] || { echo "every lane is checking; this one checks in its turn, behind:" && ls "$queue" |
      sort -t- -k1,1 -k2,2n | sed "/^${ticket##*/}\$/,\$d" | while read -r waiting; do cat "$queue/$waiting"; done; }
    told=1
    sleep 5
  done
}

mkdir -p "$home"
command=$*
case ${1:-} in
  build | shoot | tap | fold | verify)
    start=$SECONDS
    [ "$1" != verify ] || {
      verify "${2:-}"
      echo "took $((SECONDS - start))s"
      exit
    }
    take_lane "" 2
    prepare "${2:-}"
    out=$shots/$commit
    [ "$DEVICE" = duo ] || out=$out/$DEVICE
    [ "$HEX" = live ] || out=$out/$HEX
    [ -z "${ANSWERS:-}" ] || out=$out/$(basename "$ANSWERS" .json)
    case $1 in
      shoot) shoot "${3:-}" ;;
      tap) tap "${3:-}" ;;
      fold) fold "${3:-}" ;;
    esac
    echo "took $((SECONDS - start))s"
    ;;
  phone) phone "${2:-}" ;;
  *) die "usage: scripts/duo build [ref] | shoot [ref] [states] | tap [ref] [taps] | fold [ref] [states] | verify [ref] | phone [update]" ;;
esac
