{
  "expo": {
    "name": "hex",
    "slug": "hex-voice",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "hexvoice",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.shahidy.hexvoice",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "hex listens through your microphone while you talk with it.",
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.shahidy.hexvoice",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "BLUETOOTH"
      ],
      "blockedPermissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "hex listens through your microphone while you talk with it.",
          "cameraPermission": false
        }
      ],
      "expo-dev-client",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-call-audio",
      "./plugins/with-activity-orbs",
      "./plugins/without-push",
      "expo-widgets",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
