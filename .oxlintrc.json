{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/immutability": "off",
    "react-hooks/exhaustive-deps": "off",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-misused-promises": "error",
    "import/no-cycle": "error",
    "typescript/no-floating-promises": "error",
    "typescript/unbound-method": "error",
    "typescript/await-thenable": "off",
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_"
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Only src/hex talks to hex: add the request to src/hex/api.ts and call it through `hex`."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "expo/fetch",
            "message": "Only src/hex talks to hex: add the request to src/hex/api.ts and call it through `hex`."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/no-floating-promises": "off",
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["src/hex/**"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/app/**", "src/call/**", "src/components/**", "src/screens/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "expo/fetch",
                "message": "Only src/hex talks to hex: add the request to src/hex/api.ts and call it through `hex`."
              },
              {
                "name": "@/hex",
                "message": "Components never call hex: read through a hook in src/hooks and write through its actions, like answerAsk or raiseTask."
              }
            ],
            "patterns": [
              {
                "group": ["@/hex/*"],
                "message": "Components never call hex: read through a hook in src/hooks and write through its actions, like answerAsk or raiseTask."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/call/use-call.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "expo/fetch",
                "message": "Only src/hex talks to hex: add the request to src/hex/api.ts and call it through `hex`."
              }
            ]
          }
        ]
      }
    }
  ]
}
